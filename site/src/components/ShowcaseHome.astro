---
// One home from a partner showcase (prompt 28 §2): a gallery, the published price, the municipality's INE context next
// to it, the cost calculator prefilled with this price and "Arrange a private viewing". The viewing request itself is
// the page's slot: the site links to the enquiry (routing per config, task 8z, with the qualified summary); a private
// demo shows the request already filled in, then the buyer's team and the developer's view of the enquiry.
import type { Lang } from "../i18n";
import { type Project, type Unit, img } from "../lib/projects";
import { PRICES, LAST } from "../lib/prices";
import { purchase } from "../lib/sims";
import { c } from "../lib/copy";

interface Props { lang: Lang; project: Project; unit: Unit; back: string; sim: string; label: string; locale: string; cur?: { code: string; rate: number }; }
const { lang, project: p, unit: u, back, sim, label, locale, cur } = Astro.props;
const s = PRICES.munis[p.muni] as any;
const money = (v: number, k = "EUR") => new Intl.NumberFormat(locale, { style: "currency", currency: k, maximumFractionDigits: 0 }).format(v);
const nf1 = new Intl.NumberFormat(locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 }), nf = new Intl.NumberFormat(locale, { maximumFractionDigits: 1 });
const typ = u.typology === "Plot" ? c("show.plot", lang) : u.typology;
const pics = [...new Set([u.img, p.render, ...(p.gallery ?? [])].filter(Boolean) as string[])].slice(0, 6);
const cost = u.price ? purchase(u.price, false, false, false) : null;
const q = PRICES.quarters[LAST], ql = `${q.slice(0, 4)} ${lang === "en" ? "Q" : "T"}${q.slice(-1)}`;
---
<article class="sh">
  <div class="sh-gal" aria-label={c("show.gallery", lang)} tabindex="0">
    {pics.map((x, i) => <img src={img(x)} srcset={`${img(x, 800)} 800w, ${img(x)} 1600w`} sizes="(min-width: 900px) 70vw, 100vw" alt="" width="1600" height="1000" loading={i ? "lazy" : "eager"} />)}
  </div>
  <div class="sh-body">
    <div class="sh-main">
      <p class="sh-kicker"><a href={back}>← {c("show.back", lang)}</a> · {p.name} · <span class="sh-tag">{label}</span></p>
      <h1>{typ}{u.area != null && <span> · {u.typology === "Plot" ? c("show.plotarea", lang, { v: nf.format(u.area) }) : `${nf.format(u.area)} m²`}</span>}</h1>
      {u.name && <p class="sh-name">{u.name}</p>}
      <p class="sh-price">{u.price ? (u.priceNote === "from" ? c("show.from", lang, { v: money(u.price) }) : money(u.price)) : c("show.onrequest", lang)}
        {cur && u.price && <span>{money(Math.round(u.price * cur.rate / 1000) * 1000, cur.code)}</span>}</p>
      {u.areaNote && <p class="sh-small">{u.areaNote.split(";")[0]}.</p>}
      <p>{p.lines?.[lang] ?? p.line}</p>

      {cost && <section class="sh-cost" aria-labelledby="sh-cost">
        <h2 id="sh-cost">{c("show.cost.h", lang)}</h2>
        <p class="sh-small">{c("show.cost.p", lang)}</p>
        <dl>
          <div><dt>{c("show.cost.price", lang)}</dt><dd>{money(u.price!)}</dd></div>
          <div><dt>{c("show.cost.imt", lang)}</dt><dd>{money(cost.imt)}</dd></div>
          <div><dt>{c("show.cost.is", lang)}</dt><dd>{money(cost.is)}</dd></div>
          <div><dt>{c("show.cost.deed", lang)}</dt><dd>{money(cost.deed)}</dd></div>
          <div class="tot"><dt>{c("show.cost.total", lang)}</dt><dd data-total={cost.total}>{money(cost.total)}{cur && <span>{money(Math.round(cost.total * cur.rate / 1000) * 1000, cur.code)}</span>}</dd></div>
        </dl>
        <p><a class="sh-link" href={`${sim}?price=${u.price}&own=0&resident=0&mortgage=0`}>{c("show.cost.open", lang)} →</a></p>
      </section>}

      <section class="sh-view" id="viewing" aria-labelledby="sh-view">
        <h2 id="sh-view">{c("show.viewing", lang)}</h2>
        <slot name="viewing" />
      </section>
    </div>

    <aside class="sh-ctx">
      <h2>{c("show.ctx", lang, { muni: s.n })}</h2>
      <dl>
        {s.m2[LAST] && <div><dt>{c("show.ctx.m2", lang)}</dt><dd>{money(s.m2[LAST])}</dd></div>}
        {s.g10 != null && <div><dt>{c("show.ctx.g10", lang)}</dt><dd>{s.g10 > 0 ? "+" : ""}{nf1.format(s.g10)}%</dd></div>}
        {s.rq?.[LAST] && <div><dt>{c("show.ctx.rent", lang)}</dt><dd>{new Intl.NumberFormat(locale, { style: "currency", currency: "EUR", minimumFractionDigits: 2 }).format(s.rq[LAST])}</dd></div>}
        {s.yield != null && <div><dt>{c("show.ctx.yield", lang)}</dt><dd>{nf1.format(s.yield)}%</dd></div>}
      </dl>
      <p class="sh-small">{c("show.ctx.src", lang, { q: ql })}</p>
      <p class="sh-small">{c("show.credit", lang, { credit: (p.credits ?? [p.credit]).join("; ") })} {p.checked && c("show.published", lang, { date: p.checked })} <a href={u.url} rel="noopener">{c("show.sources", lang)}</a></p>
    </aside>
  </div>
</article>

<style>
  .sh-gal { display: grid; grid-auto-flow: column; grid-auto-columns: min(88vw, 1100px); gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .sh-gal::-webkit-scrollbar { display: none; }
  .sh-gal img { width: 100%; height: clamp(300px, 64vh, 720px); object-fit: cover; scroll-snap-align: start; display: block; }
  .sh-body { max-width: 1120px; margin: 0 auto; padding: 40px 24px 64px; display: grid; grid-template-columns: 1.5fr 1fr; gap: 56px; }
  .sh-kicker { font: 500 12px/1.4 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin: 0 0 16px; } .sh-kicker a { color: inherit; }
  .sh-tag { border: 1px solid currentColor; padding: 3px 6px; border-radius: 3px; }
  .sh h1 { font: 400 clamp(2.4rem, 1.8rem + 3vw, 4rem)/1.05 var(--serif); margin: 0 0 6px; } .sh h1 span { color: var(--muted); }
  .sh-name { margin: 0 0 6px; color: var(--muted); }
  .sh-price { font: 400 2.2rem/1.1 var(--serif); margin: 18px 0 4px; } .sh-price span, .sh-cost dd span { display: block; font: 400 15px/1.4 var(--sans); color: var(--muted); }
  .sh h2 { font: 400 1.6rem/1.2 var(--serif); margin: 0 0 8px; }
  .sh-cost, .sh-view { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--ink); }
  .sh-cost dl { margin: 12px 0; } .sh-cost dl div { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--rule); }
  .sh-cost dt { color: var(--muted); } .sh-cost dd { margin: 0; text-align: right; } .sh-cost .tot dt, .sh-cost .tot dd { color: var(--ink); font: 500 1.15rem/1.3 var(--sans); }
  .sh-link { font-weight: 500; }
  .sh-ctx { align-self: start; position: sticky; top: 24px; padding: 24px; border: 1px solid var(--rule); }
  .sh-ctx dl { margin: 12px 0; } .sh-ctx dl div { padding: 10px 0; border-bottom: 1px solid var(--rule); } .sh-ctx dt { font-size: 14px; color: var(--muted); } .sh-ctx dd { margin: 2px 0 0; font: 400 1.6rem/1.15 var(--serif); }
  .sh-small { font-size: 13px; color: var(--muted); } .sh-small a { color: inherit; }
  @media (max-width: 900px) { .sh-body { grid-template-columns: 1fr; } .sh-ctx { position: static; } }
</style>
