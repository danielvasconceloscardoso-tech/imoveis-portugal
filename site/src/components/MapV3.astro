---
// Map v3 (prompt 36, D62), rebuilt in three depths (D83 part 2, 3 Nov 2026: "the numbers are the cherry, not the cake").
// 1. First glance: our own quiet basemap (sea depth, relief from AWS Terrain Tiles, coastline, rivers, Playfair and Manrope
//    labels), the region postcards (our own photographs), the partner developments as small photo pins, a search box.
//    No numbers, no price colours, no legend.
// 2. A tap opens the place as a card of tiles, Apple Weather style (operator, step 1, 3 Nov 2026, the golden sample, Gondomar:
//    price in words, living here in minutes by car, schools and health by name with minutes, "Fontes", two calls to action).
// 3. The paid analysis (ten years and their chart, rents and yield, distributions, neighbours, doctors, full lists) is behind
//    "Ver a análise completa": the unlock sheet with a soft preview, "Disponível em breve" while payment is off.
// Everything else the map did before is one tap away under "Camadas": the market price colours with their legend,
// the quarterly time slider, the budget gesture, golf, beaches and developments, 2D / 3D and the guided tours.
// Everything self-hosted (site/public/tiles, site/public/data/map; scripts/map-data/v3_assets.py, v3_extras.py, tiles.py).
// The embed keeps MapExplorer.astro. Wording: COPY_DECK.md "card5.*", "map4.*", "map3.*" and "map.*".
import { HTML_LANG, pathFor, type Lang, type EdCode } from "../i18n";
import { EDITION_CUR, RATE } from "../lib/content";
import { MAP_MUNIS, REGIONS } from "../lib/mapdata";
import { PRICES } from "../lib/prices";
import { PLACES } from "../lib/places";
import { c, cl } from "../lib/copy";
import { PROJECTS } from "../lib/projects";
import { config } from "../config";
import { COMPARE_SUB } from "../lib/maptiles";
import PLACE_PHOTOS from "../data/place-photos.json";
import { existsSync } from "node:fs";
import { join } from "node:path";
import "../styles/mapv3.css";
import MareBlock from "./MareBlock.astro";

interface Props { lang: Lang; ed: EdCode; mode?: "page" | "home"; }
const { lang, ed, mode = "page" } = Astro.props;
const cur = EDITION_CUR[ed];
const fx = cur && cur !== "EUR" ? RATE(cur) : null;
const nf = new Intl.NumberFormat(HTML_LANG[lang]);
const lastQ = PRICES.quarters[PRICES.quarters.length - 1];
const qfmt = c("map.qfmt", lang);
const qLabel = qfmt.replace("{q}", lastQ.slice(-1)).replace("{y}", lastQ.slice(0, 4));
const pages = new Set(PLACES.map((p) => p.slug));
// Photographs only where they show the place named (prompt 34 §4.5): one hero per municipality without a place card, from
// src/data/place-photos.json (photos pass, 3 Nov 2026; shared with MapComparePage.astro), with its alt text per language.
const photos: Record<string, string> = Object.fromEntries(Object.entries(PLACE_PHOTOS).filter(([k]) => k !== "_how").map(([k, v]: [string, any]) => [k, v.f]));
const photoAlt: Record<string, string> = Object.fromEntries(Object.entries(PLACE_PHOTOS).filter(([k]) => k !== "_how").map(([k, v]: [string, any]) => [k, v.alt?.[lang] ?? ""]));
// D83 part 2: one photograph per region for the postcards and the region card (content/media/SOURCES.md; CC BY ones credited on
// /credits/). They appear on the region postcards and the region's card only; a municipality without its own photograph shows
// a quiet band (operator, 3 Nov 2026: never a view of another place).
// Step 2 (3 Nov 2026): the Centre (the Ria de Aveiro at sunset, Murtosa) and the Azores (Sete Cidades from the Vista do Rei)
// now have theirs too, to the photography standard (content/media/SOURCES.md, "Norte roll-out").
const regionPhotos: Record<string, string> = { north: "porto-douro-entardecer", centre: "centro-ria-de-aveiro-por-do-sol", lisbon: "lisboa-castelo-por-do-sol", alentejo: "comporta-mar-turquesa",
  algarve: "algarve-praia-da-marinha", madeira: "madeira-levada", azores: "acores-sete-cidades-vista-do-rei" };
const k = (x: string, v: Record<string, string> = {}) => c(`map3.${x}`, lang, v);
const k4 = (x: string, v: Record<string, string> = {}) => c(`map4.${x}`, lang, v);
const k5 = (x: string, v: Record<string, string> = {}) => c(`card5.${x}`, lang, v);
const keep = (x: string, names: string[]) => c(x, lang, Object.fromEntries(names.map((n) => [n, `{${n}}`])));
const A = config.mapAnalysis;
const labels = {
  sentence: k("sentence", { b: "{b}", a: "{a}", pa: "{pa}", c: "{c}", pc: "{pc}" }), sentenceOne: k("sentence.one", { b: "{b}", a: "{a}", pa: "{pa}" }),
  medians: k("medians", { q: qLabel }), reach: k("reach"), budgetTap: k("budget.tap"),
  // Operator, step 1: only the market price is a free colour layer (ten years, rents, yields, vacant homes: paid analysis).
  legend: { price: k("legend.price", { q: "{q}" }) },
  g: { munis: k("g.munis"), pars: k("g.pars"), golf: k("g.golf"), beach: k("g.beach"), devs: k("g.devs") },
  card: { price: k("card.price"), homes: k("card.homes"), concierge: k("card.concierge"), m2b: k("card.m2b"), pickb: k("card.pickb", { a: "{a}" }) },
  play: k("play"), pause: k("pause"), takeover: k("tour.takeover"), golfcap: k("tour.golfcap", { n: "{n}" }), timecap: k("tour.timecap", { q: "{q}" }), close: k("close"),
  tours: { coast: k("tour.coast"), golf: k("tour.golf"), madeira: k("tour.madeira"), time: k("tour.time") },
  qfmt, median: c("map.card.median", lang, { v: "{v}", quarter: "{quarter}" }), nodata: c("map.card.nodata", lang), parishOf: c("map.par.of", lang, { m: "{m}" }),
  source: c("map.card.source", lang, { quarter: "{quarter}" }), disclaimer: c("map.card.disclaimer", lang), share: c("map.share", lang), copied: c("map.copied", lang),
  page: c("map.a.page", lang), sponsored: c("dev.sponsored", lang),
  pfrom: c("map.proj.from", lang, { v: "{v}" }), ponreq: c("map.proj.onreq", lang), golfUnnamed: c("map.golf.unnamed", lang), nomatch: c("map.find.none", lang),
  golf: Object.fromEntries(["holes", "design", "opened", "status", "opening", "homes", "site", "src"].map((x) => [x, c(`golf.${x}`, lang, x === "opening" ? { y: "{y}" } : {})])),
  regions: Object.fromEntries(REGIONS.map((r) => [r, c(`map.r.${r}`, lang)])), credits: k("credits"),
  // D83 part 2: the tiles, the charts, the unlock sheet and the comparison.
  t: {
    regionKick: k4("region.kick"), regionLine: keep("map4.region.line", ["n", "cities"]), regionPick: k4("region.pick"), cutParish: keep("map4.cut.parish", ["m"]),
    price: k4("tile.price"), mkt: k4("tile.mkt"), nb: k4("tile.nb"), nbsrc: k4("tile.nbsrc"), onreq: k4("tile.onreq"),
    dirUp: keep("map4.tile.dir.up", ["v"]), dirDown: keep("map4.tile.dir.down", ["v"]), dirFlat: k4("tile.dir.flat"),
    life: k4("tile.life"), sun: k4("tile.sun"), sunV: keep("map4.tile.sun.v", ["v"]), sea: k4("tile.sea"), beach: k4("tile.beach"), min: keep("map4.tile.min", ["v"]),
    kmline: keep("map4.tile.kmline", ["v"]), airport: k4("tile.airport"), ap: keep("map4.tile.ap", ["n", "v"]),
    noschool: k4("tile.noschool"), care: k4("tile.care"), school: k4("tile.school"), hosp: k4("tile.hosp"), km: keep("map4.tile.km", ["n", "v"]),
    soon: k4("tile.soon"), soonP: k4("tile.soon.p"), paid: k4("tile.paid"), back: k4("back"),
    ph: Object.fromEntries(Object.values(regionPhotos).map((f) => [f, c(`map4.ph.${f}`, lang)])),
    pill: keep("map4.compare.pill", ["n"]), layerNone: k4("layer.none"),
  },
  // Operator, step 1: the golden sample card (COPY_DECK.md "card5").
  c5: {
    mkt: k5("mkt"), m2: keep("card5.m2", ["v"]), nb: k5("nb"), nbOnreq: k5("nb.onreq"), life: k5("life"), bycar: k5("bycar"), min: keep("card5.min", ["v"]),
    flight: k5("flight", { c: c(`map4.cty.${ed}`, lang) }), via: k5("flight.via"), soon: k5("flight.soon"), schools: k5("schools"), health: k5("health"), within: k5("within"),
    sources: k5("sources"), ctaPaid: k5("cta.paid"), ctaConsult: k5("cta.consult"), homes: keep("card5.homes", ["muni", "name"]), photoN: keep("card5.photo.n", ["i", "n"]),
    srcH: k5("src.h"), tagCs: k5("tag.cs"), preview: keep("card5.preview", ["place"]), paid: cl("card5.paid", lang),
    src: { mkt: keep("card5.src.mkt", ["q"]), dir: keep("card5.src.dir", ["q0", "q"]), nb: k5("src.nb"), drive: keep("card5.src.drive", ["o", "d"]),
      flight: keep("card5.src.flight", ["from", "to", "d"]), sch: keep("card5.src.sch", ["d"]), hsp: keep("card5.src.hsp", ["d"]), ph: k5("src.ph"), km: k5("src.km") },
  },
};
const mapPath = pathFor(lang, ed, "map");
const comparePath = `${mapPath}${COMPARE_SUB[lang]}/`;
const links = { buy: pathFor(lang, ed, "buy"), consult: pathFor(lang, ed, "consult"), map: mapPath, compare: comparePath, pages: [...pages], credits: "/credits/" };
const pinFile = (id: string) => existsSync(join(process.cwd(), "public", "img", "map", `pin-${id}.webp`)) ? `/img/map/pin-${id}.webp` : "";
// The area briefs carry rents, yields and ten-year changes (paid analysis): never in the free card (operator, step 1).
const cfg = { labels, links, photos, photoAlt, regionPhotos, ed, lang,
  projects: PROJECTS.map((p) => ({ id: p.id, name: p.name, tag: p.tag?.[lang] ?? "", developer: p.developer, muni: p.muni, lon: p.lon, lat: p.lat, render: p.render, pin: pinFile(p.id) || (p.render ? `${p.render}-800.webp` : ""), from: p.from, showcase: `${pathFor(lang, ed, "partners")}${p.devSlug}/${p.muni}/`,
    // Prompt 38: the project card (summary, three features, homes for sale now from the developer's table).
    summary: p.summary?.[lang], feats: (p.features ?? []).filter((f) => f.card).map((f) => f[lang]),
    now: p.blocks ? p.blocks.reduce((a, b) => a + b.units.reduce((x, u) => x + u.forSale, 0), 0) : null,
    // Part 2 (3 Nov): the places a project is near (projects.json), so a card with no homes of its own points to them.
    near: p.near ?? [], muniName: MAP_MUNIS.find((m) => m.s === p.muni)?.n ?? "" })),
  pl: { view: c("showb.view", lang), visit: c("showb.visit", lang), price: c("showb.price", lang), now: c("showb.now", lang, { n: "{n}" }), near: c("bar.near", lang, { name: "{name}", muni: "{muni}" }) } };
// Operator, step 1: the market price is the one free colour layer; 10 years, rents, yields and vacant homes are paid.
const chips = [["price", "chip.price"]] as const;
const overlays = [["golf", "chip.golf"], ["beach", "chip.beach"], ["devs", "chip.devs"]] as const;
const amount = Math.round(300000 * (fx ? fx.rate : 1));
const regionList = ["north", "centre", "lisbon", "alentejo", "algarve", "madeira", "azores"] as const;
const unlockList = cl("map4.unlock.list", lang);
const live = A.live && !!A.stripe.region && !!A.stripe.all;
---
<div class={`m3 m3-${mode}`} data-m3 data-mode={mode} data-locale={HTML_LANG[lang]} data-fx={fx ? fx.rate : ""} data-cur={fx ? cur : ""} data-quarter={lastQ}>
  <div class="m3-stage">
    <picture>
      <source media="(max-width: 819px)" srcset="/img/map3-poster-m.webp" width="640" height="1274" />
      <img class="m3-poster" src="/img/map3-poster-1200.webp" srcset="/img/map3-poster-1200.webp 1200w, /img/map3-poster-1800.webp 1800w" sizes="100vw" width="1200" height="693" alt={c("map.title", lang)} loading={mode === "home" ? "lazy" : "eager"} fetchpriority={mode === "page" ? "high" : undefined} />
    </picture>
    <div class="m3-canvas" data-canvas></div>
    <div class="m3-labels" data-labels aria-hidden="true"></div>
    <span class="m3-tip" data-tip hidden></span>

    <div class="m3-top">
      <button type="button" class="m3-searchbtn" data-spot-open aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg>
        <span>{k4("search")}</span><kbd>⌘K</kbd>
      </button>
      {mode === "page" && <a class="m3-cmp-pill" data-cmp-pill href={comparePath} hidden></a>}
      {mode === "page" && (
        <button type="button" class="m3-layersbtn" data-panel-open aria-expanded="false" aria-controls="m3-panel">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 3 8l9 5 9-5-9-5z"/><path d="m3 13 9 5 9-5"/></svg>
          <span>{k4("layers")}</span>
        </button>
      )}
    </div>

    {mode === "page" && (
      <nav class="m3-cards" data-postcards aria-label={k4("regions")}>
        {regionList.map((r) => (
          <button type="button" class="m3-pc" data-region={r}>
            {regionPhotos[r] ? <img src={`/img/map/pc-${regionPhotos[r]}.webp`} alt="" width="144" height="96" loading="lazy" decoding="async" /> : <span class="m3-pc-none" aria-hidden="true"></span>}
            <span class="m3-pc-n">{c(`map.r.${r}`, lang)}</span>
          </button>
        ))}
      </nav>
    )}

    <!-- "Camadas": everything the first view leaves out (D83 part 2), one quiet tap away. -->
    <div class="m3-dock" id="m3-panel" data-panel hidden={mode === "page" ? true : undefined}>
      {mode === "page" && (
        <div class="m3-panel-head">
          <p class="m3-k">{k4("layers.h")}</p>
          <button type="button" class="m3-panel-x" data-panel-close aria-label={k4("layers.close")}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
        </div>
      )}
      {mode === "page" && (
        <div class="m3-pg">
          <p class="m3-pk">{k4("layer.colour")}</p>
          <div class="m3-chips" role="group" aria-label={k("layers")}>
            <button type="button" class="m3-chip" data-layer="none" aria-pressed="true">{k4("layer.none")}</button>
            {chips.map(([id, key]) => <button type="button" class="m3-chip" data-layer={id} aria-pressed="false">{k(key)}</button>)}
          </div>
          <p class="m3-pk">{k4("layer.on")}</p>
          <div class="m3-chips" role="group" aria-label={k4("layer.on")}>
            {overlays.map(([id, key]) => <button type="button" class="m3-chip m3-chip-o" data-overlay={id} aria-pressed={id === "devs" && PROJECTS.length ? "true" : "false"}>{k(key)}</button>)}
          </div>
          <p class="m3-pk">{k4("layer.view")}</p>
          <div class="m3-seg m3-dim" role="group" aria-label="2D / 3D">
            <button type="button" data-dim="2d" aria-pressed="false">2D</button>
            <button type="button" data-dim="3d" aria-pressed="true">3D</button>
          </div>
        </div>
      )}
      {mode === "page" && (
        <div class="m3-pg">
          <p class="m3-pk">{k4("layer.time")}</p>
          <div class="m3-time is-off" data-time>
            <button type="button" class="m3-play" data-play aria-label={k("play")}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></button>
            <div class="m3-scrub" data-scrub role="slider" tabindex="0" aria-label={k("time")}><span class="m3-track"><span class="m3-fill" data-sfill></span></span><span class="m3-thumb" data-sthumb></span></div>
            <span class="m3-year" data-year>{lastQ.slice(0, 4)}</span>
          </div>
        </div>
      )}
      <div class="m3-budget m3-pg" hidden={mode === "home" ? true : undefined}>
        <div class="m3-budget-head">
          <span class="m3-k">{k("budget.label")}</span>
          <button type="button" class="m3-amount" data-amount title={k("budget.tap")}>{nf.format(amount)} {fx ? cur : "€"}</button>
          <input class="m3-amount-in" data-amount-in type="text" inputmode="numeric" hidden aria-label={k("budget.label")} />
        </div>
        <div class="m3-slider" data-slider role="slider" tabindex="0" aria-label={k("budget.label")} aria-valuemin="100000" aria-valuemax="20000000" aria-valuenow="300000">
          <span class="m3-track"><span class="m3-fill" data-fill></span></span><span class="m3-thumb" data-thumb></span>
        </div>
        <p class="m3-sentence" data-sentence aria-live="polite"></p>
      </div>
      {mode === "page" && (
        <div class="m3-pg">
          <p class="m3-pk">{k4("layer.tours")}</p>
          <div class="m3-tours" role="group" aria-label={k("tours")}>
            {(["coast", "golf", "madeira", "time"] as const).map((t) => <button type="button" class="m3-tour" data-tour={t}>{k(`tour.${t}`)}</button>)}
            {PROJECTS.slice(0, 1).map((p) => <button type="button" class="m3-tour" data-tour={`project:${p.id}`}>{p.name}, {MAP_MUNIS.find((m) => m.s === p.muni)?.n ?? ""}</button>)}
          </div>
        </div>
      )}
      {mode === "home" && <a class="m3-open" href={links.map}>{c("home2.map.a", lang)}</a>}
    </div>
    <div class="m3-legend" data-legend hidden><span data-lo></span><span class="m3-ramp"></span><span data-hi></span><span class="m3-legend-t" data-legend-t></span></div>

    <aside class="m3-sheet" data-sheet hidden aria-live="polite">
      <button type="button" class="m3-grab" data-grab aria-hidden="true" tabindex="-1"><span></span></button>
      <div class="m3-sheet-in" data-sheet-in></div>
    </aside>
    <p class="m3-caption" data-caption hidden aria-live="polite"></p>
    <p class="m3-toast" data-toast role="status" hidden></p>
    <p class="m3-attr small">{k("credits")}</p>

    <!-- The unlock sheet: the paid analysis, switched off until the company and invoicing are ready (config.mapAnalysis). -->
    <div class="m3-unlock" data-unlock hidden role="dialog" aria-modal="true" aria-labelledby={`m3-ul-${mode}`}>
      <div class="m3-unlock-box">
        <button type="button" class="m3-x" data-unlock-x aria-label={k("close")}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
        <p class="m3-kick" data-unlock-kick>{k4("tile.paid")}</p>
        <h3 id={`m3-ul-${mode}`}>{k4("unlock.offer", { r: String(A.prices.region), a: String(A.prices.all), m: String(A.months) })}</h3>
        <p class="m3-unlock-p" data-unlock-p data-tpl={keep("map4.unlock.p", ["place"])}></p>
        <div class="m3-unlock-pv" data-unlock-pv></div>
        <ul class="m3-unlock-list">{unlockList.map((x) => <li>{x}</li>)}</ul>
        {live ? (
          <div class="m3-acts">
            <a class="m3-btn m3-btn-p" data-unlock-region href={A.stripe.region} data-tpl={keep("map4.unlock.buy.region", ["region", "v"])} data-v={A.prices.region} rel="noopener">{k4("unlock.buy.region", { region: "", v: String(A.prices.region) })}</a>
            <a class="m3-btn" href={A.stripe.all} rel="noopener">{k4("unlock.buy.all", { v: String(A.prices.all) })}</a>
          </div>
        ) : (
          <button type="button" class="m3-btn m3-btn-p m3-btn-off" disabled aria-disabled="true">{k4("unlock.soon")}</button>
        )}
        <p class="m3-src">{k4("unlock.note")}</p>
      </div>
    </div>
  </div>

  <div class="m3-spot" data-spot hidden role="dialog" aria-modal="true" aria-label={k4("search")}>
    <div class="m3-spot-box">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg>
      <input type="search" data-spot-in role="combobox" aria-expanded="true" aria-controls={`m3-res-${mode}`} aria-autocomplete="list" autocomplete="off" placeholder={k4("search.hint")} aria-label={k4("search")} />
      <ul id={`m3-res-${mode}`} role="listbox" data-spot-res></ul>
    </div>
  </div>

  <!-- MareBlock slot (D83 part 2): the lead puts <MareBlock /> (site/src/components/MareBlock.astro, the Maré newsletter
       block) inside this template; map-v3.ts copies it to the end of every place card and region postcard card. -->
  <template data-mare-tpl>{mode === "page" && <MareBlock lang={lang} ed={ed} where="postcard" />}</template>

  <noscript><style is:inline>.m3-top, .m3-dock, .m3-cards { display: none !important; }</style><p class="m3-noscript">{k("noscript")}</p></noscript>
  <script type="application/json" data-m3-cfg set:html={JSON.stringify(cfg)} />
</div>

<script>
  // Fetched once the page is idle, so the map never competes with the first paint. A ?place= link (operator, step 1: the
  // card in under a second) starts the place's small file at once and runs the map script without waiting for idle time.
  const run = () => import("../scripts/map-v3").then(({ initMapV3 }) => document.querySelectorAll<HTMLElement>("[data-m3]").forEach((el) => initMapV3(el)));
  const place = new URLSearchParams(location.search).get("place");
  const slug = place && place.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
  if (slug && document.querySelector("[data-m3][data-mode=page]")) {
    (window as any).__m3place = { slug, p: fetch(`/data/map/place/${slug}.json`).then((r) => (r.ok ? r.json() : null)).catch(() => null) };
    run();
  } else "requestIdleCallback" in window ? requestIdleCallback(run, { timeout: 1200 }) : setTimeout(run, 300);
</script>
