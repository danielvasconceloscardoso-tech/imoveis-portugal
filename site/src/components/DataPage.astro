---
// Prices and rents (prompts 13 and 20 §3), a preview of the paid analysis since the operator's fix round of 3 Nov 2026
// (step 3): the title, the finding in one sentence, the shape of the chart without figures and "Ver a análise completa",
// which opens the map's unlock sheet (components/AnalysisPreview.astro). The ten years of INE prices per municipality, the
// rents and the gross yields this page used to show free are in the analysis (MapAnalysisPage.astro, AnalysisExtra.astro);
// the market median of each municipality stays free on the map. Describe, never advise (D12): the past-prices line and the
// method stay under the shape. URL unchanged. Data: src/data/prices.json (build time only) (facts ine-m2-history, ine-rent-2026q2).
// Wording: COPY_DECK.md "prices.*" and "fix35.prev.*".
import V2 from "../layouts/V2.astro";
import AnalysisPreview from "./AnalysisPreview.astro";
import { pathFor, type Lang, type EdCode } from "../i18n";
import { Sources, fmtDate } from "../lib/content";
import { PRICES, LAST } from "../lib/prices";
import { c, edName } from "../lib/copy";

interface Props { lang: Lang; ed: EdCode; }
const { lang, ed } = Astro.props;
const src = new Sources();
const cite: Record<string, () => number> = { sHist: () => src.n("ine-m2-history"), sRent: () => src.n("ine-rent-2026q2") };
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const finding = esc(c("fix35.prev.data.f", lang)).replace(/\{(s[A-Z]\w*)\}/g, (_, t) => `<a class="sup" href="#fonte-${cite[t]()}">${cite[t]()}</a>`);
// The shape: municipalities from the cheapest square metre to the dearest, in 24 equal groups; each bar is the group's
// median gross yield (no value shown). The three cheapest groups carry the accent: the finding names them.
const munis = Object.values(PRICES.munis).filter((m) => m.m2[LAST] && m.yield).sort((a, b) => a.m2[LAST]! - b.m2[LAST]!);
const G = 24, med = (xs: number[]) => { const s = [...xs].sort((a, b) => a - b), h = s.length >> 1; return s.length % 2 ? s[h] : (s[h - 1] + s[h]) / 2; };
const bars = Array.from({ length: G }, (_, g) => med(munis.slice(Math.floor((g * munis.length) / G), Math.floor(((g + 1) * munis.length) / G)).map((m) => m.yield!)));
const title = c("prices.title", lang);
---
<V2 lang={lang} ed={ed} page="data" title={`${title} | Imóveis Portugal · ${edName(ed, lang)}`} description={c("prices.lede", lang)} sticky={null}>
  <div class="frame read ph dp-prev">
    <AnalysisPreview lang={lang} ed={ed} id="prices-page" kick={title} title={c("prices.h1", lang)} finding={finding}
      shape={{ kind: "bars", values: bars, accent: [0, 1, 2] }} y={c("fix35.prev.data.y", lang)} lo={c("fix35.prev.data.lo", lang)} hi={c("fix35.prev.data.hi", lang)}
      contents={c("prices.lede", lang)} />
    <p class="small dp-past">{c("journey.past", lang)} {c("prices.method", lang)}</p>
    <p class="dp-map"><a class="more" href={pathFor(lang, ed, "map")}>{c("map.open", lang)}</a></p>
  </div>
  <section class="sources-list" aria-labelledby="fontes">
    <div class="frame read">
      <h2 id="fontes" class="h-small">{c("common.sources", lang)}</h2>
      <ol>{src.list.map((s, i) => <li id={`fonte-${i + 1}`}><a href={s.url} rel="noopener">{s.title}</a>{s.checked && `, ${c("common.checked", lang, { date: fmtDate(lang, s.checked) })}`}.</li>)}</ol>
    </div>
  </section>
</V2>

<style>
  .dp-prev { padding-bottom: 48px; }
  .dp-past { margin-top: 40px; }
  .dp-map { margin-top: 16px; }
</style>
