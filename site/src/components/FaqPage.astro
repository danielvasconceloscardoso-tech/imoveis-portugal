---
// Perguntas (prompts 09, 10 and 27 §2; prompt 43 §3b). One line per question, grouped by step; the answer opens in place
// (a native <details>, so keyboard and screen readers get it for free): two or three sentences with their sources,
// "Saiba mais" when an article goes deeper, and one quiet partner link that opens the Concierge with the topic
// (?topic=lawyer|advisor|bank|tax, scripts/chrome.ts and scripts/flow.ts). Search stays on top.
import V2 from "../layouts/V2.astro";
import { pathFor, type Lang, type EdCode } from "../i18n";
import { faqFor, FACTS, fmtDate, DISCLAIMER, Sources, type FaqItem } from "../lib/content";
import { faqPlace, FAQ_STAGES, type FaqStage } from "../lib/path";
import { ART_SUB } from "../lib/articles";
import { postById } from "../lib/blog";
import { c } from "../lib/copy";

interface Props { lang: Lang; ed: EdCode; }
const { lang, ed } = Astro.props;
const consult = pathFor(lang, ed, "consult");

// Sources as superscripts (prompt 11): one numbered list for the whole page, folded at the bottom.
const src = new Sources();
// D52: for a high budget (from the map, the path or a link) these questions move to the top of their stage; the rest
// stays as it is. Nothing is labelled and the threshold is never shown.
const HIGH_FIRST = ["ifici", "inherit", "visa", "yearly", "lawyer"];
// Prompt 27 §2: the questions the path adds for selling and inheritance join the list (answers from the path's sources).
const EXTRA: (FaqItem & { ask?: boolean })[] = [
  { id: "sell-filing", facts: ["pt-is-inheritance-filing"], cta: "tax", ask: false },
  { id: "sell-heirs", facts: [], cta: "lawyer", ask: true },
  { id: "sell-cert", facts: [], cta: "lawyer", ask: true },
].map((x, i) => ({ ...x, id: `${lang}-${x.id}`, rank: 100 + i, stage: "after", cta: x.cta as FaqItem["cta"],
  q: c(`journey.q.${x.id.replace("-", ".")}.q`, lang), a: c(`journey.q.${x.id.replace("-", ".")}.a`, lang) }));
const PLACE: Record<string, FaqStage> = { "sell-filing": "inheritance", "sell-heirs": "inheritance", "sell-cert": "selling" };
// Prompt 43 §3b: the partner who solves each topic (the FAQ's own `cta`), and "Saiba mais" where an article goes deeper.
const TOPIC: Record<string, "lawyer" | "advisor" | "bank" | "tax"> = { lawyer: "lawyer", bank: "bank", fx: "bank", tax: "tax", agency: "advisor", developer: "advisor" };
const blog = (id: string) => { const p = postById(id, lang); return p ? `${pathFor(lang, ed, "blog")}${p.slug}/` : null; };
const MORE: [string, () => string | null][] = [
  ["buy-abroad", () => blog("buy-from-abroad")], ["nif", () => blog("buy-from-abroad")], ["sign", () => blog("buy-from-abroad")],
  ["lawyer", () => blog("buy-from-abroad")], ["mortgage", () => blog("buy-from-abroad")], ["borrow", () => blog("buy-from-abroad")],
  ["cpcv", () => blog("buy-from-abroad")], ["money", () => blog("buy-from-abroad")], ["deed", () => blog("buy-from-abroad")],
  ["costs", () => blog("imt-nonresidents")], ["imt-nonres", () => blog("imt-nonresidents")], ["imt-calc", () => blog("imt-nonresidents")], ["hpp", () => blog("imt-nonresidents")],
  ["visa", () => pathFor(lang, ed, "private")], ["ifici", () => pathFor(lang, ed, "private")], ["inherit", () => pathFor(lang, ed, "private")], ["yearly", () => pathFor(lang, ed, "private")],
  ["timing", () => `${pathFor(lang, ed, "articles")}${ART_SUB.prices[lang]}/`],
];
const items = [...faqFor(ed, lang), ...EXTRA].map((it: FaqItem & { ask?: boolean }) => {
  const facts = (it.facts || []).map((id) => FACTS[id]);
  const checked = facts.map((f) => f.checked_on).sort().pop();
  const nums = [...new Set((it.facts || []).map((id) => src.n(id)))];
  const topic = TOPIC[it.cta] ?? "advisor";
  const partner = { href: `${consult}?topic=${topic}`, label: c(`path.p.${topic}`, lang), topic };
  const more = MORE.filter(([k]) => it.id.endsWith(`-${k}`)).sort((a, b) => b[0].length - a[0].length)[0]?.[1]() ?? null;
  const high = HIGH_FIRST.some((k) => it.id.endsWith(`-${k}`));
  const stage: FaqStage = PLACE[it.id.slice(lang.length + 1)] ?? faqPlace(it.id)?.stage ?? (it.stage === "after" ? "owning" : it.stage);
  return { ...it, stage, partner, more, nums, checked, high };
});
const stages = FAQ_STAGES.filter((s) => items.some((i) => i.stage === s));
const lastChecked = items.map((i) => i.checked).filter(Boolean).sort().pop();
// The visible answer is the structured answer, word for word.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((it) => ({ "@type": "Question", name: it.q, acceptedAnswer: { "@type": "Answer", text: it.a } })),
};
---
<V2 lang={lang} ed={ed} page="faq" title={`${c("faq.title", lang)} | Imóveis Portugal`} description={c("faq.lede", lang)}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="frame read help">
    <h1>{c("faq.title", lang)}</h1>
    <p class="lede">{c("faq.lede", lang)}</p>
    <div class="search" role="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" type="search" placeholder={c("faq.search", lang)} aria-label={c("faq.search", lang)} autocomplete="off" />
    </div>
  </div>
  <div class="frame read fq">
    <div class="fq-none" id="none" role="status">
      <p>{c("faq.none", lang)}</p>
      <p class="ptn"><span class="ptn-tag">{c("path.p.tag", lang)}</span> <a href={`${consult}?topic=advisor`} data-concierge>{c("path.p.advisor", lang)}<span aria-hidden="true"> →</span></a></p>
    </div>
    {stages.map((s) => (
      <section class="fq-stage" aria-labelledby={`${s}-h`}>
        <h2 id={`${s}-h`} class="h-small">{c(`faq.stage.${s}.h`, lang)}</h2>
        {items.filter((i) => i.stage === s).map((it) => (
          <details class="fq-qa" id={it.id} data-high-first={it.high ? "" : undefined}>
            <summary>{it.q}</summary>
            <div class="fq-a">
              <p>{it.a}{it.nums.map((n) => <a class="sup" href={`#fonte-${n}`}>{n}</a>)}</p>
              {it.ask && <p class="small">{c("journey.unverified", lang)}</p>}
              {it.more && <p class="fq-more"><a href={it.more}>{c("path.learn", lang)}<span class="vh">: {it.q}</span></a></p>}
              <p class="ptn"><span class="ptn-tag">{c("path.p.tag", lang)}</span> <a href={it.partner.href} data-concierge data-topic={it.partner.topic}>{it.partner.label}<span aria-hidden="true"> →</span></a></p>
            </div>
          </details>
        ))}
      </section>
    ))}
    <script is:inline>(function(){try{var b=Number(new URLSearchParams(location.search).get("budget"))||Number(localStorage.getItem("ip.budget"))||0;if(b<1e6)return;document.querySelectorAll("section.fq-stage").forEach(function(sec){[].slice.call(sec.querySelectorAll("details[data-high-first]")).reverse().forEach(function(d){sec.insertBefore(d,sec.querySelector("details.fq-qa"))})})}catch(e){}})();</script>
    <section class="sources-list fq-src" aria-labelledby="fontes">
      <details class="srcs" data-srcs>
        <summary id="fontes" class="h-small">{c("common.sources", lang)} ({src.list.length})</summary>
        {lastChecked && <p class="small">{c("faq.updated", lang, { date: fmtDate(lang, lastChecked) })}</p>}
        <ol>
          {src.list.map((f, i) => <li id={`fonte-${i + 1}`}><a href={f.url} rel="noopener">{f.title}</a>{f.checked && `, ${c("common.checked", lang, { date: fmtDate(lang, f.checked) })}`}.</li>)}
        </ol>
      </details>
    </section>
    <p class="disc">{DISCLAIMER[lang]}</p>
  </div>
  <script is:inline>
    (function () {
      var q = document.getElementById("q"), none = document.getElementById("none"), srcs = document.querySelector("[data-srcs]");
      var norm = function (s) { return s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase(); };
      var items = [].slice.call(document.querySelectorAll(".fq-qa")).map(function (d) { return { d: d, t: norm(d.textContent) }; });
      // Open the question or the source named in the address bar (links from other pages, superscripts).
      var fromHash = function () {
        var t = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (!t) return;
        if (t.tagName === "DETAILS") { t.open = true; t.scrollIntoView({ block: "start" }); }
        else if (srcs && srcs.contains(t)) { srcs.open = true; t.scrollIntoView({ block: "center" }); }
      };
      fromHash(); addEventListener("hashchange", fromHash);
      document.addEventListener("click", function (e) { if (srcs && e.target.closest && e.target.closest("a.sup")) srcs.open = true; });
      q.addEventListener("input", function () {
        var words = norm(q.value).split(/\s+/).filter(Boolean), shown = 0;
        items.forEach(function (it) {
          var ok = words.every(function (w) { return it.t.indexOf(w) > -1; });
          it.d.hidden = !ok; if (ok) shown++;
          it.d.open = words.length > 0 && ok && shown <= 3;
        });
        document.querySelectorAll(".fq-stage").forEach(function (s) { s.hidden = !s.querySelector(".fq-qa:not([hidden])"); });
        none.classList.toggle("on", shown === 0);
      });
    })();
  </script>
</V2>

<style>
  .fq { padding-bottom: 64px; }
  .fq-stage { padding-top: 40px; }
  .fq-stage > h2 { margin: 0 0 8px; }
  /* One line per question; the answer opens in place under it. */
  .fq-qa { border-top: 1px solid var(--rule); }
  .fq-stage .fq-qa:last-child { border-bottom: 1px solid var(--rule); }
  .fq-qa > summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: baseline; gap: 16px; min-height: 56px; padding: 16px 0; font: 500 17px/1.4 var(--sans); color: var(--ink); }
  .fq-qa > summary::-webkit-details-marker { display: none; }
  .fq-qa > summary::after { content: "+"; font: 400 21px/1 var(--sans); color: var(--muted); flex: none; }
  .fq-qa[open] > summary::after { content: "−"; }
  .fq-qa > summary:hover { color: var(--accent); }
  .fq-qa > summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .fq-a { padding: 0 0 24px; }
  .fq-a > p { margin: 0 0 16px; max-width: 38em; }
  .fq-a > p:first-child { font-size: 17px; line-height: 1.6; }
  .fq-more a { font-weight: 500; }
  .fq-a > .ptn { margin: 0; }
  .ptn { font-size: 15px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; }
  .ptn-tag { font: 600 13px/1 var(--sans); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .ptn a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; text-decoration-color: var(--rule); }
  .ptn a:hover { text-decoration-color: currentColor; }
  .fq-none { display: none; padding: 24px 0; border-top: 1px solid var(--rule); }
  .fq-none.on { display: block; }
  .fq-none p { margin: 0 0 8px; }
  .fq-src { margin-top: 40px; padding-top: 16px; }
  .srcs summary { cursor: pointer; list-style: none; display: inline-flex; align-items: center; gap: 8px; min-height: 40px; }
  .srcs summary::-webkit-details-marker { display: none; }
  .srcs summary::after { content: "+"; font: 400 17px/1 var(--sans); color: var(--muted); }
  .srcs[open] summary::after { content: "−"; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
