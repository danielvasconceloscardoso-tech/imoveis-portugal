---
// FAQ page (prompt 06, Part A): content/faq + facts.csv, FAQPage structured data, disclaimer once at the bottom.
import C from "../layouts/C.astro";
import { faqFor, FACTS, strings, cta, fmtDate, type Variant } from "../lib/content";

interface Props { v: Variant; }
const { v } = Astro.props;
const S = strings(v);
const items = faqFor(v).map((it) => {
  const facts = (it.facts || []).map((id) => FACTS[id]);
  const checked = facts.map((f) => f.checked_on).sort().pop();
  // One link per source page; when several facts cite the same page, name the document, not one article.
  const byUrl = new Map<string, { url: string; title: string; n: number }>();
  for (const f of facts) {
    const seen = byUrl.get(f.source_url);
    if (seen) { seen.n++; seen.title = f.source_title.split(",")[0]; }
    else byUrl.set(f.source_url, { url: f.source_url, title: f.source_title, n: 1 });
  }
  const sources = [...byUrl.values()];
  return { ...it, next: cta(v, it.cta), sources, checked };
});
const lastChecked = items.map((i) => i.checked).filter(Boolean).sort().pop();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((it) => ({ "@type": "Question", name: it.q, acceptedAnswer: { "@type": "Answer", text: it.a } })),
};
---
<C v={v} page="faq" title={`${S.faq.title} | Imóveis Portugal`} description={S.faq.lede}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="w ph g">
    <h1>{S.faq.title}</h1>
    <p class="lede">{S.faq.lede}</p>
    {lastChecked && <p class="meta">{S.faq.checked} {fmtDate(v, lastChecked)}</p>}
  </div>
  <div class="w">
    {items.map((it) => (
      <section class="row g" id={it.id} aria-labelledby={`${it.id}-q`}>
        <h2 id={`${it.id}-q`}>{it.q}</h2>
        <div class="body">
          <p>{it.a}</p>
          <a class="next" href={it.next.href}>{it.next.label}</a>
          {it.sources.length > 0 && (
            <p class="src">{S.faq.sources}: {it.sources.map((f, i) => (<>{i > 0 && "; "}<a href={f.url} rel="noopener">{f.title}</a></>))}{it.checked && `. ${S.faq.checked} ${fmtDate(v, it.checked)}.`}</p>
          )}
        </div>
      </section>
    ))}
  </div>
  <div class="disc">
    <div class="w g"><p>{S.disclaimer}</p></div>
  </div>
</C>
