---
// FAQ as a help centre (prompts 09 and 10; Wise and Stripe help pages as the model): search first, questions
// grouped by stage and ordered by search interest, short answers with sources, one partner action each.
// No sponsor yet in a category: the button says "Talk to a partner" and opens the enquiry form.
import V2 from "../layouts/V2.astro";
import { config } from "../config";
import { pathFor, type Lang, type EdCode } from "../i18n";
import { faqFor, FACTS, fmtDate, DISCLAIMER, type Stage } from "../lib/content";
import { c } from "../lib/copy";

interface Props { lang: Lang; ed: EdCode; }
const { lang, ed } = Astro.props;
const talk = pathFor(lang, ed, "talk");

const items = faqFor(ed, lang).map((it) => {
  const facts = (it.facts || []).map((id) => FACTS[id]);
  const checked = facts.map((f) => f.checked_on).sort().pop();
  // One link per source page; when several facts cite the same page, name the document, not one article.
  const byUrl = new Map<string, { url: string; title: string }>();
  for (const f of facts) {
    const seen = byUrl.get(f.source_url);
    if (seen) seen.title = f.source_title.split(",")[0];
    else byUrl.set(f.source_url, { url: f.source_url, title: f.source_title });
  }
  let next: { href: string; label: string; who: string };
  if (it.cta === "agency") next = { href: pathFor(lang, ed, "buy"), label: c("faq.cta.agency", lang), who: `${config.agency.name} · ${c("common.sponsored", lang)}` };
  else if (config.partners[it.cta]) next = { href: `${talk}?cat=${it.cta}#form`, label: c(`faq.cta.${it.cta}`, lang), who: `${config.partners[it.cta]} · ${c("common.sponsored", lang)}` };
  else next = { href: `${talk}?cat=${it.cta}#form`, label: c("common.nav.talk", lang), who: c(`faq.who.${it.cta}`, lang) };
  return { ...it, next, sources: [...byUrl.values()], checked };
});
const stages: Stage[] = ["before", "buying", "after"];
const lastChecked = items.map((i) => i.checked).filter(Boolean).sort().pop();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((it) => ({ "@type": "Question", name: it.q, acceptedAnswer: { "@type": "Answer", text: it.a } })),
};
---
<V2 lang={lang} ed={ed} page="faq" title={`${c("faq.title", lang)} | Imóveis Portugal`} description={c("faq.lede", lang)}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="frame read help">
    <h1>{c("faq.title", lang)}</h1>
    <p class="lede">{c("faq.lede", lang)}</p>
    <div class="search" role="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" type="search" placeholder={c("faq.search", lang)} aria-label={c("faq.search", lang)} autocomplete="off" />
    </div>
    <ul class="stages">
      {stages.map((s) => <li><a href={`#${s}`}>{c(`faq.stage.${s}.h`, lang)} <span class="c">{items.filter((i) => i.stage === s).length}</span></a></li>)}
    </ul>
    {lastChecked && <p class="small" style="margin-top:16px">{c("faq.updated", lang, { date: fmtDate(lang, lastChecked) })}</p>}
  </div>
  <div class="frame read">
    <div class="none" id="none" role="status">
      <p>{c("faq.none", lang)}</p>
      <a class="btn" href={`${talk}#form`}>{c("common.nav.talk", lang)}</a>
    </div>
    {stages.map((s) => (
      <section class="stage" id={s} aria-labelledby={`${s}-h`}>
        <h2 id={`${s}-h`}>{c(`faq.stage.${s}.h`, lang)}</h2>
        <p>{c(`faq.stage.${s}.p`, lang)}</p>
        {items.filter((i) => i.stage === s).map((it) => (
          <details class="qa" id={it.id}>
            <summary>{it.q}</summary>
            <div class="a">
              <p>{it.a}</p>
              {it.sources.length > 0 && (
                <p class="src">{c("common.sources", lang)}: {it.sources.map((f, i) => (<>{i > 0 && "; "}<a href={f.url} rel="noopener">{f.title}</a></>))}{it.checked && `. ${c("common.checked", lang, { date: fmtDate(lang, it.checked) })}.`}</p>
              )}
              <div class="next">
                <a class="btn sm" href={it.next.href}>{it.next.label}</a>
                <span class="who">{it.next.who}</span>
              </div>
            </div>
          </details>
        ))}
      </section>
    ))}
    <p class="disc">{DISCLAIMER[lang]}</p>
  </div>
  <script is:inline>
    (function () {
      var q = document.getElementById("q"), none = document.getElementById("none");
      var norm = function (s) { return s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase(); };
      var items = [].slice.call(document.querySelectorAll(".qa")).map(function (d) { return { d: d, t: norm(d.textContent) }; });
      // Open the question named in the address bar (links from other pages).
      if (location.hash) { var t = document.getElementById(location.hash.slice(1)); if (t && t.tagName === "DETAILS") t.open = true; }
      q.addEventListener("input", function () {
        var words = norm(q.value).split(/\s+/).filter(Boolean), shown = 0;
        items.forEach(function (it) {
          var ok = words.every(function (w) { return it.t.indexOf(w) > -1; });
          it.d.hidden = !ok; if (ok) shown++;
          it.d.open = words.length > 0 && ok && shown <= 3;
        });
        document.querySelectorAll(".stage").forEach(function (s) { s.hidden = !s.querySelector(".qa:not([hidden])"); });
        none.classList.toggle("on", shown === 0);
      });
    })();
  </script>
</V2>
