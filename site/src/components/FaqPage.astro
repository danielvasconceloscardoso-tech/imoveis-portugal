---
// FAQ as a help centre (prompts 09 and 10; Wise and Stripe help pages as the model): search first, questions
// grouped by stage and ordered by search interest, short answers with sources, one partner action each.
// No sponsor yet in a category: the button says "Talk to a partner" and opens the enquiry form.
import V2 from "../layouts/V2.astro";
import { config } from "../config";
import { pathFor, type Lang, type EdCode } from "../i18n";
import { faqFor, FACTS, fmtDate, DISCLAIMER, Sources, type FaqItem } from "../lib/content";
import { faqPlace, stationDoor, FAQ_STAGES, type FaqStage } from "../lib/path";
import Calls from "./Calls.astro";
import { c } from "../lib/copy";

interface Props { lang: Lang; ed: EdCode; }
const { lang, ed } = Astro.props;
const talk = pathFor(lang, ed, "talk");

// Sources as superscripts (prompt 11): one numbered list for the whole page, at the bottom.
const src = new Sources();
// Practice questions also offer the two calls with the partner agency (prompt 11, D19).
const PRACTICE = ["find", "timing", "cpcv", "buy-abroad"];
// D52: for a high budget (from the map, the path or a link) these questions move to the top of their stage; the rest
// stays as it is. Nothing is labelled and the threshold is never shown.
const HIGH_FIRST = ["ifici", "inherit", "visa", "yearly", "lawyer"];
// Prompt 27 §2: the questions the path adds for selling and inheritance join the hub (answers from the path's sources).
const EXTRA: (FaqItem & { ask?: boolean })[] = [
  { id: "sell-filing", facts: ["pt-is-inheritance-filing"], cta: "tax", ask: false },
  { id: "sell-heirs", facts: [], cta: "lawyer", ask: true },
  { id: "sell-cert", facts: [], cta: "lawyer", ask: true },
].map((x, i) => ({ ...x, id: `${lang}-${x.id}`, rank: 100 + i, stage: "after", cta: x.cta as FaqItem["cta"],
  q: c(`journey.q.${x.id.replace("-", ".")}.q`, lang), a: c(`journey.q.${x.id.replace("-", ".")}.a`, lang) }));
const PLACE: Record<string, [FaqStage, string]> = { "sell-filing": ["inheritance", "inherit"], "sell-heirs": ["inheritance", "inherit"], "sell-cert": ["selling", "prepare"] };
const journey = pathFor(lang, ed, "journey");
const items = [...faqFor(ed, lang), ...EXTRA].map((it: FaqItem & { ask?: boolean }) => {
  const facts = (it.facts || []).map((id) => FACTS[id]);
  const checked = facts.map((f) => f.checked_on).sort().pop();
  const nums = [...new Set((it.facts || []).map((id) => src.n(id)))];
  let next: { href: string; label: string; who: string };
  if (it.cta === "agency") next = { href: pathFor(lang, ed, "buy"), label: c("faq.cta.agency", lang), who: `${config.agency.name} · ${c("common.gold", lang)}` };
  else if (config.partners[it.cta]) next = { href: `${talk}?cat=${it.cta}#form`, label: c(`faq.cta.${it.cta}`, lang), who: `${config.partners[it.cta]} · ${c("common.sponsored", lang)}` };
  else next = { href: `${talk}?cat=${it.cta}#form`, label: c("common.nav.talk", lang), who: c(`faq.who.${it.cta}`, lang) };
  const practice = PRACTICE.some((k) => it.id.endsWith(`-${k}`));
  const high = HIGH_FIRST.some((k) => it.id.endsWith(`-${k}`));
  // Each answer links to its station on the path (prompt 27 §2); the station lists these questions back.
  const pl = PLACE[it.id.slice(lang.length + 1)] ?? (() => { const f = faqPlace(it.id); return f ? [f.stage, f.station] as [FaqStage, string] : null; })();
  const stage: FaqStage = pl?.[0] ?? (it.stage === "after" ? "owning" : it.stage);
  const onpath = pl ? { href: `${journey}?door=${stationDoor(pl[1])}&step=${pl[1]}`, label: c("faq.onpath", lang, { step: c(`path.st.${pl[1]}.h`, lang) }) } : null;
  return { ...it, stage, onpath, next, nums, checked, practice, high };
});
const stages = FAQ_STAGES.filter((s) => items.some((i) => i.stage === s));
const lastChecked = items.map((i) => i.checked).filter(Boolean).sort().pop();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((it) => ({ "@type": "Question", name: it.q, acceptedAnswer: { "@type": "Answer", text: it.a } })),
};
---
<V2 lang={lang} ed={ed} page="faq" title={`${c("faq.title", lang)} | Imóveis Portugal`} description={c("faq.lede", lang)}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="frame read help">
    <h1>{c("faq.title", lang)}</h1>
    <p class="lede">{c("faq.lede", lang)}</p>
    <div class="search" role="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" type="search" placeholder={c("faq.search", lang)} aria-label={c("faq.search", lang)} autocomplete="off" />
    </div>
    <ul class="stages">
      {stages.map((s) => <li><a href={`#${s}`}>{c(`faq.stage.${s}.h`, lang)} <span class="c">{items.filter((i) => i.stage === s).length}</span></a></li>)}
    </ul>
    {lastChecked && <p class="small" style="margin-top:16px">{c("faq.updated", lang, { date: fmtDate(lang, lastChecked) })}</p>}
  </div>
  <div class="frame read">
    <div class="none" id="none" role="status">
      <p>{c("faq.none", lang)}</p>
      <a class="btn" href={`${talk}#form`}>{c("common.nav.talk", lang)}</a>
    </div>
    {stages.map((s) => (
      <section class="stage" id={s} aria-labelledby={`${s}-h`}>
        <h2 id={`${s}-h`}>{c(`faq.stage.${s}.h`, lang)}</h2>
        <p>{c(`faq.stage.${s}.p`, lang)}</p>
        {items.filter((i) => i.stage === s).map((it) => (
          <details class="qa" id={it.id} data-high-first={it.high ? "" : undefined}>
            <summary>{it.q}</summary>
            <div class="a">
              <p>{it.a}{it.nums.map((n) => <a class="sup" href={`#fonte-${n}`}>{n}</a>)}</p>
              {it.ask && <p class="small">{c("journey.unverified", lang)}</p>}
              {it.onpath && <p class="small"><a href={it.onpath.href}>{it.onpath.label}</a></p>}
              <div class="next">
                <a class="btn sm" href={it.next.href}>{it.next.label}</a>
                <span class="who">{it.next.who}</span>
              </div>
              {it.practice && <Calls lang={lang} ed={ed} compact />}
            </div>
          </details>
        ))}
      </section>
    ))}
    <script is:inline>(function(){try{var b=Number(new URLSearchParams(location.search).get("budget"))||Number(localStorage.getItem("ip.budget"))||0;if(b<1e6)return;document.querySelectorAll("section.stage").forEach(function(sec){var first=sec.querySelector("details.qa");[].slice.call(sec.querySelectorAll("details[data-high-first]")).reverse().forEach(function(d){sec.insertBefore(d,sec.querySelector("details.qa"))})})}catch(e){}})();</script>
    <section class="sources-list" aria-labelledby="fontes">
      <h2 id="fontes" class="h-small">{c("common.sources", lang)}</h2>
      <ol>
        {src.list.map((f, i) => <li id={`fonte-${i + 1}`}><a href={f.url} rel="noopener">{f.title}</a>{f.checked && `, ${c("common.checked", lang, { date: fmtDate(lang, f.checked) })}`}.</li>)}
      </ol>
    </section>
    <p class="disc">{DISCLAIMER[lang]}</p>
  </div>
  <script is:inline>
    (function () {
      var q = document.getElementById("q"), none = document.getElementById("none");
      var norm = function (s) { return s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase(); };
      var items = [].slice.call(document.querySelectorAll(".qa")).map(function (d) { return { d: d, t: norm(d.textContent) }; });
      // Open the question named in the address bar (links from other pages).
      if (location.hash) { var t = document.getElementById(location.hash.slice(1)); if (t && t.tagName === "DETAILS") t.open = true; }
      q.addEventListener("input", function () {
        var words = norm(q.value).split(/\s+/).filter(Boolean), shown = 0;
        items.forEach(function (it) {
          var ok = words.every(function (w) { return it.t.indexOf(w) > -1; });
          it.d.hidden = !ok; if (ok) shown++;
          it.d.open = words.length > 0 && ok && shown <= 3;
        });
        document.querySelectorAll(".stage").forEach(function (s) { s.hidden = !s.querySelector(".qa:not([hidden])"); });
        none.classList.toggle("on", shown === 0);
      });
    })();
  </script>
</V2>
