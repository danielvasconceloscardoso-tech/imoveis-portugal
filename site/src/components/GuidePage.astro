---
// Free e-book download page: "What it really costs to buy in Portugal", one per edition in PT, EN and FR,
// built from content/facts/facts.csv by `npm run ebooks`. The newsletter signup sits next to the download.
import C from "../layouts/C.astro";
import Embed from "./Embed.astro";
import { config } from "../config";
import { t, pathFor, type Lang, type EdCode } from "../i18n";
import { strings, EBOOK } from "../lib/content";
import { COUNTRIES } from "../../ebooks/countries";

interface Props { lang: Lang; ed: EdCode; }
const { lang, ed } = Astro.props;
const S = strings(lang);
const T = t(ed, lang);
const G = {
  pt: { lede: "Um guia gratuito de 10 páginas, com a fonte oficial de cada número.", inside: "O que está lá dentro", items: ["Todos os impostos da compra em 2026, incluindo a nova taxa de IMT para não residentes e as suas exceções.", "Contas feitas para casas de 250 000 € e 400 000 €, como residente e como não residente.", "As regras do crédito do Banco de Portugal, os impostos anuais e uma lista de verificação para comprar à distância.", "{c}: o representante fiscal e as regras do país onde vive que estão verificadas."], dl: "Descarregar o guia (PDF)", signup: "Receba também a newsletter semanal" },
  en: { lede: "A free 10-page guide, with the official source for every number.", inside: "What's inside", items: ["Every purchase tax in 2026, including the new transfer tax rate for non-residents and its exceptions.", "Worked examples for homes at 250,000 € and 400,000 €, as a resident and as a non-resident.", "Banco de Portugal's mortgage rules, the yearly taxes and a checklist for buying from abroad.", "{c}: the tax representative and the verified rules of the country where you live."], dl: "Download the guide (PDF)", signup: "Get the weekly newsletter too" },
  fr: { lede: "Un guide gratuit de 10 pages, avec la source officielle de chaque chiffre.", inside: "Ce qu'il contient", items: ["Tous les impôts de l'achat en 2026, dont le nouveau taux d'IMT pour les non-résidents et ses exceptions.", "Des calculs pour des biens de 250 000 € et 400 000 €, en résident et en non-résident.", "Les règles de crédit de la Banque du Portugal, les impôts annuels et une liste de contrôle pour acheter à distance.", "{c} : le représentant fiscal et les règles vérifiées de votre pays de résidence."], dl: "Télécharger le guide (PDF)", signup: "Recevez aussi la newsletter hebdomadaire" },
}[lang];
---
<C lang={lang} ed={ed} page="guide" title={`${EBOOK.title[lang]} | Imóveis Portugal`} description={G.lede}>
  <div class="w ph g">
    <h1>{EBOOK.title[lang]}</h1>
    <p class="lede">{G.lede}</p>
  </div>
  <div class="w">
    <section class="row g" aria-labelledby="inside">
      <h2 id="inside">{G.inside}</h2>
      <div class="body">
        <ul class="cats">{G.items.map((i) => i.replace("{c}", COUNTRIES[ed].h[lang])).map((i) => <li><p style="color:var(--ink)">{i}</p></li>)}</ul>
        <a class="btn" href={EBOOK.file(lang, ed)} download>{G.dl}</a>
      </div>
    </section>
    <section class="row g" aria-labelledby="signup">
      <h2 id="signup">{G.signup}</h2>
      <div class="body">
        <Embed id={config.forms.newsletter[lang]} title={G.signup} pending={T.formPending(config.contactEmail)} hidden={{ edition: ed, lang }} height={260} />
        <p class="small"><a href={pathFor(lang, ed, "privacy")}>{T.footer.privacy}</a></p>
      </div>
    </section>
  </div>
  <div class="disc">
    <div class="w g"><p>{S.disclaimer}</p></div>
  </div>
</C>
