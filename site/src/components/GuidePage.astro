---
// Free guide page: one report per edition in pt, en and fr, built from content/facts/facts.csv by
// `npm run ebooks` (cover image in public/ebooks/covers/). One action: download. Wording: COPY_DECK.md "guide.*".
// Fix step 5 (3 Nov): the signup says what Maré is ("Maré, a newsletter", then the sentence, mare.line).
import V2 from "../layouts/V2.astro";
import Embed from "./Embed.astro";
import { config } from "../config";
import { pathFor, type Lang, type EdCode } from "../i18n";
import { EBOOK, DISCLAIMER } from "../lib/content";
import { c, cl } from "../lib/copy";
import { COUNTRIES } from "../../ebooks/countries";
import { PAGES } from "../../ebooks/pages";

interface Props { lang: Lang; ed: EdCode; }
const { lang, ed } = Astro.props;
const title = c("guide.title", lang);
const file = EBOOK.file(lang, ed);
---
<V2 lang={lang} ed={ed} page="guide" title={`${title} | Imóveis Portugal`} description={c("guide.lede", lang, { n: PAGES })}
  sticky={{ href: file, label: c("common.sticky.guide", lang) }}>
  <section class="hero">
    <div class="frame grid">
      <div>
        <h1>{title}</h1>
        <p class="lede">{c("guide.lede", lang, { n: PAGES })}</p>
        <a class="btn" href={file} download data-primary>{c("guide.download", lang)}</a>
      </div>
      <img class="cover" src={`/ebooks/covers/${ed}-${lang}.webp`} width="600" height="849" alt={title} loading="lazy" />
    </div>
  </section>
  <section class="band white" aria-labelledby="inside">
    <div class="frame split">
      <div><h2 id="inside">{c("guide.inside.h", lang)}</h2></div>
      <ul class="list">{cl("guide.inside", lang, { country: COUNTRIES[ed].h[lang] }).map((i) => <li>{i}</li>)}</ul>
    </div>
  </section>
  <section class="band" aria-labelledby="signup">
    <div class="frame read">
      <h2 id="signup">{c("guide.signup.h", lang)}</h2>
      <p class="lede" style="margin-top:12px">{c("mare.line", lang)}</p>
      <div style="margin-top:16px">
        {config.forms.newsletter[lang] && !config.forms.newsletter[lang].startsWith("http")
          ? <a class="btn" href={`${pathFor(lang, ed, "mare")}?de=guide`}>{c("home.subscribe", lang)}</a>
          : <Embed id={config.forms.newsletter[lang]} title={c("guide.signup.h", lang)} cta={c("home.subscribe", lang)} subject={c("home.subscribe.subject", lang)} hidden={{ edition: ed, lang }} height={200} />}
      </div>
      <p class="small" style="margin-top:12px"><a href={pathFor(lang, ed, "privacy")}>{c("common.privacy", lang)}</a></p>
      <p class="disc">{DISCLAIMER[lang]}</p>
    </div>
  </section>
</V2>
