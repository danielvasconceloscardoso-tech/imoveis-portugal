---
// The partner agency's free "Consulta privada" (prompt 21 §2, D39), replacing the two calls of prompt 11.
import { pathFor, type Lang, type EdCode } from "../i18n";
import { c } from "../lib/copy";
interface Props { lang: Lang; ed: string; compact?: boolean; }
const { lang, ed, compact = false } = Astro.props;
const href = pathFor(lang, ed as EdCode, "consult");
---
{compact ? (
  <p class="calls-inline"><a href={href}>{c("consult.cta", lang)}</a></p>
) : (
  <div class="calls">
    <a class="call" href={href}><b>{c("consult.card.h", lang)}</b><span>{c("consult.card.p", lang)}</span></a>
  </div>
)}
