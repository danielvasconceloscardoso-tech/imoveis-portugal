---
// "O que compra" (prompt 12, section 1): m² per budget in Portugal and where the reader lives.
// Figures: src/lib/compare.ts (facts.csv); wording: COPY_DECK.md "compare.*".
import V2 from "../layouts/V2.astro";
import { pathFor, eur, type Lang, type EdCode } from "../i18n";
import { Sources, fmtDate } from "../lib/content";
import { PT_PLACES, ABROAD, GONDOMAR, BUDGETS, GENEVA_CHF, INE_QUARTER, m2For, type Place } from "../lib/compare";
import { c, edName } from "../lib/copy";

interface Props { lang: Lang; ed: EdCode; }
const { lang, ed } = Astro.props;
const src = new Sources();
const abroad = ABROAD[ed] ?? [];
const nf = new Intl.NumberFormat(lang === "en" ? "en" : lang === "fr" ? "fr" : "pt-PT");
const quarter = { pt: "2.º trimestre de 2026", en: "Q2 2026", fr: "2e trimestre 2026" }[lang];
const ecbDate = fmtDate(lang, "2026-10-23");
const lead = abroad[0] ?? PT_PLACES[0];
const line = c("compare.line", lang, { budget: eur(500000, lang), a: m2For(500000, lead), placeA: c(`compare.in.${lead.key}`, lang), b: m2For(500000, GONDOMAR), placeB: c(`compare.in.${GONDOMAR.key}`, lang) });
const rowsFor = (places: Place[]) => places.map((p) => ({ ...p, label: c(`compare.place.${p.key}`, lang), n: src.n(p.fact) }));
const ptRows = rowsFor(PT_PLACES), abRows = rowsFor(abroad);
if (ed === "ch") src.n("ecb-eur-chf");
const share = `/share/compare-${ed}-${lang}.png`;
---
<V2 lang={lang} ed={ed} page="compare" title={`${c("compare.title", lang)} | Imóveis Portugal · ${edName(ed, lang)}`} description={line}>
  <div class="frame read ph">
    <h1>{c("compare.title", lang)}</h1>
    <p class="lede">{c("compare.lede", lang)}</p>
    <p class="big-line">{line}</p>
  </div>
  <div class="frame read compare">
    {BUDGETS.map((b) => (
      <section aria-labelledby={`b${b}`}>
        <h2 id={`b${b}`} class="h3">{c("compare.budget.h", lang, { budget: eur(b, lang) })}</h2>
        <table class="cmp">
          <thead><tr><th scope="col">{c("compare.col.place", lang)}</th><th scope="col">{c("compare.col.m2", lang)}</th><th scope="col">{c("compare.col.buys", lang)}</th></tr></thead>
          <tbody>
            {abRows.map((p) => <tr class="abroad"><th scope="row">{p.label}<a class="sup" href={`#fonte-${p.n}`}>{p.n}</a></th><td>{eur(p.m2, lang)}</td><td><span class="bar" style={`--w:${Math.min(100, m2For(b, p) / m2For(b, PT_PLACES[5]) * 100)}%`}></span>{nf.format(m2For(b, p))} m²</td></tr>)}
            {ptRows.map((p) => <tr class={p.key === "gondomar" ? "hl" : undefined}><th scope="row">{p.label}<a class="sup" href={`#fonte-${p.n}`}>{p.n}</a></th><td>{eur(p.m2, lang)}</td><td><span class="bar" style={`--w:${Math.min(100, m2For(b, p) / m2For(b, PT_PLACES[5]) * 100)}%`}></span>{nf.format(m2For(b, p))} m²</td></tr>)}
          </tbody>
        </table>
      </section>
    ))}
    {abroad.length === 0 && <p>{c("compare.abroad.none", lang, { country: edName(ed, lang) })}</p>}
    <p class="small">{c("compare.note", lang)} {c("compare.note.pt", lang, { quarter })}{ed === "lu" && ` ${c("compare.note.mean", lang)}`}{ed === "ch" && ` ${c("compare.note.canton", lang, { chf: nf.format(GENEVA_CHF), date: ecbDate })}`}</p>
    <h2 class="h3" style="margin-top:40px">{c("compare.share.h", lang)}</h2>
    <p>{c("compare.share.p", lang)}</p>
    <p><a class="btn ghost sm" href={share} download>{c("compare.share.link", lang)}</a></p>
  </div>
  <section class="sources-list" aria-labelledby="fontes">
    <div class="frame read">
      <h2 id="fontes" class="h-small">{c("common.sources", lang)}</h2>
      <ol>{src.list.map((s, i) => <li id={`fonte-${i + 1}`}><a href={s.url} rel="noopener">{s.title}</a>{s.checked && `, ${c("common.checked", lang, { date: fmtDate(lang, s.checked) })}`}.</li>)}</ol>
    </div>
  </section>
</V2>
