---
// One click from everything (prompt 35 §3.3-3.4, D61; prompt 43: no mobile tab bar, the same navigation everywhere):
// one search for the whole site (the magnifier, ⌘K) and the concierge as a sheet over the page the reader is on.
// Without JavaScript the Concierge button goes to its page.
import Flow from "./Flow.astro";
import { pathFor, type Lang, type EdCode, type PageKey } from "../i18n";
import { c } from "../lib/copy";
import "../styles/chrome.css";
import "../styles/sheet.css";

interface Props { lang: Lang; ed: EdCode; page: PageKey | "home"; }
const { lang, ed, page } = Astro.props;
const L = { place: c("find.g.place", lang), faq: c("find.g.faq", lang), sim: c("find.g.sim", lang), step: c("find.g.step", lang), page: c("find.g.page", lang), none: c("find.none", lang) };
---

<div class="fd" data-find hidden role="dialog" aria-modal="true" aria-label={c("find.open", lang)} data-index={`/search/${lang}-${ed}.json`} data-labels={JSON.stringify(L)}>
  <div class="fd-box">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg>
    <input type="search" data-find-in role="combobox" aria-expanded="true" aria-controls="fd-res" aria-autocomplete="list" autocomplete="off" placeholder={c("find.ph", lang)} />
    <ul id="fd-res" role="listbox" data-find-res></ul>
  </div>
</div>

{page !== "consult" && (
  <script is:inline>(function(){var w=window;w.__ipCgShim=function(e){var a=e.target&&e.target.closest&&e.target.closest("a[data-concierge]");if(!a||e.metaKey||e.ctrlKey||e.shiftKey||w.__ipCgReady)return;e.preventDefault();w.__ipCgPending=a.href;setTimeout(function(){if(!w.__ipCgReady)location.href=a.href;},4000);};document.addEventListener("click",w.__ipCgShim,true);})();</script>
  <div class="sh-back" data-cg-back hidden></div>
  <aside class="sh" data-cg-sheet hidden role="dialog" aria-modal="true" aria-label={c("flow.c.title", lang)}>
    <span class="sh-grab" aria-hidden="true"></span>
    <div class="sh-top"><p class="sh-title">{c("flow.c.title", lang)}</p><button type="button" class="sh-x" data-cg-x aria-label={c("flow.close", lang)}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <div class="sh-in"><Flow lang={lang} ed={ed} flow="concierge" param="concierge" sheet /></div>
  </aside>
)}

<script>
  import { initChrome } from "../scripts/chrome";
  initChrome();
</script>
