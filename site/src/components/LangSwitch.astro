---
// D18: language switch on every page. The choice is kept in localStorage (no cookies) and used by
// the root page to send returning visitors straight to their language and edition.
import { LANGS, pathFor, HTML_LANG, type Lang, type EdCode, type PageKey } from "../i18n";
interface Props { lang: Lang; ed: EdCode; page: PageKey | "home"; label: string; cls?: string; }
const { lang, ed, page, label, cls = "sw" } = Astro.props;
---
<span class={cls} role="group" aria-label={label}>
  {LANGS.map((l) => (
    <a href={pathFor(l, ed, page)} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} data-lang={l} aria-current={l === lang ? "true" : undefined}>{l.toUpperCase()}</a>
  ))}
</span>
<script is:inline define:vars={{ ed, lang }}>
  try {
    localStorage.setItem("ip-ed", ed);
    if (!localStorage.getItem("ip-lang")) localStorage.setItem("ip-lang", lang);
    document.addEventListener("click", (e) => {
      const a = e.target.closest && e.target.closest("a[data-lang]");
      if (a) localStorage.setItem("ip-lang", a.dataset.lang);
    });
  } catch (_) {}
</script>
