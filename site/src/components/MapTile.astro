---
// The small map tile at the end of an article (D83): the municipality drawn among its neighbours, the partner
// developments as dots, built at build time from the map's own boundaries (public/data/map/munis.topo.json, OSM, ODbL).
// One tap opens the map on that place, where the developments layer is on by default (scripts/map-v3.ts).
// Event: {ed}/art/{id}/tile (lib/events.ts).
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { feature } from "topojson-client";
import { pathFor, type Lang, type EdCode } from "../i18n";
import { PROJECTS } from "../lib/projects";
import { c } from "../lib/copy";

interface Props { lang: Lang; ed: EdCode; place: string; name: string; story: string; }
const { lang, ed, place, name, story } = Astro.props;
const topo = JSON.parse(readFileSync(join(process.cwd(), "public", "data", "map", "munis.topo.json"), "utf8"));
const fc = feature(topo, topo.objects.m) as unknown as { features: { properties: { s: string; n: string }; geometry: { type: string; coordinates: any } }[] };
const rings = (g: { type: string; coordinates: any }): number[][][] => (g.type === "Polygon" ? g.coordinates : g.type === "MultiPolygon" ? g.coordinates.flat() : []);
const bbox = (rs: number[][][]) => { let a = Infinity, b = Infinity, cc = -Infinity, d = -Infinity; for (const r of rs) for (const [x, y] of r) { a = Math.min(a, x); b = Math.min(b, y); cc = Math.max(cc, x); d = Math.max(d, y); } return [a, b, cc, d]; };
const target = fc.features.find((f) => f.properties.s === place);
if (!target) throw new Error(`MapTile: no municipality ${place}`);
const [x0, y0, x1, y1] = bbox(rings(target.geometry));
const k = Math.cos(((y0 + y1) / 2) * Math.PI / 180);  // equirectangular, longitude scaled at this latitude
const W = 300, H = 200;
// The frame: the place in the middle with room for its neighbours, at 3:2.
const cx = (x0 + x1) / 2, cy = (y0 + y1) / 2;
let spanX = Math.max((x1 - x0) * k * 2.4, 0.32), spanY = Math.max((y1 - y0) * 2.4, 0.32 * H / W);
if (spanX / spanY > W / H) spanY = spanX * H / W; else spanX = spanY * W / H;
const px = (x: number) => ((x - cx) * k / spanX + 0.5) * W, py = (y: number) => (0.5 - (y - cy) / spanY) * H;
const inView = (rs: number[][][]) => { const [a, b, cc, d] = bbox(rs); return px(cc) > -20 && px(a) < W + 20 && py(b) > -20 && py(d) < H + 20; };
const pathOf = (rs: number[][][]) => rs.map((r) => `M${r.map(([x, y]) => `${px(x).toFixed(1)},${py(y).toFixed(1)}`).join("L")}Z`).join("");
const around = fc.features.filter((f) => f.properties.s !== place && inView(rings(f.geometry))).map((f) => pathOf(rings(f.geometry)));
const here = pathOf(rings(target.geometry));
const dots = PROJECTS.filter((p) => p.lon && p.lat).map((p) => ({ x: px(p.lon), y: py(p.lat) })).filter((p) => p.x > 4 && p.x < W - 4 && p.y > 4 && p.y < H - 4);
const href = `${pathFor(lang, ed, "map")}?place=${place}`;
---
<a class="st-tile" href={href} data-tile={place} data-story={story}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={c("lifea.tile.alt", lang, { place: name })}>
    <rect width={W} height={H} class="sea" />
    {around.map((d) => <path d={d} class="land" />)}
    <path d={here} class="here" />
    {dots.map((p) => <circle cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="4" class="dev" />)}
  </svg>
  <span class="st-tile-t">{c("lifea.tile", lang, { place: name })}<span aria-hidden="true"> →</span></span>
</a>
