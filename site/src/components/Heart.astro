---
// A heart that saves a home or a region to "A sua seleção" on the reader's device (scripts/hearts.ts, lib/saved.ts).
// The state is set by the script from localStorage; without JavaScript the button does nothing and stays quiet.
import type { Lang } from "../i18n";
import { c } from "../lib/copy";

interface Props { lang: Lang; kind: "home" | "region"; id: string; label: string; href: string; class?: string; }
const { lang, kind, id, label, href, class: cls } = Astro.props;
---
<button type="button" class={["ht", cls].filter(Boolean).join(" ")} data-save={kind} data-id={id} data-label={label} data-href={href} aria-pressed="false" aria-label={`${c("bar.heart.add", lang)}: ${label}`}><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 20.2s-7.2-4.5-7.2-10.1A4.1 4.1 0 0 1 12 7.5a4.1 4.1 0 0 1 7.2 2.6c0 5.6-7.2 10.1-7.2 10.1z"/></svg></button>
