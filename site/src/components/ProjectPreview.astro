---
// Prompt 71 §3: a developer's private preview (lib/previews.ts), English only, noindex (layouts/Demo.astro): the projects
// as the US edition's map shows them (render, name, the one line, the tag), the facts and prices they publish, their own
// pages as sources, and one link to the map with their pins in view. Images and facts are theirs, credited to them.
import Demo from "../layouts/Demo.astro";
import { img, type Project } from "../lib/projects";
import { FACTS } from "../lib/content";
import type { Preview } from "../lib/previews";
interface Props { p: Preview }
const { p } = Astro.props;
const money = (v: number) => new Intl.NumberFormat("en-US", { style: "currency", currency: "EUR", maximumFractionDigits: 0 }).format(v);
const muni: Record<string, string> = { loule: "Vilamoura, Loulé", lagos: "Lagos" };
const golf = FACTS["palmares-golf-27-holes"];
const checked = p.projects.map((x) => x.checked).filter(Boolean).sort().pop();
const line = (x: Project) => x.lines?.en ?? x.line ?? "";
---
<Demo title={`Private preview · ${p.developer} · Imóveis Portugal`} developer={p.developer} accent="#10233a">
  <style is:global>
    .pv { max-width: 1120px; margin: 0 auto; padding: 48px 24px 24px; }
    .pv-k { font: 500 12px/1.2 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin: 0 0 12px; }
    .pv h1 { font: 400 clamp(2.2rem, 1.6rem + 3vw, 3.8rem)/1.05 var(--serif); margin: 0 0 14px; }
    .pv-lede { font-size: 1.1rem; color: #33363b; margin: 0 0 32px; max-width: 46ch; }
    .pv-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 48px; }
    .pv-item { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 32px; align-items: start; border-top: 1px solid var(--rule); padding-top: 32px; }
    .pv-item img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; display: block; }
    .pv-cr { font-size: 12px; color: var(--muted); margin: 6px 0 0; }
    .pv-tag { display: inline-block; font: 500 11px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; border: 1px solid var(--ink); padding: 5px 7px; margin-bottom: 12px; }
    .pv-item h2 { font: 400 2rem/1.1 var(--serif); margin: 0 0 6px; } .pv-where { color: var(--muted); margin: 0 0 14px; font-size: 15px; }
    .pv-hero { font: 400 1.35rem/1.35 var(--serif); margin: 0 0 14px; } .pv-line { font-size: 15px; color: #3c3f44; margin: 0 0 14px; }
    .pv-from { font-weight: 500; margin: 0 0 12px; } .pv-src { font-size: 13px; color: var(--muted); } .pv-src a { overflow-wrap: anywhere; }
    .pv-map { display: inline-block; margin: 48px 0 8px; background: var(--ink); color: #fff; text-decoration: none; padding: 16px 26px; font: 500 14px/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; }
    .pv-note { font-size: 13px; color: var(--muted); max-width: 70ch; }
    @media (max-width: 820px) { .pv-item { grid-template-columns: 1fr; gap: 16px; } }
  </style>
  <main class="pv">
    <p class="pv-k">Private preview</p>
    <h1>{p.developer}</h1>
    <p class="pv-lede">{p.lede}</p>
    <ul class="pv-list">
      {p.projects.map((x) => (
        <li class="pv-item">
          <div>
            {x.heroImg && <img src={img(x.heroImg, 1600)} srcset={`${img(x.heroImg, 800)} 800w, ${img(x.heroImg, 1600)} 1600w`} sizes="(max-width: 820px) 100vw, 620px" alt="" width="1600" height="900" loading="lazy" />}
            {x.credit && <p class="pv-cr">{x.credit}</p>}
          </div>
          <div>
            {x.tag?.en && <span class="pv-tag">{x.tag.en}</span>}
            <h2>{x.name}</h2>
            <p class="pv-where">{muni[x.muni] ?? x.muni}</p>
            {x.hero?.en && <p class="pv-hero">{x.hero.en}</p>}
            <p class="pv-line">{line(x)}</p>
            <p class="pv-from">{x.from ? `From ${money(x.from)}` : "Price on request"}</p>
            {x.id === "palmares" && golf && <p class="pv-src">Golf: {golf.value} ({golf.source_title}).</p>}
            <p class="pv-src">Sources: {(x.sources ?? []).map((u, i) => <>{i > 0 && " · "}<a href={u} rel="noopener">{u.replace(/^https:\/\/(www\.)?/, "")}</a></>)}</p>
          </div>
        </li>
      ))}
    </ul>
    <a class="pv-map" href={p.map}>See them on the map</a>
    <p class="pv-note">Facts, prices and images as each development publishes them ({checked}); images credited to Arrow Global / Details. On the map they carry "Our pick", never "Sponsored". A private visit is booked through our consultant, as for every development on the site.</p>
  </main>
</Demo>
