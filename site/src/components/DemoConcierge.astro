---
// Private demos (prompt 28 §2b, D54): "Arrange a private viewing" with the buyer's details already filled in, then the
// buyer's team assembling itself and the developer's view of the same enquiry as a qualified summary. Illustrative:
// the buyer is an example, no real person or data. Roles without a signed partner show no name, as on the site.
import type { Demo } from "../lib/demos";
import { rateOf } from "../lib/demos";
import type { Project, Unit } from "../lib/projects";
import { PRICES } from "../lib/prices";
import { purchase } from "../lib/sims";
import { summary, BRIEF_KEYS, type BriefLabels } from "../lib/brief";
import { c } from "../lib/copy";

interface Props { d: Demo; project: Project; unit: Unit; open?: boolean; }
const { d, project: p, unit: u, open = false } = Astro.props;
const money = (v: number, k = "EUR") => new Intl.NumberFormat("en-US", { style: "currency", currency: k, maximumFractionDigits: 0 }).format(v);
const b = d.buyer, reader = d.readers.find((r) => r.ed === b.ed) ?? d.readers[0];
const total = u.price ? purchase(u.price, false, false, false).total : d.budgets[0];
const own = Math.round((total * b.own) / 1000) * 1000;
const L = Object.fromEntries(BRIEF_KEYS.map((k) => [k, c(`brief.${k}`, "en")])) as BriefLabels;
const line = summary({ door: "buy", total: Math.round(total), own: b.own < 1 ? own : undefined, loan: b.own >= 1 ? 0 : Math.round(total - own), when: b.when, nif: false, places: [PRICES.munis[p.muni].n] },
  L, (v) => money(Math.round(v / 1000) * 1000), (v) => `${Math.round(v)}%`, c(`journey.from.${b.ed}`, "en"));
const fx = (v: number) => (b.cur === "EUR" ? "" : ` (${money(Math.round(v * rateOf(b.cur) / 1000) * 1000, b.cur)})`);
const team = [
  { role: "Developer", name: p.developer, line: `${p.name}: the home, the viewing and the terms of sale.` },
  { role: "Lawyer", line: "NIF, power of attorney and the deed." },
  { role: "Financing", line: "A credit intermediary registered with Banco de Portugal (DL 81-C/2017)." },
  { role: "Currency", line: b.cur === "EUR" ? "Moving the funds into a Portuguese account." : `${b.cur} into euros, at a rate fixed in advance.` },
  { role: `Tax in ${reader.country === "USA" ? "the US" : reader.country}`, line: "The purchase seen from home: reporting, treaty, later the sale." },
];
---
<div class={`dc${open ? " is-open is-static" : ""}`} data-dc>
  <p class="dc-p">The request goes to {p.developer} with the buyer's consent, and with the summary of their case only if they tick it.</p>
  <form class="dc-form" onsubmit="return false">
    <span class="dc-illus">Illustrative example · not a real buyer</span>
    <div class="dc-grid">
      <label>Name<input value="Example buyer" readonly /></label>
      <label>Lives in<input value={`${reader.city}, ${reader.country}`} readonly /></label>
      <label>Budget<input value={money(b.amount, b.cur)} readonly /></label>
      <label>Viewing<input value="In person, or by video first" readonly /></label>
    </div>
    <label class="dc-ok"><input type="checkbox" checked disabled /> I agree that {p.developer} may contact me about this request</label>
    <label class="dc-ok"><input type="checkbox" checked disabled /> Include the summary of my case</label>
    <button type="button" class="dc-btn" data-dc-go>Arrange a private viewing</button>
  </form>

  <div class="dc-after" data-dc-after>
    <section class="dc-team" aria-label="Your team for this purchase">
      <p class="dc-h">Your team for this purchase</p>
      <ol>{team.map((t, i) => <li style={`--i:${i}`}><span class="dc-role">{t.role}</span>{t.name && <span class="dc-name">{t.name} <em>Sponsored</em></span>}<span class="dc-line">{t.line}</span></li>)}</ol>
      <p class="dc-small">Each partner is named before the buyer agrees to be contacted; steps without a partner yet show no name.</p>
    </section>
    <section class="dc-dev" aria-label={`What reaches ${p.developer}`}>
      <p class="dc-h">What reaches {p.developer}</p>
      <div class="dc-mail">
        <p class="dc-subj">New viewing request · {p.name} · {u.typology}{u.area != null && ` · ${new Intl.NumberFormat("en-US").format(u.area)} m²`}</p>
        <p class="dc-line1">{line}</p>
        <p class="dc-small">Total with taxes for this home: {money(Math.round(total))}{fx(total)} · Agreed to be contacted by {p.developer} · Indicative, not a credit assessment. Nothing is decided about the buyer from it; for high budgets the agency's identification and proof of funds still apply (Lei 83/2017).</p>
      </div>
      <span class="dc-illus">Illustrative example · not real data</span>
    </section>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-dc]").forEach((el) => el.querySelector("[data-dc-go]")?.addEventListener("click", () => {
    el.classList.add("is-open");
    (el.querySelector("[data-dc-after]") as HTMLElement).scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" });
  }));
</script>

<style>
  .dc-p { color: var(--muted); margin: 0 0 16px; }
  .dc-form { border: 1px solid var(--rule); padding: 20px; }
  .dc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; margin: 12px 0; }
  .dc-grid label { display: grid; gap: 4px; font-size: 13px; color: var(--muted); }
  .dc-grid input { font: 400 16px var(--sans); color: var(--ink); border: 0; border-bottom: 1px solid var(--ink); padding: 6px 0; background: none; }
  .dc-ok { display: flex; gap: 10px; align-items: center; font-size: 15px; margin: 8px 0; } .dc-ok input { accent-color: var(--accent); width: 18px; height: 18px; }
  .dc-btn { margin-top: 12px; background: var(--ink); color: #fff; border: 0; padding: 16px 26px; font: 500 15px/1 var(--sans); letter-spacing: .06em; text-transform: uppercase; cursor: pointer; }
  .dc-illus { display: inline-block; font: 500 11px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; border: 1px solid var(--ink); padding: 5px 7px; }
  .dc-after { display: none; gap: 24px; margin-top: 28px; grid-template-columns: 1fr 1fr; scroll-margin-top: 24px; }
  .dc.is-open .dc-after { display: grid; }
  .dc-h { font: 400 1.5rem/1.2 var(--serif); margin: 0 0 12px; }
  .dc-team ol { list-style: none; margin: 0; padding: 0; }
  .dc-team li { display: grid; gap: 2px; padding: 12px 0; border-top: 1px solid var(--rule); }
  .dc.is-open .dc-team li { animation: dc-in .6s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--i) * 420ms + 200ms); }
  @keyframes dc-in { from { opacity: 0; transform: translateY(10px); } }
  .dc-role { font: 400 1.15rem/1.3 var(--serif); } .dc-name { font-weight: 600; font-size: 15px; } .dc-name em { font: 600 10px/1 var(--sans); font-style: normal; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); border: 1px solid var(--rule); padding: 3px 5px; margin-left: 6px; }
  .dc-line { font-size: 15px; color: var(--muted); }
  .dc-dev { border-left: 1px solid var(--rule); padding-left: 24px; }
  .dc.is-open .dc-dev { animation: dc-in .7s cubic-bezier(.2,.7,.2,1) both; animation-delay: 2.6s; }
  .dc-mail { background: #f6f5f2; padding: 20px; margin-bottom: 12px; }
  .dc-subj { font: 500 13px/1.4 var(--sans); letter-spacing: .04em; color: var(--muted); margin: 0 0 10px; }
  .dc-line1 { font: 400 1.3rem/1.45 var(--serif); margin: 0 0 12px; }
  .dc-small { font-size: 13px; color: var(--muted); margin: 8px 0 0; }
  .dc.is-static .dc-team li, .dc.is-static .dc-dev { animation: none; }
  @media (max-width: 820px) { .dc-after, .dc-grid { grid-template-columns: 1fr; } .dc-dev { border: 0; padding: 0; } }
  @media (prefers-reduced-motion: reduce) { .dc.is-open .dc-team li, .dc.is-open .dc-dev { animation: none; } }
</style>
