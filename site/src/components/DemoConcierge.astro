---
// Private demos (prompts 28 §2b and 29 §2a, steps 5 and 7): "Arrange a private viewing" with the buyer's details filled
// in and a video viewing chosen, the qualified summary assembling line by line, Send, then "Your team for this
// purchase" lighting up role by role (roles only until a partner signs). Illustrative buyer, no real person or data.
// States: data-dc-step="form" | "sum" | "sent"; the film sets them and the animation time itself.
import type { Demo } from "../lib/demos";
import type { Project, Unit } from "../lib/projects";
import { demoBuyer, money, TEAM } from "../lib/demobuyer";

interface Props { d: Demo; project: Project; unit: Unit; open?: boolean; }
const { d, open = false } = Astro.props;
const { lines, reader } = demoBuyer(d);
const b = d.buyer;
---
<div class={`dc${open ? " is-static" : ""}`} data-dc data-dc-step={open ? "sent" : "form"}>
  <form class="dc-form" onsubmit="return false">
    <span class="dc-illus">Illustrative buyer · no request is sent</span>
    <div class="dc-grid">
      <label>Name<input value="Example buyer" readonly /></label>
      <label>Lives in<input value={`${reader.city}, ${reader.country}`} readonly /></label>
      <label>Budget<input value={money(b.amount, b.cur)} readonly /></label>
      <fieldset class="dc-how"><legend>Viewing</legend>
        <label><input type="radio" name="dc-how" disabled /> In person</label>
        <label><input type="radio" name="dc-how" checked disabled /> By video</label>
      </fieldset>
    </div>
    <label class="dc-ok"><input type="checkbox" checked disabled /> I agree that {d.developer} may contact me about this request</label>
    <label class="dc-ok"><input type="checkbox" checked disabled /> Include the summary of my case</label>
    <div class="dc-sum" id="summary">
      <p class="dc-h4">What goes with the request</p>
      <ul>{lines.map((l, i) => <li style={`--i:${i}`}>{l}</li>)}</ul>
      <p class="dc-small">Indicative, not a credit assessment. Nothing is decided about the buyer from it.</p>
    </div>
    <button type="button" class="dc-btn" data-dc-go><span class="a">Arrange a private viewing</span><span class="b">Send the request</span><span class="c">Request sent ✓</span></button>
  </form>

  <section class="dc-team" id="team" aria-label="Your team for this purchase">
    <p class="dc-h">Your team for this purchase</p>
    <ol>{TEAM.map((t, i) => <li style={`--i:${i}`}><span class="dc-role">{t.role}</span><span class="dc-line">{t.line}</span></li>)}</ol>
    <p class="dc-small">Each partner is named once signed, before the buyer agrees to be contacted; until then the step shows the role only. Viewing by video or in person, then the reservation and the deed.</p>
  </section>
</div>

<script>
  // On the page the button walks the same three states the film shows: form → summary → sent.
  document.querySelectorAll<HTMLElement>("[data-dc]").forEach((el) => el.querySelector("[data-dc-go]")?.addEventListener("click", () => {
    el.dataset.dcStep = el.dataset.dcStep === "form" ? "sum" : "sent";
    const t = el.querySelector(el.dataset.dcStep === "sum" ? ".dc-sum" : ".dc-team");
    t?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "center" });
  }));
  if (new URLSearchParams(location.search).get("sent") === "1") document.querySelectorAll<HTMLElement>("[data-dc]").forEach((el) => (el.dataset.dcStep = "sent"));
</script>

<style>
  .dc-form { border: 1px solid var(--rule); padding: 22px; }
  .dc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 18px; margin: 14px 0; }
  .dc-grid > label { display: grid; gap: 4px; font-size: 13px; color: var(--muted); }
  .dc-grid input:not([type]) , .dc-grid input[readonly] { font: 400 16px var(--sans); color: var(--ink); border: 0; border-bottom: 1px solid var(--ink); padding: 6px 0; background: none; }
  .dc-how { border: 0; margin: 0; padding: 0; font-size: 15px; display: flex; gap: 18px; align-items: end; flex-wrap: wrap; }
  .dc-how legend { font-size: 13px; color: var(--muted); padding: 0; margin-bottom: 6px; width: 100%; }
  .dc-how label { display: inline-flex; gap: 8px; align-items: center; color: var(--ink); } .dc-how input { accent-color: var(--accent); width: 18px; height: 18px; }
  .dc-ok { display: flex; gap: 10px; align-items: center; font-size: 15px; margin: 8px 0; } .dc-ok input { accent-color: var(--accent); width: 18px; height: 18px; }
  .dc-btn { margin-top: 14px; background: var(--ink); color: #fff; border: 0; padding: 16px 26px; font: 500 15px/1 var(--sans); letter-spacing: .06em; text-transform: uppercase; cursor: pointer; }
  .dc-btn .b, .dc-btn .c { display: none; }
  [data-dc-step="sum"] .dc-btn .a, [data-dc-step="sent"] .dc-btn .a, [data-dc-step="sent"] .dc-btn .b { display: none; }
  [data-dc-step="sum"] .dc-btn .b, [data-dc-step="sent"] .dc-btn .c { display: inline; } [data-dc-step="sent"] .dc-btn { background: var(--accent); }
  .dc-illus { display: inline-block; font: 500 11px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; border: 1px solid var(--ink); padding: 5px 7px; }
  .dc-sum { display: none; margin-top: 18px; background: #f6f5f2; padding: 18px 20px; }
  [data-dc-step="sum"] .dc-sum, [data-dc-step="sent"] .dc-sum { display: block; }
  .dc-h4 { font: 500 12px/1 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin: 0 0 10px; }
  .dc-sum ul { list-style: none; margin: 0; padding: 0; } .dc-sum li { font: 400 1.25rem/1.35 var(--serif); padding: 5px 0; border-bottom: 1px solid #e3e3e3; }
  [data-dc-step="sum"] .dc-sum li { animation: dc-in .5s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--i) * 450ms + 150ms); }
  .dc-team { display: none; margin-top: 28px; scroll-margin-top: 24px; }
  [data-dc-step="sent"] .dc-team { display: block; }
  .dc-h { font: 400 1.6rem/1.2 var(--serif); margin: 0 0 12px; }
  .dc-team ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .dc-team li { display: grid; gap: 4px; align-content: start; padding: 14px 0 0; border-top: 2px solid var(--rule); }
  [data-dc-step="sent"] .dc-team li { animation: dc-light .7s ease both; animation-delay: calc(var(--i) * 650ms + 300ms); }
  @keyframes dc-in { from { opacity: 0; transform: translateY(10px); } }
  @keyframes dc-light { from { opacity: .25; border-top-color: var(--rule); } to { opacity: 1; border-top-color: var(--accent); } }
  .dc-role { font: 400 1.2rem/1.3 var(--serif); } .dc-line { font-size: 14px; color: var(--muted); }
  .dc-small { font-size: 13px; color: var(--muted); margin: 10px 0 0; }
  .dc.is-static .dc-sum li, .dc.is-static .dc-team li { animation: none; } .dc.is-static .dc-team li { border-top-color: var(--accent); }
  @media (max-width: 820px) { .dc-grid, .dc-team ol { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .dc-sum li, .dc-team li { animation: none !important; } }
</style>
