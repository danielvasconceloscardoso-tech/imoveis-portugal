---
// Interactive 3D map of Portugal (prompts 16, 19 and 25, D34, D49): any budget → the m² it buys in each concelho, or the
// median €/m², the 10-year growth or the gross rental yield, as 3D extrusions (MapLibre GL, our own TopoJSON from
// OpenStreetMap, no tiles, no key). The live map loads on the first interaction (or when it scrolls into view on the
// home page) over a still image of itself, so pages stay fast on phones; with "reduced motion" or "2D" it is flat.
// Every concelho is reachable: the map (with a hit radius for small ones), the search box and the list under it.
// mode "embed" is the licensable build (prompt 25 §3): no filters or list, "Powered by Imóveis Portugal" and the data credits.
// Data: public/data/map/ and public/data/prices.json (scripts/map-data/). Wording: COPY_DECK.md "map.*".
// Golf layer (prompt 33 §4.1): public/data/map/golf.geojson (scripts/map-data/golf.py), loaded only when "Golf" is tapped or ?golf=1.
import { config } from "../config";
import { HTML_LANG, pathFor, eur, type Lang, type EdCode } from "../i18n";
import { EDITION_CUR, RATE, fmtDate } from "../lib/content";
import { MAP_MUNIS, REGIONS, REGION_PHOTO, BRIEFS } from "../lib/mapdata";
import { PRICES } from "../lib/prices";
import { PLACES } from "../lib/places";
import { PTYPES } from "../lib/packages";
import { SUB } from "../lib/tools";
import { c } from "../lib/copy";
import { PROJECTS } from "../lib/projects";

interface Props { lang: Lang; ed: EdCode; mode?: "page" | "home" | "embed"; }
const { lang, ed, mode = "page" } = Astro.props;
const cur = mode === "embed" ? null : EDITION_CUR[ed];
const fx = cur ? RATE(cur) : null;
const nf = new Intl.NumberFormat(HTML_LANG[lang]);
const lastQ = PRICES.quarters[PRICES.quarters.length - 1];
const qfmt = c("map.qfmt", lang);
const qLabel = qfmt.replace("{q}", lastQ.slice(-1)).replace("{y}", lastQ.slice(0, 4));
const METRICS = ["m2", "price", "growth", "yield"] as const;
const LAYERS = ["sea", "vac", "new", "fr"] as const;  // prompt 25 §4, INE
const pages = new Set(PLACES.map((p) => p.slug));
const month = new Intl.DateTimeFormat(HTML_LANG[lang], { month: "long", year: "numeric" }).format(new Date(`${PRICES.mortgage.month}-15`));
const labels = {
  m2: c("map.card.m2", lang), median: c("map.card.median", lang, { v: "{v}", quarter: "{quarter}" }), nodata: c("map.card.nodata", lang), nodataPar: c("map.par.nodata", lang),
  qfmt, chart: c("map.card.chart", lang), price: c("map.card.price", lang), rent: c("map.card.rent", lang),
  cagrP: c("map.card.cagrp", lang, { v: "{v}" }), gap: c("map.card.gap", lang, { p: "{p}", r: "{r}", d: "{d}" }),
  yield: c("map.card.yield", lang, { y: "{y}", r: "{r}", month: "{month}" }), mo: c("map.card.mo", lang, { c4: "{c4}", c8: "{c8}" }),
  mow: { up: c("map.mo.up", lang), steady: c("map.mo.steady", lang), down: c("map.mo.down", lang) }, cmp: c("map.card.cmp", lang),
  homes: c("map.a.homes", lang), devs: c("dev.card", lang), sim: c("map.a.sim", lang), journey: c("common.nav.journey", lang), page: c("map.a.page", lang),
  private: c("map.a.private", lang), share: c("map.share", lang), shareImg: c("map.shareimg", lang), copied: c("map.copied", lang), close: c("map.close", lang),
  source: c("map.card.source", lang, { quarter: "{quarter}" }), disclaimer: c("map.card.disclaimer", lang),
  parishOf: c("map.par.of", lang, { m: "{m}" }), openMuni: c("map.par.open", lang), nomatch: c("map.find.none", lang),
  credits: "Fonte: INE · © OpenStreetMap contributors", imgFor: c("map.img.for", lang, { b: "{b}" }), imgSrc: c("map.img.src", lang, { quarter: qLabel }),
  legend: Object.fromEntries([...METRICS, ...LAYERS].map((m) => [m, `${c(`map.legend.${m}`, lang, { quarter: qLabel })} ${c("map.hint", lang)}`])),
  fh: c("map.f.h", lang), fdom: c("map.f.dom", lang, { a: "{a}", p: "{p}", q: "{q}" }), fsea: c("map.f.sea", lang, { v: "{v}" }), fvac: c("map.f.vac", lang, { v: "{v}" }),
  sponsored: c("dev.sponsored", lang), pfrom: c("map.proj.from", lang, { v: "{v}" }), ponreq: c("map.proj.onreq", lang), ptyp: c("map.proj.typ", lang, { v: "{v}" }),
  pdel: c("map.proj.del", lang, { v: "{v}" }), pask: c("map.proj.ask", lang), paskdev: c("map.proj.askdev", lang), paskag: c("map.proj.askag", lang), psim: c("map.proj.sim", lang),
  pcredit: c("map.proj.credit", lang, { c: "{c}" }), partnersHere: c("show.partners", lang), openHomes: c("show.open", lang),
  golfUnnamed: c("map.golf.unnamed", lang), farea: c("map.f.area", lang, { v: "{v}" }), fnew: c("map.f.new", lang, { v: "{v}", l: "{l}" }), ffr: c("map.f.fr", lang, { v: "{v}", b: "{b}" }),
  regions: Object.fromEntries(REGIONS.map((r) => [r, c(`map.r.${r}`, lang)])),
};
const links = {
  buy: pathFor(lang, ed, "buy"), talk: pathFor(lang, ed, "talk"), sim: `${pathFor(lang, ed, "sims")}${SUB.cost[lang]}/`, map: pathFor(lang, ed, "map"),
  journey: pathFor(lang, ed, "journey"), devHref: `${pathFor(lang, ed, "partners")}${PTYPES.find((t) => t.key === "developers")!.slug[lang]}/`, pages: [...pages],
};
const briefs = Object.fromEntries(Object.entries(BRIEFS[lang] ?? {}));
const cfg = { labels, links, quarter: qLabel, mortgage: { rate: PRICES.mortgage.rate, month }, photos: REGION_PHOTO, briefs,
  privateHref: config.privateLive && mode !== "embed" ? pathFor(lang, ed, "private") : "",
  projects: PROJECTS.map((p) => ({ ...p, units: undefined, gallery: undefined, sources: undefined, showcase: `${pathFor(lang, ed, "partners")}${p.devSlug}/${p.muni}/` })), routing: config.enquiryRouting, consult: mode === "embed" ? `https://imoveisportugal.lu${pathFor(lang, ed, "consult")}` : pathFor(lang, ed, "consult") };
const id = `mapx-${mode}`;
---
<div class={`mapx mapx-${mode}`} data-rates={mode === "embed" ? JSON.stringify(Object.fromEntries((["CHF", "USD", "BRL", "ILS"] as const).map((k) => [k, RATE(k).rate]))) : undefined} data-mapx data-lang={lang} data-locale={HTML_LANG[lang]} data-fx={fx ? fx.rate : ""} data-cur={cur ?? ""} data-mode={mode}>
  <div class="mapx-controls">
    {/* D52: one budget field, no presets and no tiers; any amount, in euros or the reader's currency. */}
    <label class="mapx-budget">
      <span class="h-small">{c("map.budget.label", lang)}</span>
      <span class="mapx-input"><input type="text" inputmode="numeric" value={nf.format(Math.round(300000 * (cur && fx ? fx.rate : 1)))} aria-label={c("map.budget.label", lang)} data-budget /><span aria-hidden="true" data-cur-sign>{cur && fx ? cur : "€"}</span></span>
    </label>
    {cur && fx && (
      <div class="mapx-cur" role="group" aria-label={c("map.currency", lang)}>
        <button type="button" data-cur-pick={cur} aria-pressed="true">{cur}</button><button type="button" data-cur-pick="EUR" aria-pressed="false">EUR</button>
      </div>
    )}
    {fx && <p class="small mapx-local" data-local-tpl={c("map.local", lang, { local: "{local}", date: fmtDate(lang, "2026-10-23") })}></p>}
  </div>
  <div class="mapx-bar">
    <div class="mapx-metrics" role="group" aria-label={c("map.metric.label", lang)}>
      <span class="h-small">{c("map.metric.label", lang)}</span>
      {METRICS.map((m, i) => <button type="button" data-metric={m} aria-pressed={i === 0 ? "true" : "false"}>{c(`map.metric.${m}`, lang)}</button>)}
      <select class="mapx-layer" data-layer aria-label={c("map.layer.label", lang)}>
        <option value="">{c("map.layer.label", lang)}</option>
        {LAYERS.map((m) => <option value={m}>{c(`map.metric.${m}`, lang)}</option>)}
      </select>
    </div>
    <div class="mapx-find">
      <label class="h-small" for={`${id}-find`}>{c("map.find", lang)}</label>
      <input id={`${id}-find`} type="search" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls={`${id}-list`} autocomplete="off" placeholder={c("map.find", lang)} data-find />
      <ul id={`${id}-list`} role="listbox" class="mapx-find-list" hidden data-find-list></ul>
    </div>
    <button type="button" class="mapx-flat" data-flat aria-pressed="false">{c("map.flat", lang)}</button>
    {mode === "home" && <button type="button" class="mapx-more" data-more aria-expanded="false">{c("home2.map.more", lang)}</button>}
    <button type="button" class="mapx-flat" data-devs aria-pressed="false">{c("map.devs.toggle", lang)}</button>
    {/* Prompt 33 §4.1: golf courses (OpenStreetMap), off until tapped; its own class so the home map shows it on phones too. */}
    {mode !== "embed" && <button type="button" class="mapx-golf" data-golf aria-pressed="false">{c("map.golf.toggle", lang)}</button>}
  </div>
  {/* Prompt 26 §1: filters of the "Novos empreendimentos" layer (partner projects only). */}
  <div class="mapx-devbar" data-devbar hidden>
    <select data-ptyp aria-label={c("map.devs.typ", lang)}><option value="">{c("map.devs.typ", lang)}</option>{["T0", "T1", "T2", "T3", "T4", "T5"].map((t) => <option value={t}>{t}</option>)}</select>
    <label class="mapx-pmax"><span class="small">{c("map.devs.max", lang)}</span><input type="text" inputmode="numeric" data-pmax /></label>
    <select data-pdel aria-label={c("map.devs.del", lang)}><option value="">{c("map.devs.del", lang)}</option>{["2026", "2027", "2028", "2029", "2030"].map((y) => <option value={`${y}-12`}>{y}</option>)}</select>
    <p class="small" data-pnone hidden>{c("map.devs.none", lang)} <a href={links.devHref}>{c("dev.join", lang)}</a></p>
  </div>

  <div class="mapx-stage">
    <img class="mapx-poster" src="/img/map-poster-1200.webp" srcset="/img/map-poster-640.webp 640w, /img/map-poster-1200.webp 1200w" sizes="(min-width: 900px) 900px, 100vw" width="1200" height="900" alt={c("map.legend.m2", lang, { quarter: qLabel })} loading={mode === "home" ? "lazy" : "eager"} />
    <div class="mapx-canvas" data-canvas></div>
    <span class="mapx-inset" data-inset="madeira">{c("map.r.madeira", lang)}</span>
    <span class="mapx-inset" data-inset="azores">{c("map.r.azores", lang)}</span>
    <span class="mapx-tip" data-tip hidden></span>
    <span class="mapx-flash" data-flash role="status" hidden></span>
    <aside class="mapx-card" data-card hidden aria-live="polite"></aside>
  </div>
  <p class="small mapx-legend" data-legend>{c("map.legend.m2", lang, { quarter: qLabel })} {c("map.hint", lang)}</p>
  {mode !== "embed" && <p class="small mapx-legend">{c("map.par.hint", lang)}</p>}
  {mode !== "embed" && <p class="small mapx-legend" data-golf-legend hidden>{c("map.golf.legend", lang)}</p>}

  {mode === "page" && (
    <div class="mapx-filters" role="group" aria-label={c("map.filters", lang)}>
      <button type="button" data-filter="all" aria-pressed="true">{c("map.f.all", lang)}</button>
      <button type="button" data-filter="coast" aria-pressed="false">{c("map.f.coast", lang)}</button>
      <button type="button" data-filter="inland" aria-pressed="false">{c("map.f.inland", lang)}</button>
      <button type="button" data-filter="city" aria-pressed="false">{c("map.f.city", lang)}</button>
      <button type="button" data-filter="country" aria-pressed="false">{c("map.f.country", lang)}</button>
      <button type="button" data-filter="air" aria-pressed="false">{c("map.f.air", lang)}</button>
      <select data-region aria-label={c("map.filters", lang)}>
        <option value="">{c("map.f.all", lang)}</option>
        {REGIONS.map((r) => <option value={r}>{c(`map.r.${r}`, lang)}</option>)}
      </select>
    </div>
  )}

  {mode === "page" && (
    <details class="region mapx-list">
      <summary><h2 class="h3">{c("map.list", lang)}</h2></summary>
      <label class="field" style="margin:8px 0 12px"><span class="h-small">{c("map.search", lang)}</span><input type="search" data-search /></label>
      <table class="cmp">
        <thead><tr><th scope="col">{c("data.col.place", lang)}</th><th scope="col">{c("map.col.m2", lang)}</th><th scope="col">{c("map.col.buys", lang)}</th></tr></thead>
        <tbody>{MAP_MUNIS.map((m) => (
          <tr data-v={m.v ?? ""}><th><button data-pick={m.s}>{m.n}</button> <small>{c(`map.r.${m.r}`, lang)}</small>{pages.has(m.s) && <> <a href={`${links.map}${m.s}/`}>{c("map.a.page", lang)}</a></>}</th><td>{m.v ? eur(m.v, lang) : "—"}</td><td>{m.v ? `${nf.format(Math.round(300000 / m.v))} m²` : "—"}</td></tr>
        ))}</tbody>
      </table>
    </details>
  )}
  {mode === "embed" && (
    <p class="mapx-powered"><a href="https://imoveisportugal.lu/" target="_blank" rel="noopener">Powered by Imóveis Portugal</a><span>Fonte: INE · © OpenStreetMap contributors</span></p>
  )}
  <script type="application/json" data-mapx-labels set:html={JSON.stringify(cfg)} />
</div>

<script>
  // The map's code is fetched once the page is idle, so it never competes with the first paint (Lighthouse mobile 95+).
  const run = () => import("../scripts/map-explorer").then(({ initMapExplorer }) => document.querySelectorAll<HTMLElement>("[data-mapx]").forEach((el) => initMapExplorer(el)));
  "requestIdleCallback" in window ? requestIdleCallback(run, { timeout: 1200 }) : setTimeout(run, 300);
</script>
