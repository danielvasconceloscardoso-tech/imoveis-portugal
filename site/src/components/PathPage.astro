---
// "Passo a passo" (formerly "Passo a passo", D61) as a path (prompt 27 §3, D51, D52). A start screen with two doors (buy, sell) and three quick
// answers (country, budget or value, timing; "inherited" for selling), then a route of stations on one line. Each
// station opens as a card: what happens, what you need (a checklist), what people ask (answered from facts.csv), the
// numbers for the reader's case, the partner for the step and "Próximo passo". Progress stays on the device.
// Without JavaScript the page is two plain ordered lists with everything open. Wording: COPY_DECK.md "path.*".
import V2 from "../layouts/V2.astro";
import CountryBar from "./CountryBar.astro";
import "../styles/path2.css";
import { pathFor, HTML_LANG, type Lang, type EdCode } from "../i18n";
import { Sources, fmtDate, faqFor, RATE, EDITION_CUR } from "../lib/content";
import { stationsFor, faqPlace, type Door } from "../lib/path";
import { teamSoFar } from "../lib/team";
import { SUB } from "../lib/tools";
import { c, cl, edName } from "../lib/copy";

interface Props { lang: Lang; ed: EdCode; }
const { lang, ed } = Astro.props;
const src = new Sources();
const where = c(`home.where.${ed}`, lang);
const vars = { where, from: c(`journey.from.${ed}`, lang) };
const faq = pathFor(lang, ed, "faq"), sims = pathFor(lang, ed, "sims"), talk = pathFor(lang, ed, "talk");
const faqItems = faqFor(ed, lang);
const btn: Record<string, string> = { lawyer: "home.btn.lawyer", bank: "home.btn.bank", tax: "home.btn.tax", fx: "journey.role.fx" };
const sup = (ns: number[]) => ns.map((i) => `<a class="sup" href="#fonte-${i}">${i}</a>`).join("");
// Which calculator field takes the reader's figure.
const FIELD: Record<string, string> = { cost: "price", payment: "price", rent: "price", gains: "sale" };
const DOORS: Door[] = ["buy", "sell"];
const routes = DOORS.map((door) => ({
  door,
  st: stationsFor(door, ed).map((s) => ({
    ...s,
    h: c(`path.st.${s.k}.h`, lang),
    what: c(`path.st.${s.k}.what`, lang),
    need: cl(`path.st.${s.k}.need`, lang),
    qs: s.qs.map((q) => ({ ...q, n: [...new Set(q.facts.map((f) => src.n(f)))] })),
    more: faqItems.filter((it) => faqPlace(it.id)?.station === s.k),
    cta: s.cta === "agency" ? { href: pathFor(lang, ed, "consult"), label: c("consult.cta", lang) }
      : s.cta === "sell" ? { href: pathFor(lang, ed, "consult"), label: c("path.sell.cta", lang) }
      : { href: `${talk}?cat=${s.cat}#form`, label: c(btn[s.cat!] ?? "common.nav.talk", lang) },
    tool: s.tool ? { href: `${sims}${SUB[s.tool][lang]}/`, field: FIELD[s.tool] ?? "" } : null,
  })),
}));
// Prompt 28 §2b: at every station, the team so far (each role once), this step's roles marked.
const teams = Object.fromEntries(routes.map((r) => [r.door, teamSoFar(r.st)])) as Record<Door, ReturnType<typeof teamSoFar>>;
const cur = EDITION_CUR[ed];
const rate = cur ? RATE(cur).rate : 0;
---
<V2 lang={lang} ed={ed} page="journey" title={`${c("path.h1", lang)} · ${edName(ed, lang)} | Imóveis Portugal`} description={c("path.lede", lang, vars)} sticky={null}>
  <div class="path" data-path data-map={pathFor(lang, ed, "map")} data-consult={pathFor(lang, ed, "consult")} data-locale={HTML_LANG[lang]} data-cur={cur ?? ""} data-rate={rate}
    data-progress={c("path.progress", lang)} data-local={c("path.local", lang)} data-copied={c("path.copied", lang)} data-here={c("path.here", lang)} data-done={c("path.done", lang)} data-door="buy">
    {/* Before first paint: the answers already given (link or device) set the layout, so nothing moves when the script loads. */}
    <script is:inline>(function(){var r=document.currentScript.parentElement;r.classList.add("is-js");try{var s=JSON.parse(localStorage.getItem("ip.path")||"{}"),q=new URLSearchParams(location.search),d=q.get("door");if(d==="buy"||d==="sell"){s.door=d;s.started=true}var b=Number(q.get("budget"))||s.budget||Number(localStorage.getItem("ip.budget"))||0;if(q.get("inh"))s.inh=q.get("inh")==="1";r.dataset.door=s.door==="sell"?"sell":"buy";r.classList.toggle("started",!!s.started);r.classList.toggle("high",b>=1e6);r.classList.toggle("inh",!!s.inh)}catch(e){}})();</script>
    <div class="frame read ph">
      <p class="h-small">{c("path.h1", lang)} · {edName(ed, lang)}</p>
      <h1>{c("journey.h1", lang, vars)}</h1>
      <p class="lede">{c("path.lede", lang, vars)}</p>
    </div>

    <form class="frame read pstart" data-start>
      {/* Prompt 35 §3.1: with JavaScript, one question per screen that advances by itself; without it, everything at once. */}
      <div class="pq-head" aria-hidden="true"><button type="button" class="pq-back" data-pq-back tabindex="-1"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></button><span class="pq-prog"><span data-pq-prog></span></span></div>
      <div class="pq" data-q="1">
        <h2 class="pq-h">{c("pathx.door", lang)}</h2>
        <div class="pdoors">
          {DOORS.map((d) => (
            <button type="button" class="pdoor" data-door={d} aria-pressed={d === "buy" ? "true" : "false"}>
              <span class="pd-h">{c(`path.door.${d}`, lang)}</span>
              <span class="pd-p">{c(`path.door.${d}.p`, lang)}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="pchoices">
        <div class="pq" data-q="2">
          <h2 class="pq-h">{c("pathx.country", lang)}</h2>
          <CountryBar lang={lang} ed={ed} href={(x) => pathFor(lang, x, "journey")} />
          <button type="button" class="pq-next" data-pq-next>{c("flow.next", lang)}</button>
        </div>
        <div class="pq" data-q="3">
          <h2 class="pq-h">{c("pathx.budget", lang)}</h2>
          <label class="pfield">
            <span data-for="buy">{c("path.q.budget", lang)}</span><span data-for="sell">{c("path.q.value", lang)}</span>
            <input type="text" inputmode="numeric" autocomplete="off" data-budget placeholder="300 000" />
            <span class="small" data-local-out aria-live="polite"></span>
          </label>
          <div class="pq-chips">{[300000, 500000, 1000000, 2000000].map((v) => <button type="button" class="pq-chip" data-chip={v}>{new Intl.NumberFormat(HTML_LANG[lang], { notation: "compact", maximumFractionDigits: 1 }).format(v)} €</button>)}</div>
          <label class="pcheck" data-for="sell"><input type="checkbox" data-inherited /> {c("path.q.inherited", lang)}</label>
          <button type="button" class="pq-next" data-pq-next>{c("flow.next", lang)}</button>
        </div>
        <div class="pq" data-q="4">
          <h2 class="pq-h">{c("pathx.when", lang)}</h2>
          <fieldset class="pwhen">
            <legend>{c("path.q.timing", lang)}</legend>
            {["soon", "year", "later"].map((t) => <label><input type="radio" name="when" value={t} checked={t === "year"} /> <span>{c(`path.t.${t}`, lang)}</span></label>)}
          </fieldset>
          <button class="btn" type="submit">{c("path.start", lang)}</button>
        </div>
      </div>
    </form>

    <div class="frame read pbar" data-bar>
      <p><b data-sum></b> · <button type="button" class="linkish" data-change>{c("path.change", lang)}</button></p>
      <div class="pprog" role="progressbar" aria-valuemin="0" data-prog><span></span></div>
      <p class="small" data-prog-t></p>
    </div>

    {routes.map((r) => (
      <section class="frame read proute" data-route={r.door} aria-labelledby={`r-${r.door}`}>
        <h2 id={`r-${r.door}`} class="h-small">{c(`path.door.${r.door}`, lang)}</h2>
        <div class="pwrap">
          <svg class="pline-svg" aria-hidden="true"><path class="pl-base" /><path class="pl-fill" /></svg>
          <ol class="pline">
            {r.st.map((s, si) => (
              <li class="pst" id={`s-${s.k}`} data-k={s.k} {...(s.high ? { "data-high": "" } : {})} {...(s.inherit ? { "data-inherit": "" } : {})}>
                <span class="pdot" aria-hidden="true"></span>
                <h3><button type="button" class="pst-head" aria-expanded="true" aria-controls={`b-${s.k}`}>
                  <span class="pnum" aria-hidden="true"></span><span class="ph3">{s.h}</span><span class="pstate" data-state></span>
                </button></h3>
                <div class="pst-body" id={`b-${s.k}`}><div class="pin">
                  <p class="pwhat">{s.what}</p>
                  <h4 class="h-small">{c("path.need", lang)}</h4>
                  <ul class="pneed">{s.need.map((t, i) => <li><label><input type="checkbox" data-tick={`${s.k}.${i + 1}`} /> <span>{t}</span></label></li>)}</ul>
                  {s.qs.length > 0 && <h4 class="h-small">{c("path.asks", lang)}</h4>}
                  {s.qs.map((q) => (
                    <details class="pqa">
                      <summary>{c(q.ck ? `${q.ck}.q` : `journey.q.${q.id}.q`, lang, vars)}</summary>
                      <p>{c(q.ck ? `${q.ck}.a` : `journey.q.${q.a ?? q.id}.a`, lang, vars)}<Fragment set:html={sup(q.n)} /></p>
                      {q.ask && <p class="small">{c("journey.unverified", lang)}</p>}
                    </details>
                  ))}
                  {s.more.length > 0 && <p class="small pmore">{c("path.more", lang)}: {s.more.map((it, i) => <>{i > 0 && " · "}<a href={`${faq}#${it.id}`}>{it.q}</a></>)}</p>}
                  {(s.map || s.tool) && <h4 class="h-small">{c("path.numbers", lang)}</h4>}
                  {(s.map || s.tool) && <p class="pnums">
                    {s.map && <a class="act quiet" data-num="map" href={pathFor(lang, ed, "map")}>{c(r.door === "sell" ? "path.numbers.mapsell" : "path.numbers.map", lang)}</a>}
                    {s.tool && <a class="act quiet" data-num={s.tool.field} href={s.tool.href}>{c("path.numbers.tool", lang)}</a>}
                  </p>}
                  <aside class="pteam" aria-label={c(r.door === "sell" ? "team.h.sell" : "team.h", lang)}>
                    <p class="h-small">{c(r.door === "sell" ? "team.h.sell" : "team.h", lang)}</p>
                    <p class="small">{c("team.p", lang)}</p>
                    <ol class="tm">
                      {teams[r.door][si].map((t, ti) => (
                        <li class="tm-row" data-sts={t.sts.join(" ")} {...(t.now ? { "data-now": "" } : {})} style={`--d:${ti}`}>
                          <div class="tm-h"><span class="tm-role">{c(`journey.role.${t.role}`, lang)}</span>{t.partner && <span class="tm-name">{t.partner.name}<span class="tag">{c("common.sponsored", lang)}</span></span>}{t.now && <span class="tm-now">{c("team.now", lang)}</span>}</div>
                          <div class="tm-do">{c(`team.do.${t.role}`, lang)}{t.partner?.reg && <span class="small"> · {t.partner.reg}</span>}</div>
                          {t.partner && <label class="tm-ok"><input type="checkbox" data-team={t.role} data-name={t.partner.name} /> {c("team.consent", lang, { name: t.partner.name })}</label>}
                        </li>
                      ))}
                    </ol>
                    {teams[r.door][si].some((t) => !t.partner) && <p class="small">{c("team.wait", lang)}</p>}
                    <p class="tm-acts"><a class="btn sm" data-team-send href={`${talk}#form`} aria-disabled="true">{c("team.send", lang)}</a> <a class="act" data-cta={s.cta} href={s.cta.href}>{s.cta.label}</a></p>
                  </aside>
                  <p class="pnext"><button type="button" class="btn" data-next hidden>{c("path.next", lang)}</button></p>
                </div></div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    ))}

    <section class="frame read pend" data-end aria-labelledby="pend-h">
      <h2 id="pend-h">{c("path.end.h", lang)}</h2>
      <p><button type="button" class="btn ghost" data-share>{c("path.share", lang)}</button> <span class="small" data-share-out role="status"></span></p>
      <p><a class="act" href={`${pathFor(lang, ed, "home")}#subscrever`}>{c("path.email", lang)}</a></p>
      <p class="small">{c("path.email.p", lang)} {c("path.saved", lang)}</p>
      <p><a class="more" href={faq}>{c("path.faq", lang)}</a></p>
    </section>
  </div>

  <section class="sources-list" aria-labelledby="fontes">
    <div class="frame read">
      <h2 id="fontes" class="h-small">{c("common.sources", lang)}</h2>
      <ol>{src.list.map((s, i) => <li id={`fonte-${i + 1}`}><a href={s.url} rel="noopener">{s.title}</a>{s.checked && `, ${c("common.checked", lang, { date: fmtDate(lang, s.checked) })}`}.</li>)}</ol>
    </div>
  </section>
</V2>

<script>
  // D52: from this budget the route adds its quiet stations; the figure is internal and never shown.
  const HIGH = 1e6;
  const root = document.querySelector<HTMLElement>("[data-path]")!;
  const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => el.querySelector<T>(s);
  const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = root) => [...el.querySelectorAll<T>(s)];
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const nf = new Intl.NumberFormat(root.dataset.locale);
  const num = (v: string) => Number(v.replace(/[^\d]/g, "")) || 0;
  type St = { door: "buy" | "sell"; budget: number; inh: boolean; when: string; step: Record<string, string>; done: string[]; ticks: string[]; started: boolean };
  let st: St = { door: "buy", budget: 0, inh: false, when: "year", step: {}, done: [], ticks: [], started: false };
  try { st = { ...st, ...JSON.parse(localStorage.getItem("ip.path") || "{}") }; } catch { /* storage off */ }
  try { if (!st.budget) st.budget = Number(localStorage.getItem("ip.budget")) || 0; } catch { /* storage off */ }
  const q = new URLSearchParams(location.search);
  if (q.get("door") === "buy" || q.get("door") === "sell") { st.door = q.get("door") as St["door"]; st.started = true; }
  if (Number(q.get("budget"))) st.budget = Number(q.get("budget"));
  if (q.get("inh")) st.inh = q.get("inh") === "1";
  if (q.get("when")) st.when = q.get("when")!;
  if (q.get("step")) st.step[st.door] = q.get("step")!;
  const save = () => {
    try { localStorage.setItem("ip.path", JSON.stringify(st)); if (st.budget) localStorage.setItem("ip.budget", String(st.budget)); } catch { /* storage off */ }
  };

  const start = $<HTMLFormElement>("[data-start]")!;
  const input = $<HTMLInputElement>("[data-budget]")!, inh = $<HTMLInputElement>("[data-inherited]")!;
  root.style.setProperty("--hd", `${document.querySelector<HTMLElement>(".hd")?.offsetHeight ?? 0}px`);

  // Start screen
  const showDoor = () => {
    root.dataset.door = st.door;
    $$("button[data-door]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.door === st.door)));
  };
  const localOut = $("[data-local-out]")!;
  const showLocal = () => {
    const r = Number(root.dataset.rate), cur = root.dataset.cur, b = num(input.value);
    localOut.textContent = r && cur && b ? root.dataset.local!.replace("{v}", new Intl.NumberFormat(root.dataset.locale, { style: "currency", currency: cur, maximumFractionDigits: 0 }).format(Math.round(b * r / 1000) * 1000)) : "";
  };
  $$("button[data-door]").forEach((b) => b.addEventListener("click", () => { st.door = b.dataset.door as St["door"]; render(); }));
  input.value = st.budget ? nf.format(st.budget) : "";
  input.addEventListener("input", () => { read(); render(); });
  input.addEventListener("blur", () => { const b = num(input.value); input.value = b ? nf.format(b) : ""; });
  inh.checked = st.inh;
  inh.addEventListener("change", () => { read(); render(); });
  const wr = $<HTMLInputElement>(`input[name="when"][value="${st.when}"]`); if (wr) wr.checked = true;
  // The country bar keeps the answers when the reader changes edition.
  $$<HTMLAnchorElement>(".cbar a", start).forEach((a) => a.addEventListener("click", () => { read(); save(); }));
  const read = () => {
    st.budget = num(input.value); st.inh = inh.checked;
    st.when = $<HTMLInputElement>('input[name="when"]:checked')?.value || "year";
  };
  start.addEventListener("submit", (e) => { e.preventDefault(); read(); st.started = true; save(); render(true); });
  // One question per screen (prompt 35 §3.1): doors and timing advance by themselves; country and amount by "Continue".
  {
    const qs = $$<HTMLElement>(".pq", start), prog = $("[data-pq-prog]", start)!, backB = $<HTMLButtonElement>("[data-pq-back]", start)!;
    let qi = 0;
    const showQ = (n: number, focus = true) => {
      qi = Math.max(0, Math.min(n, qs.length - 1));
      qs.forEach((q, k) => q.classList.toggle("on", k === qi));
      prog.style.width = `${((qi + 1) / qs.length) * 100}%`; backB.style.visibility = qi ? "visible" : "hidden"; backB.tabIndex = qi ? 0 : -1;
      if (focus) $(".pq-h", qs[qi])?.focus({ preventScroll: true });
    };
    start.classList.add("stepped");
    qs.forEach((q) => $(".pq-h", q)?.setAttribute("tabindex", "-1"));
    $$("button[data-door]", start).forEach((b) => b.addEventListener("click", () => setTimeout(() => showQ(1), reduce ? 0 : 220)));
    $$("[data-pq-next]", start).forEach((b) => b.addEventListener("click", () => showQ(qi + 1)));
    $$<HTMLButtonElement>("[data-chip]", start).forEach((b) => b.addEventListener("click", () => { input.value = nf.format(Number(b.dataset.chip)); read(); render(); setTimeout(() => showQ(3), reduce ? 0 : 220); }));
    $$<HTMLInputElement>('input[name="when"]', start).forEach((r) => r.addEventListener("change", () => setTimeout(() => start.requestSubmit(), reduce ? 0 : 260)));
    input.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); showQ(3); } });
    backB.addEventListener("click", () => showQ(qi - 1));
    $("[data-change]")!.addEventListener("click", () => showQ(0, false));
    // Choosing another country opens that edition's path: it continues at the amount.
    $$<HTMLAnchorElement>(".cbar a", start).forEach((a) => a.addEventListener("click", () => { const u = new URL(a.href); u.searchParams.set("pq", "3"); a.href = u.href; }));
    const pq = Number(new URLSearchParams(location.search).get("pq"));
    showQ(pq >= 1 && pq <= qs.length ? pq - 1 : 0, false);
  }
  $("[data-change]")!.addEventListener("click", () => { st.started = false; save(); render(); start.scrollIntoView({ behavior: reduce ? "auto" : "smooth" }); });

  // The route
  const shown = (li: HTMLElement) => (li.dataset.high === undefined || st.budget >= HIGH) && (li.dataset.inherit === undefined || st.inh);
  const visible = () => $$(`[data-route="${st.door}"] .pst`).filter(shown);
  const setOpen = (li: HTMLElement, open: boolean) => { li.classList.toggle("open", open); $("button.pst-head", li)!.setAttribute("aria-expanded", String(open)); };
  function render(scroll = false) {
    showDoor(); showLocal();
    root.classList.toggle("started", st.started); root.classList.toggle("high", st.budget >= HIGH); root.classList.toggle("inh", st.inh);
    if (!st.started) { $$(".pst").forEach((li) => { setOpen(li, false); li.classList.remove("here", "done"); li.removeAttribute("aria-current"); $("[data-state]", li)!.textContent = ""; }); drawAll(); return; }
    const list = visible();
    if (!list.some((li) => li.dataset.k === st.step[st.door])) st.step[st.door] = list.find((li) => !st.done.includes(li.dataset.k!))?.dataset.k ?? list[0].dataset.k!;
    const here = st.step[st.door];
    list.forEach((li, i) => {
      const k = li.dataset.k!, isHere = k === here, done = st.done.includes(k);
      li.classList.toggle("here", isHere); li.classList.toggle("done", done);
      if (isHere) li.setAttribute("aria-current", "step"); else li.removeAttribute("aria-current");
      $("[data-state]", li)!.textContent = isHere ? root.dataset.here! : done ? root.dataset.done! : "";
      $("[data-next]", li)!.hidden = i === list.length - 1;
      $$<HTMLInputElement>("[data-tick]", li).forEach((t) => (t.checked = st.ticks.includes(t.dataset.tick!)));
    });
    list.forEach((li) => setOpen(li, li.dataset.k === here));
    const n = list.filter((li) => st.done.includes(li.dataset.k!)).length;
    const prog = $("[data-prog]")!;
    prog.setAttribute("aria-valuemax", String(list.length)); prog.setAttribute("aria-valuenow", String(n));
    (prog.firstElementChild as HTMLElement).style.width = `${(100 * n) / list.length}%`;
    $("[data-prog-t]")!.textContent = root.dataset.progress!.replace("{n}", String(n)).replace("{t}", String(list.length));
    const door = $(`button[data-door="${st.door}"] .pd-h`)!.textContent;
    $("[data-sum]")!.textContent = [door, st.budget ? `${nf.format(st.budget)} €` : ""].filter(Boolean).join(" · ");
    links(); teamRender();
    drawAll();
    if (scroll) $(`#s-${here}`)?.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
  }
  // Team panel: a role shows while one of the stations that brings it in is on the route; consent boxes for the same
  // partner stay in step across stations; the send link names only the partners the reader ticked.
  const team = new Set<string>();
  function teamRender() {
    const on = new Set(visible().map((li) => li.dataset.k!));
    $$(".tm-row").forEach((row) => { row.hidden = !row.dataset.sts!.split(" ").some((k) => on.has(k)); });
    $$<HTMLInputElement>("[data-team]").forEach((x) => (x.checked = team.has(x.dataset.name!)));
    const names = [...team], roles = [...new Set($$<HTMLInputElement>("[data-team]:checked").map((x) => x.dataset.team!))];
    $$<HTMLAnchorElement>("[data-team-send]").forEach((a) => {
      a.setAttribute("aria-disabled", String(!names.length));
      const onlyAgency = roles.length === 1 && roles[0] === "agency";
      const u = new URL(onlyAgency ? root.dataset.consult! : a.href, location.href);
      u.search = ""; u.hash = onlyAgency ? "" : "form";
      if (names.length) u.searchParams.set("team", names.join(", "));
      const cat = roles.find((r) => r !== "agency"); if (cat && !onlyAgency) u.searchParams.set("cat", cat);
      if (st.budget) u.searchParams.set("budget", String(st.budget));
      a.href = u.pathname + u.search + u.hash;
    });
  }
  $$<HTMLInputElement>("[data-team]").forEach((x) => x.addEventListener("change", () => { x.checked ? team.add(x.dataset.name!) : team.delete(x.dataset.name!); teamRender(); }));

  // The reader's figure goes into the map and the calculators; a high budget gets the personal consultation tone.
  function links() {
    const b = st.budget;
    $$<HTMLAnchorElement>("[data-num]").forEach((a) => {
      const u = new URL(a.href, location.href), k = a.dataset.num!;
