  new ResizeObserver(drawAll).observe(root);

  // Share: door, budget, timing and step only; no personal data.
  $("[data-share]")!.addEventListener("click", async () => {
    const p = new URLSearchParams({ door: st.door, step: st.step[st.door] || "", when: st.when });
    if (st.budget) p.set("budget", String(st.budget));
    if (st.door === "sell" && st.inh) p.set("inh", "1");
    const url = `${location.origin}${location.pathname}?${p}`;
    try {
      if (navigator.share) await navigator.share({ url, title: document.title });
      else { await navigator.clipboard.writeText(url); $("[data-share-out]")!.textContent = root.dataset.copied!; }
    } catch { /* cancelled */ }
  });

  // A superscript opens the folded sources and shows its line.
  const srcs = document.querySelector<HTMLDetailsElement>("[data-srcs]");
  const openSrc = () => { const t = location.hash.startsWith("#fonte-") && srcs ? document.getElementById(location.hash.slice(1)) : null; if (t && srcs) { srcs.open = true; t.scrollIntoView({ block: "center" }); } };
  document.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest?.("a.sup") && srcs) srcs.open = true; });
  addEventListener("hashchange", openSrc); openSrc();

  render(st.started && !!q.get("step"));
</script>

