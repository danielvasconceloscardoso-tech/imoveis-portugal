    const d = (p: [number, number][]) => p.map(([x, y], i) => i === 0 ? `M${x} ${y}` : (() => { const [px, py] = p[i - 1], my = (py + y) / 2; return `C${px} ${my} ${x} ${my} ${x} ${y}`; })()).join(" ");
    $<SVGPathElement>(".pl-base", svg)!.setAttribute("d", d(pts));
    const here = list.findIndex((li) => li.classList.contains("here"));
    const fill = $<SVGPathElement>(".pl-fill", svg)!;
