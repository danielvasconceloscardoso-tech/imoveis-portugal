---
// Renders a Tally form (by ID) or a full embed URL (e.g. beehiiv). Falls back to a
// plain message while the form is not configured, so no page ever shows a broken form.
import { config } from "../config";
interface Props { id: string; title: string; pending: string; hidden?: Record<string, string>; height?: number; }
const { id, title, pending, hidden = {}, height = 420 } = Astro.props;
const qs = new URLSearchParams({ hideTitle: "1", transparentBackground: "1", dynamicHeight: "1", ...hidden }).toString();
const src = !id ? "" : id.startsWith("http") ? id : `https://tally.so/embed/${id}?${qs}`;
---
<div class="form-box">
  {src
    ? <iframe src={src} title={title} loading="lazy" style={`min-height:${height}px`}></iframe>
    : <p class="form-pending">{pending}</p>}
</div>
