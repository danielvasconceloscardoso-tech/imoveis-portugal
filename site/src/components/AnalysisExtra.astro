---
// The figure sets the free pages gave away before the operator's fix round of 3 Nov 2026 (step 3), now only in the paid
// analysis (MapAnalysisPage.astro, built only when config.mapAnalysis.live is true or in a preview build): ten years of
// prices for the region with Portugal and its first city, every municipality's price at the start and the end of the ten
// years with the change since 2016 and over one year (the prices page and "Portugal house prices over ten years"), the
// regions side by side with rents and gross yield (the prices page), and the golf parishes against their municipality
// ("Golf property prices in Portugal"). Separate from MapAnalysisPage so the map's own files stay as they are.
// Data: prices.json (INE), content/data/golf-premium.json, map/tiles.json. Wording: COPY_DECK.md "prices.*", "art.golf.*",
// "fix35.an.*".
import { HTML_LANG, type Lang } from "../i18n";
import { c } from "../lib/copy";
import { PRICES, LAST } from "../lib/prices";
import { lineChart, change } from "../lib/chart";
import { GOLF } from "../lib/articles";
import { TILES, type AKey } from "../lib/maptiles";

interface Props { lang: Lang; akey: AKey; }
const { lang, akey } = Astro.props;
const nf = new Intl.NumberFormat(HTML_LANG[lang]), nf1 = new Intl.NumberFormat(HTML_LANG[lang], { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const nf2 = new Intl.NumberFormat(HTML_LANG[lang], { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const Q = PRICES.quarters, ql = (q: string) => c("map.qfmt", lang).replace("{q}", q.slice(-1)).replace("{y}", q.slice(0, 4));
const eurM2 = (v?: number | null) => (v ? `${nf.format(v)} €` : "—");
const pct = (v: number | null) => (v == null ? "—" : `${v > 0 ? "+" : v < 0 ? "−" : ""}${nf.format(Math.abs(Math.round(v)))} %`);
const inRegion = (slug: string) => akey === "portugal" || TILES.m[slug]?.r === akey;
const PT = PRICES.regions.PT;

// Ten years: Portugal with Lisbon and Porto, or the region with Portugal and the region's first city.
const bySlugName = (name: string) => Object.entries(PRICES.munis).find(([, m]) => m.n === name)?.[0];
const lines = akey === "portugal"
  ? [{ label: "Portugal", values: PT.m2 }, { label: PRICES.munis.lisboa.n, values: PRICES.munis.lisboa.m2 }, { label: PRICES.munis.porto.n, values: PRICES.munis.porto.m2 }]
  : (() => {
      const rg = TILES.rg[akey], reg = rg ? (PRICES.regions as Record<string, typeof PT>)[rg.c2] : undefined, city = rg ? bySlugName(rg.cities[0]) : undefined;
      return [...(reg ? [{ label: reg.n, values: reg.m2 }] : []), { label: "Portugal", values: PT.m2 }, ...(city ? [{ label: PRICES.munis[city].n, values: PRICES.munis[city].m2 }] : [])];
    })();
const chart = lineChart(Q, lines, { breakAt: PRICES.break, breakLabel: c("prices.break", lang), fmt: (v) => nf.format(v), h: 280 });

// Every municipality: the first quarter with a price, today, since then and over one year.
// Portugal (and the region) first, in bold; each row with its ten years drawn quarter by quarter as a small line.
const row = (n: string, m2: (number | null)[], lead = false) => { const i0 = m2.findIndex((v) => v != null); return { n, lead, q0: Q[i0], a: m2[i0], b: m2[LAST], ten: change(m2), one: change(m2, 4), m2 }; };
const rg = akey === "portugal" ? undefined : TILES.rg[akey], regS = rg ? (PRICES.regions as Record<string, typeof PT>)[rg.c2] : undefined;
const rows = [row("Portugal", PT.m2, true), ...(regS ? [row(regS.n, regS.m2, true)] : []),
  ...Object.entries(PRICES.munis).filter(([s, m]) => inRegion(s) && m.m2[LAST]).map(([, m]) => row(m.n, m.m2)).sort((x, y) => (y.b ?? 0) - (x.b ?? 0))];
const spark = (v: (number | null)[]) => {
  const xs = v.filter((x): x is number => x != null), lo = Math.min(...xs), hi = Math.max(...xs); let d = "", pen = false;
  v.forEach((x, i) => { if (x == null) pen = false; else { d += `${pen ? "L" : "M"}${((i / (v.length - 1)) * 80).toFixed(1)},${(19 - ((x - lo) / (hi - lo || 1)) * 18).toFixed(1)}`; pen = true; } });
  return `<svg viewBox="0 0 80 20" width="80" height="20" aria-hidden="true"><path d="${d}" fill="none" stroke="#2f5d50" stroke-width="1.4"/></svg>`;
};
const regions = Object.entries(PRICES.regions);

// The golf parishes of this region (all of them for Portugal), from the highest ratio to the lowest.
const golf = GOLF.parishes.filter((p) => p.full_course && p.ratio !== null && p.parish_median_eur_m2 && p.municipality_median_eur_m2 && inRegion(p.municipality_slug))
  .sort((a, b) => b.ratio! - a.ratio!);
---
<div class="anx">
<h2>{c("fix35.an.ten", lang)}</h2>
<figure class="pc-chart" set:html={chart} />
<p class="small">{c("prices.method", lang)}</p>
<div class="an4-sc"><table><thead><tr><th>{c("map4.a.col.place", lang)}</th><th>{c("prices.col.m2", lang)}, {ql(Q[0])}</th><th>{c("prices.col.m2", lang)}, {ql(Q[LAST])}</th><th>{c("prices.col.10y", lang)}</th><th>{c("prices.col.1y", lang)}</th><th></th></tr></thead>
  <tbody>{rows.map((r) => <tr class={r.lead ? "anx-lead" : undefined}><td>{r.n}{r.q0 !== Q[0] && <small> ({ql(r.q0)})</small>}</td><td>{eurM2(r.a)}</td><td>{eurM2(r.b)}</td><td>{pct(r.ten)}</td><td>{pct(r.one)}</td><td set:html={spark(r.m2)} /></tr>)}</tbody></table></div>

<h2>{c("prices.regions.h", lang)}</h2>
<div class="an4-sc"><table><thead><tr><th>{c("prices.col.place", lang)}</th><th>{c("prices.col.m2", lang)}</th><th>{c("prices.col.10y", lang)}</th><th>{c("prices.col.1y", lang)}</th><th>{c("prices.col.rent", lang)}</th><th>{c("prices.col.yield", lang)}</th></tr></thead>
  <tbody>{regions.map(([, p]) => <tr><td>{p.n}</td><td>{eurM2(p.m2[LAST])}</td><td>{pct(change(p.m2))}</td><td>{pct(change(p.m2, 4))}</td><td>{p.rq[LAST] ? `${nf2.format(p.rq[LAST]!)} €` : "—"}</td><td>{p.yield ? `${nf1.format(p.yield)} %` : "—"}</td></tr>)}</tbody></table></div>
<p class="small">{c("prices.yield.note", lang)}</p>

{golf.length > 0 && (
  <>
    <h2>{c("fix35.an.golf", lang)}</h2>
    <p class="small">{c("art.golf.label", lang)}</p>
    <div class="an4-sc"><table><thead><tr><th>{c("art.golf.col.parish", lang)}</th><th>{c("art.golf.col.muni", lang)}</th><th>{c("art.golf.col.pm", lang)}</th><th>{c("art.golf.col.mm", lang)}</th><th>{c("art.golf.col.ratio", lang)}</th></tr></thead>
      <tbody>{golf.map((p) => <tr><td>{p.parish}</td><td>{p.municipality}</td><td>{eurM2(p.parish_median_eur_m2)}</td><td>{eurM2(p.municipality_median_eur_m2)}</td><td>{nf2.format(p.ratio!)}</td></tr>)}</tbody></table></div>
  </>
)}
</div>

<style>
  /* The analysis page's own look (MapAnalysisPage.astro .an4), for the sections added here. */
  .anx h2 { font: 400 26px/1.2 var(--serif, "Playfair Display Variable", Georgia, serif); margin: 48px 0 16px; padding-top: 24px; border-top: 1px solid rgba(120, 120, 110, .2); }
  .anx .an4-sc { overflow-x: auto; }
  .anx table { width: 100%; border-collapse: collapse; font-size: 14px; font-variant-numeric: tabular-nums; }
  .anx th, .anx td { padding: 8px 10px; text-align: right; border-bottom: 1px solid rgba(120, 120, 110, .16); white-space: nowrap; }
  .anx th:first-child, .anx td:first-child { text-align: left; }
  .anx th { font: 700 12px/1.2 var(--sans, "Manrope Variable", system-ui, sans-serif); letter-spacing: .06em; text-transform: uppercase; color: #5d6066; }
  .anx td small { color: #5d6066; }
  .anx .anx-lead td { font-weight: 700; }
  .anx td :global(svg) { display: block; margin-left: auto; }
  @media print { .anx h2 { break-after: avoid; } .anx table { font-size: 11px; } }
</style>
