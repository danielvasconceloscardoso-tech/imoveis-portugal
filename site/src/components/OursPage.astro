---
// "Our partners" (prompt 18): the licensed partner group first (agency, credit, insurance), then the founding
// partners as they sign. Only real names and licences from config; nothing invented (DL 330/90).
import V2 from "../layouts/V2.astro";
import { config } from "../config";
import { pathFor, type Lang, type EdCode } from "../i18n";
import { c, edName } from "../lib/copy";

interface Props { lang: Lang; ed: EdCode; }
const { lang, ed } = Astro.props;
const cp = config.creditPartner, ip = config.insurancePartner;
const group = [
  { role: c("ours.agency", lang), name: config.agency.name, licence: `AMI ${config.agency.ami}`, tag: c("common.gold", lang) },
  { role: c("ours.credit", lang), name: cp.name, licence: cp.bdp ? `Banco de Portugal ${cp.bdp}` : "", tag: cp.name ? c("common.sponsored", lang) : "" },
  { role: c("ours.insurance", lang), name: ip.name, licence: ip.asf ? `ASF ${ip.asf}` : "", tag: ip.name ? c("common.sponsored", lang) : "" },
];
const founding = config.foundingPartners;
---
<V2 lang={lang} ed={ed} page="ours" title={`${c("ours.title", lang)} | Imóveis Portugal · ${edName(ed, lang)}`} description={c("ours.lede", lang)} sticky={null}>
  <div class="frame read ph">
    <h1>{c("ours.title", lang)}</h1>
    <p class="lede">{c("ours.lede", lang)}</p>
  </div>
  <div class="frame read ours">
    <h2 class="h-small">{c("ours.group.h", lang)}</h2>
    <ul class="ours-list">{group.map((g) => (
      <li><span class="role">{g.role}</span><span class={g.name ? "name" : "name tba"}>{g.name || c("ours.tba", lang)}</span>{g.name && <span class="lic">{g.licence}{g.tag && ` · ${g.tag}`}</span>}</li>
    ))}</ul>
    <h2 class="h-small" style="margin-top:56px">{c("ours.founding.h", lang)}</h2>
    {founding.length ? (
      <ul class="ours-list">{founding.map((f) => <li><span class="role">{f.category}</span><span class="name">{f.name}</span><span class="lic">{f.licence} · {c("common.sponsored", lang)}</span></li>)}</ul>
    ) : <p class="ours-empty">{c("ours.founding.none", lang)}</p>}
    <p style="margin:40px 0 72px"><a class="more" href={pathFor(lang, ed, "partners")}>{c("ours.join", lang)}</a></p>
  </div>
</V2>
