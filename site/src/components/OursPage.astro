---
// "Our partners" (prompt 18): the licensed partner group first (agency, credit, insurance), then the founding
// partners as they sign. Only real names and licences from config; nothing invented (DL 330/90).
import V2 from "../layouts/V2.astro";
import { config } from "../config";
import { SLUGS, pathFor, type Lang, type EdCode } from "../i18n";
import { PROJECTS, showcases } from "../lib/projects";
import { c, edName } from "../lib/copy";

interface Props { lang: Lang; ed: EdCode; }
const { lang, ed } = Astro.props;
const cp = config.creditPartner, ip = config.insurancePartner;
const group = [
  // Prompt 66 §3: while config.agency.public is false the role shows the qualified advisor, not the agency's name or licence.
  config.agency.public
    ? { role: c("ours.agency", lang), name: config.agency.name, licence: `AMI ${config.agency.ami}`, tag: c("common.gold", lang) }
    : { role: c("ours.agency", lang), name: c("advisor.title", lang), licence: c("advisor.firm", lang), tag: c("common.gold", lang) },
  { role: c("ours.credit", lang), name: cp.name, licence: cp.bdp ? `Banco de Portugal ${cp.bdp}` : "", tag: cp.name ? c("common.sponsored", lang) : "" },
  { role: c("ours.insurance", lang), name: ip.name, licence: ip.asf ? `ASF ${ip.asf}` : "", tag: ip.name ? c("common.sponsored", lang) : "" },
];
// Prompt 70 (J-29, MI-21): only the partners that exist are listed. A category with no partner yet (credit, insurance) stays
// in config and comes back on its own once a name is set; it is not shown as "to be announced".
const shown = group.filter((g) => g.name);
const founding = config.foundingPartners;
// The developers the map labels "Our partner" (projects.json tag), one line each with their showcases. A project labelled
// otherwise (O'rizon, "Our pick") is our selection, not a partner, and is not listed here.
const devs = [...showcases(PROJECTS).filter((ps) => ps[0].tag?.en === "Our partner").reduce((m, ps) => {
  const p = ps[0], k = p.devSlug ?? p.developer;
  const d = m.get(k) ?? { name: p.developer, tag: p.tag?.[lang] ?? "", homes: [] as { name: string; href: string }[] };
  d.homes.push({ name: p.name, href: `/${lang}/${ed}/${SLUGS[lang].partners}/${p.devSlug}/${p.muni}/` });
  return m.set(k, d);
}, new Map<string, { name: string; tag: string; homes: { name: string; href: string }[] }>()).values()];
---
<V2 lang={lang} ed={ed} page="ours" title={`${c("ours.title", lang)} | Imóveis Portugal · ${edName(ed, lang)}`} description={c("ours.lede", lang)} sticky={null}>
  <div class="frame read ph">
    <h1>{c("ours.title", lang)}</h1>
    <p class="lede">{c("ours.lede", lang)}</p>
  </div>
  <div class="frame read ours">
    <h2 class="h-small">{c("ours.group.h", lang)}</h2>
    <ul class="ours-list">{shown.map((g) => (
      <li><span class="role">{g.role}</span><span class="name">{g.name}</span><span class="lic">{g.licence}{g.tag && ` · ${g.tag}`}</span></li>
    ))}</ul>
    {devs.length > 0 && <>
      <h2 class="h-small" style="margin-top:56px">{c("ours.devs.h", lang)}</h2>
      <ul class="ours-list">{devs.map((d) => <li><span class="role">{c("ours.devs.role", lang)}</span><span class="name">{d.name}</span><span class="lic">{d.homes.map((h, i) => <>{i > 0 && " · "}<a href={h.href}>{h.name}</a></>)}{d.tag && ` · ${d.tag}`}</span></li>)}</ul>
    </>}
    <h2 class="h-small" style="margin-top:56px">{c("ours.founding.h", lang)}</h2>
    {founding.length ? (
      <ul class="ours-list">{founding.map((f) => <li><span class="role">{f.category}</span><span class="name">{f.name}</span><span class="lic">{f.licence} · {c("common.sponsored", lang)}</span></li>)}</ul>
    ) : <p class="ours-empty">{c("ours.founding.none", lang)}</p>}
    <p style="margin:40px 0 72px"><a class="more" href={pathFor(lang, ed, "partners")}>{c("ours.join", lang)}</a></p>
  </div>
</V2>
