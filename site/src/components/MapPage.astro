---
// The map page (prompts 16, 19 and 36; D34, D62): map v3 full screen under a translucent bar, then the lede, the list, sources.
import V2 from "../layouts/V2.astro";
import MapV3 from "./MapV3.astro";
import { pathFor, type Lang, type EdCode } from "../i18n";
import { ART_SUB } from "../lib/articles";
import { Sources, fmtDate } from "../lib/content";
import { c, edName } from "../lib/copy";

interface Props { lang: Lang; ed: EdCode; }
const { lang, ed } = Astro.props;
const src = new Sources();
const arts = pathFor(lang, ed, "articles"); // prompt 37 §2: the note and the municipality table now live in two articles
const n = src.n("ine-m2-2026q2");
src.n("ine-rent-history");
src.n("bdp-mortgage-rate-2026-08");
src.n("osm-boundaries");
src.raw("https://wiki.openstreetmap.org/wiki/Tag:leisure%3Dgolf_course", "Golf courses (the Golf layer): OpenStreetMap leisure=golf_course, © OpenStreetMap contributors (ODbL)", "2026-10-27");  // prompt 33 §4.1; fact id osm-golf-courses proposed
---
<V2 lang={lang} ed={ed} page="map" title={`${c("map.title", lang)} | Imóveis Portugal · ${edName(ed, lang)}`} description={c("map.lede", lang)} sticky={null} d2 bodyClass="m3p">
  <h1 class="vh">{c("map.title", lang)}</h1>
  <MapV3 lang={lang} ed={ed} mode="page" />
  <div class="m3-after">
    <p class="lede">{c("map.lede", lang)}<a class="sup" href={`#fonte-${n}`}>{n}</a></p>
    <p class="small m3-arts"><a href={`${arts}${ART_SUB.map[lang]}/`}>{c("art.map.link", lang)}</a> · <a href={`${arts}${ART_SUB.method[lang]}/`}>{c("art.method.link", lang)}</a></p>
  </div>
  <section class="sources-list" aria-labelledby="fontes">
    <div class="frame read">
      <h2 id="fontes" class="h-small">{c("common.sources", lang)}</h2>
      <ol>{src.list.map((s, i) => <li id={`fonte-${i + 1}`}><a href={s.url} rel="noopener">{s.title}</a>{s.checked && `, ${c("common.checked", lang, { date: fmtDate(lang, s.checked) })}`}.</li>)}</ol>
    </div>
  </section>
</V2>
