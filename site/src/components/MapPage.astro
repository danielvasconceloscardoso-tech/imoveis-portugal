---
// The map page (prompts 16 and 19, D34): the 3D map as the hero, filters, the searchable list, sources.
import V2 from "../layouts/V2.astro";
import MapExplorer from "./MapExplorer.astro";
import Scenarios from "./Scenarios.astro";
import { type Lang, type EdCode } from "../i18n";
import { Sources, fmtDate } from "../lib/content";
import { c, edName } from "../lib/copy";

interface Props { lang: Lang; ed: EdCode; }
const { lang, ed } = Astro.props;
const src = new Sources();
const n = src.n("ine-m2-2026q2");
src.n("ine-rent-history");
src.n("bdp-mortgage-rate-2026-08");
src.n("osm-boundaries");
---
<V2 lang={lang} ed={ed} page="map" title={`${c("map.title", lang)} | Imóveis Portugal · ${edName(ed, lang)}`} description={c("map.lede", lang)} sticky={null}>
  <div class="frame ph mapx-head">
    <h1>{c("map.title", lang)}</h1>
    <p class="lede">{c("map.lede", lang)}<a class="sup" href={`#fonte-${n}`}>{n}</a></p>
  </div>
  <div class="frame mapx-frame">
    <MapExplorer lang={lang} ed={ed} mode="page" />
    <p class="small" style="max-width:44em;margin-top:24px">{c("map.note", lang)}</p>
    <Scenarios lang={lang} ed={ed} src={src} />
  </div>
  <section class="sources-list" aria-labelledby="fontes">
    <div class="frame read">
      <h2 id="fontes" class="h-small">{c("common.sources", lang)}</h2>
      <ol>{src.list.map((s, i) => <li id={`fonte-${i + 1}`}><a href={s.url} rel="noopener">{s.title}</a>{s.checked && `, ${c("common.checked", lang, { date: fmtDate(lang, s.checked) })}`}.</li>)}</ol>
    </div>
  </section>
</V2>
