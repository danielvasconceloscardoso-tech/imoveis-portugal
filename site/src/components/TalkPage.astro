---
// "Talk to a partner": the enquiry form for every partner category. FAQ buttons link here with
// ?cat=<category>#form; the chosen category is highlighted and passed to the form.
// Buying or selling a home goes only to the partner agency (D14, D17). Wording: COPY_DECK.md "talk.*".
import V2 from "../layouts/V2.astro";
import Embed from "./Embed.astro";
import { config } from "../config";
import { pathFor, type Lang, type EdCode } from "../i18n";
import { CATS } from "../lib/content";
import { c } from "../lib/copy";

interface Props { lang: Lang; ed: EdCode; }
const { lang, ed } = Astro.props;
const site = config.agency.website.replace(/^https:\/\/|\/$/g, "");
---
<V2 lang={lang} ed={ed} page="talk" title={`${c("talk.title", lang)} | Imóveis Portugal`} description={c("talk.lede", lang)} sticky={null}>
  <div class="frame read ph">
    <h1>{c("talk.title", lang)}</h1>
    <p class="lede">{c("talk.lede", lang)}</p>
  </div>
  <div class="frame read prose">
    <div class="partner">
      <span class="tag">{c("common.sponsored", lang)}</span>
      <span class="logo">{config.agency.name}</span>
      <p style="margin:0">{c("talk.agency.p", lang)}</p>
      <p class="small" style="margin:0">AMI {config.agency.ami} · <a href={config.agency.website} rel="noopener">{site}</a></p>
      <a class="btn" style="justify-self:start" href={pathFor(lang, ed, "buy")}>{c("faq.cta.agency", lang)}</a>
    </div>
    <h2>{c("talk.cats.h", lang)}</h2>
    <p>{c("talk.launch", lang)}</p>
    <div class="cards two" id="cats">
      {CATS.map((k) => (
        <a class="card" id={k} data-cat={k} href={`?cat=${k}#form`}>
          <h3>{c(`talk.cat.${k}.h`, lang)}</h3><p>{c(`talk.cat.${k}.p`, lang)}</p>
          <span class="go">{config.partners[k] ? `${config.partners[k]} · ${c("common.sponsored", lang)}` : c("common.nav.talk", lang)}</span>
        </a>
      ))}
    </div>
    <h2 id="form">{c("talk.form.h", lang)}</h2>
    <p>{c("talk.form.intro", lang)}</p>
    <Embed id={config.forms.partnerRequest[lang]} title={c("talk.form.h", lang)} pending={c("common.form.pending", lang)} hidden={{ edition: ed, lang }} height={520} />
    <p class="small" style="margin-top:12px"><a href={pathFor(lang, ed, "privacy")}>{c("common.privacy", lang)}</a></p>
  </div>
  <script is:inline>
    (function () {
      var cat = new URLSearchParams(location.search).get("cat");
      if (!cat) return;
      var card = document.querySelector('[data-cat="' + cat + '"]');
      if (card) { card.style.borderColor = "var(--accent)"; card.style.boxShadow = "0 0 0 3px var(--accent-soft)"; }
      var f = document.querySelector(".form-box iframe");
      if (f && f.src.indexOf("tally.so") > -1) f.src += "&category=" + encodeURIComponent(cat);
    })();
  </script>
</V2>
