---
// Checkout for the paid plan (D22). The buy button stays disabled until config.plan.live and a Stripe Payment
// Link exist (billing entity D4, EU VAT OSS); while off, no page links here and the page is noindex.
// Express consent to immediate delivery waives the 14-day withdrawal right (DL 24/2014, art. 17.º).
import V2 from "../layouts/V2.astro";
import { config } from "../config";
import { LANGS, pathFor, type Lang, type EdCode } from "../i18n";
import { SUB } from "../lib/tools";
import { c, cl } from "../lib/copy";

interface Props { lang: Lang; ed: EdCode; }
const { lang, ed } = Astro.props;
const paths = Object.fromEntries(LANGS.map((l) => [l, `${pathFor(l, ed, "sims")}${SUB.checkout[l]}/`])) as Record<Lang, string>;
const live = config.plan.live && !!config.plan.stripeLink;
const example = `${pathFor(lang, ed, "sims")}${SUB.plan[lang]}/`;
---
<V2 lang={lang} ed={ed} page="sims" paths={paths} noindex title={`${c("checkout.title", lang)} | Imóveis Portugal`} description={c("checkout.lede", lang)} sticky={null}>
  <div class="frame read ph">
    <h1>{c("checkout.title", lang)}</h1>
    <p class="lede">{c("checkout.lede", lang)}</p>
  </div>
  <div class="frame read checkout">
    <p class="price">{c("checkout.price", lang)}</p>
    <h2 class="h3">{c("checkout.inside.h", lang)}</h2>
    <ul class="list">{cl("checkout.inside", lang).map((x) => <li>{x}</li>)}</ul>
    <p><a href={example} id="example">{c("checkout.example", lang)}</a></p>
    <label class="consent"><input type="checkbox" id="waiver" /> <span>{c("checkout.consent", lang)}</span></label>
    <p><a class="btn" id="buy" aria-disabled="true" href="#" data-live={live ? "1" : "0"} data-href={config.plan.stripeLink}>{c("checkout.buy", lang)}</a></p>
    <p class="small">{c("checkout.vat", lang, { entity: config.entity.name || "Imóveis Portugal" })} {c("checkout.pay", lang)}</p>
    <p class="small" style="margin-bottom:64px"><a href={pathFor(lang, ed, "privacy")}>{c("common.privacy", lang)}</a> · <a href={pathFor(lang, ed, "legal")}>{c("common.foot.legal", lang)}</a></p>
  </div>
</V2>
<script>
  const w = document.getElementById("waiver") as HTMLInputElement;
  const b = document.getElementById("buy") as HTMLAnchorElement;
  const ex = document.getElementById("example") as HTMLAnchorElement;
  if (location.search) ex.href += location.search; // the example uses the reader's own figures
  const sync = () => { const ok = w.checked && b.dataset.live === "1"; b.setAttribute("aria-disabled", ok ? "false" : "true"); b.href = ok ? `${b.dataset.href}?client_reference_id=${encodeURIComponent(location.search.slice(1, 200))}` : "#"; };
  w.addEventListener("change", sync);
  b.addEventListener("click", (e) => { if (b.getAttribute("aria-disabled") === "true") e.preventDefault(); });
  sync();
</script>
