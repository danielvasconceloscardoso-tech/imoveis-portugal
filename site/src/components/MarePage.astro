---
// The Maré page (D83, operator 3 Nov 2026), like an Apple product page: the name, large; one line; one e-mail field,
// one unticked consent box and one button; the latest issue below exactly as it looks in the inbox (the e-mail
// rendered by lib/mare.ts, framed); the archive as cards (headline and photo). With `issue`, the page of one issue.
// Signup: the beehiiv embed when config.forms.newsletter has one (shown only after the consent box is ticked and the
// button pressed), otherwise today's mechanism: the reader's own email opens with the request written (double opt-in
// then done in beehiiv by the operator). Signals: lib/track.ts evSignup (surface + headline + first-touch UTM) and
// evMareBlock (an arrival from the quiet block). No e-mail ever leaves the page in an event. Wording: COPY_DECK "mare.*".
// Fix step 5 (operator, 3 Nov 2026): the page leads with what Maré is: the name, the sentence (mare.line: "Maré, a
// newsletter: insights e pérolas de Portugal, todas as terças e sextas."), the e-mail field, then the latest issue; the
// time and "free" sit under the form, the archive below. An arrival from the header button (?de=header) or the line under
// "Começar" (?de=hero) is counted as ev "mare/open/{header|hero}".
import V2 from "../layouts/V2.astro";
import { config } from "../config";
import { HTML_LANG, LANGS, pathFor, type Lang, type EdCode } from "../i18n";
import { c, edName } from "../lib/copy";
import { issues, latestIssue, renderIssue, photoUrl, type MareIssue } from "../lib/mare";

interface Props { lang: Lang; ed: EdCode; issue?: MareIssue; }
const { lang, ed } = Astro.props;
const one = Astro.props.issue ?? null;
const show = one ?? latestIssue();
const all = issues();
const base = pathFor(lang, ed, "mare");
const paths = one ? (Object.fromEntries(LANGS.map((l) => [l, `${pathFor(l, ed, "mare")}${one.id}/`])) as Record<Lang, string>) : undefined;
const nl = config.forms.newsletter[lang];
// One field, one click (operator, 3 Nov 2026): with a beehiiv form id the form shows at once, no tick box and no
// confirmation e-mail; a line under it says what the click does (D87).
const bh = !!nl && !nl.startsWith("http");
const Box = bh ? "div" : "form"; // beehiiv draws its own form: no form inside a form
const mail = `mailto:${config.contactEmail}?subject=${encodeURIComponent(`${c("home.subscribe.subject", lang)} (${ed} · ${lang})`)}`;
const html = show ? renderIssue(show, { ed, framed: true }) : "";
// French writes the first day of a month "1er" (prompt 70, S-27).
const fr1 = (s: string) => (lang === "fr" ? s.replace(/(^|\s)1 (?=\p{L})/u, "$11er ") : s);
const fmt = (d: string) => fr1(new Intl.DateTimeFormat(HTML_LANG[lang], { weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(`${d}T12:00:00Z`)));
const dayMonth = (d: string) => fr1(new Intl.DateTimeFormat(HTML_LANG[lang], { day: "numeric", month: "long", timeZone: "UTC" }).format(new Date(`${d}T12:00:00Z`)));
// Prompt 70 (A-21): before its date, the issue shown is a preview of the first Maré, said so with its date.
const ahead = !!show && !one && show.date > new Date().toISOString().slice(0, 10);
// Prompt 70 (J-06): an issue title in the reader's language when the issue has one (headline_en / headline_fr), else none.
const headIn = (x: MareIssue) => (lang === "pt" ? x.headline : (x as unknown as Record<string, string | undefined>)[`headline_${lang}`] ?? "");
const title = one ? `${one.headline} | Maré` : `Maré | Imóveis Portugal · ${edName(ed, lang)}`;
---
<V2 lang={lang} ed={ed} page="mare" paths={paths} title={title} description={one ? one.preheader : c("mare.meta", lang)} sticky={null} next={false}
  ogImage={show ? `https://${config.primaryDomain}${photoUrl(show.photo.src, 1024)}` : undefined}>
  <section class={one ? "mr-hero mr-hero-s" : "mr-hero"} aria-labelledby="mr-h">
    {one ? (
      <>
        <p class="mr-back"><a href={base}>{c("mare.issue.back", lang)}</a></p>
        <p class="mr-kick">{c("common.newsletter", lang)} · {fmt(one.date)}</p>
        <h1 id="mr-h" class="mr-h1s">{one.headline}</h1>
      </>
    ) : (
      <>
        <h1 id="mr-h" class="mr-word">{c("mare.title", lang)}</h1>
        <p class="mr-line">{c("mare.line", lang)}</p>
      </>
    )}
    <Box class="mr-form" action={bh ? undefined : nl ? "#" : mail} method={bh ? undefined : "post"} enctype={bh ? undefined : "text/plain"} data-mare-form data-issue={show?.id ?? ""} data-embed={nl || undefined}>
      <input type="hidden" name="edicao" value={ed} />
      <input type="hidden" name="lingua" value={lang} />
      <input type="hidden" name="origem" value="mare" data-mare-from />
      {show && <input type="hidden" name="mare" value={show.id} />}
      {!nl && <label class="mr-email"><span class="vh">{c("mare.email", lang)}</span><input type="email" name="email" required autocomplete="email" placeholder={c("mare.email", lang)} /></label>}
      {/* Prompt 70 (S-18, A-21, MI-29): our own field and button paint at once in the site's fonts and work from the first
          second; beehiiv's form loads after the page (or on the first tap) off screen, takes over with what was typed,
          and sends. If it never arrives, the button opens the reader's own email with the request written. */}
      {bh && <label class="mr-email" data-mare-own><span class="vh">{c("mare.email", lang)}</span><input type="email" required autocomplete="email" placeholder={c("mare.email", lang)} /></label>}
      {bh && <button class="mr-btn" type="button" data-mare-go>{c("mare.a", lang)}</button>}
      {bh && <div class="mr-embed" data-mare-embed data-bh={nl} data-mail={mail} data-mail-label={c("mare.a", lang)}></div>}
      {bh && <p class="mr-small mr-bh-note">{c("mare.oneclick", lang)} <a href={pathFor(lang, ed, "privacy")}>{c("common.privacy", lang)}</a></p>}
      {!bh && <button class="mr-btn" type="submit">{c("mare.a", lang)}</button>}
      {!bh && <label class="mr-consent"><input type="checkbox" name="consentimento" value="sim" required data-mare-consent data-need={c("mare.consent.need", lang)} /> <span>{c("mare.consent", lang)} <a href={pathFor(lang, ed, "privacy")}>{c("common.privacy", lang)}</a></span></label>}
      {!bh && <p class="mr-small">{c(nl ? "mare.optin.embed" : "mare.optin.mail", lang)}</p>}
      <p class="mr-sent" role="status" hidden data-mare-sent>{c(bh ? "mare.thanks" : "mare.sent", lang)}</p>
      {nl && !bh && <div class="mr-embed" hidden data-mare-embed><iframe data-base={nl} title={c("mare.title", lang)} style="min-height:220px"></iframe></div>}
    </Box>
    {!one && <p class="mr-when">{c("mare.when", lang)}</p>}
  </section>

  {show && (
    <section class="mr-latest" aria-labelledby="mr-latest-h">
      {!one && <h2 id="mr-latest-h" class="mr-h2">{ahead ? c("mare.first.h", lang, { date: dayMonth(show.date) }) : c("mare.latest.h", lang)}</h2>}
      {one && <h2 id="mr-latest-h" class="vh">{show.subject}</h2>}
      <p class="mr-sub">{c(ahead ? "mare.first.p" : "mare.latest.p", lang)}{lang !== "pt" && <>{" "}{c("mare.pt.only", lang)}</>}</p>
      <div class="mr-mail">
        <div class="mr-mail-top" lang="pt-PT">
          <p><span>{c("mare.inbox.from", lang)}</span> Maré · Imóveis Portugal</p>
          <p><span>{c("mare.inbox.subject", lang)}</span> <strong>{show.subject}</strong></p>
          <p class="mr-pre">{show.preheader}</p>
        </div>
        <iframe class="mr-frame" title={show.subject} srcdoc={html} lang="pt-PT" loading="lazy" data-mare-frame
          sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-top-navigation-by-user-activation"></iframe>
      </div>
    </section>
  )}

  {all.length > 0 && (
    <section class="mr-arch" aria-labelledby="mr-arch-h">
      <h2 id="mr-arch-h" class="mr-h2">{c("mare.archive.h", lang)}</h2>
      <ul class="mr-cards">
        {all.map((x) => (
          <li><a class="mr-card" href={`${base}${x.id}/`} aria-current={one?.id === x.id ? "page" : undefined}>
            <img src={photoUrl(x.photo.src, 640)} alt={x.photo.alt} width="640" height="480" loading="lazy" />
            <span class="mr-card-d">{fmt(x.date)} · {c("mare.minutes", lang, { n: x.minutes })}</span>
            {headIn(x) && <span class="mr-card-h" lang={lang === "pt" ? "pt-PT" : HTML_LANG[lang]}>{headIn(x)}</span>}
          </a></li>
        ))}
      </ul>
    </section>
  )}
</V2>

<script>
  import { ev, evSignup, evMareBlock, rememberUtm, utm } from "../lib/track";
  rememberUtm();
  const q = new URLSearchParams(location.search);
  // Where the reader came from: the quiet block (?de=article&h={issue}) or the page itself. The arrival is counted here
  // (a count on the click would be lost to the navigation); the URL is then cleaned so a shared link starts fresh.
  const de = (q.get("de") || "").replace(/[^a-z]/g, ""), h = (q.get("h") || "").replace(/[^0-9-]/g, "");
  if (de && h) { evMareBlock(de, h); q.delete("de"); q.delete("h"); history.replaceState(history.state, "", `${location.pathname}${q.toString() ? `?${q}` : ""}${location.hash}`); }
  // Fix step 5: the header button and the line under "Começar" (no headline on screen there, so no issue in the event).
  else if (de === "header" || de === "hero" || de === "home" || de === "guide") { ev({ event: `mare/open/${de}`, origin: de }); q.delete("de"); history.replaceState(history.state, "", `${location.pathname}${q.toString() ? `?${q}` : ""}${location.hash}`); }
  const f = document.querySelector<HTMLFormElement>("[data-mare-form]");
  if (f) {
    const where = de || "mare", issue = f.dataset.issue || "";
    const from = f.querySelector<HTMLInputElement>("[data-mare-from]"); if (from) from.value = where;
    const bhWrap = f.querySelector<HTMLElement>("[data-mare-embed][data-bh]");
    if (bhWrap) {
      // Prompt 70 (S-18): our field works at once; beehiiv's loader comes after the page has loaded (or at the first
      // focus or tap on the field), off screen. When its form is there it takes over, with what the reader typed; a press
      // on our button before that waits for it and then sends through it. If nothing appears within 8 s of loading
      // (blocked script, no network) our button opens the reader's own email with the request written, never a dead end.
      const own = f.querySelector<HTMLElement>("[data-mare-own]"), ownIn = own?.querySelector("input") ?? null, go = f.querySelector<HTMLButtonElement>("[data-mare-go]");
      const sent = f.querySelector<HTMLElement>("[data-mare-sent]");
      let loaded = false, ready = false, queued = false, failed = false;
      const bhInput = () => bhWrap.querySelector<HTMLInputElement>('input[type="email"], input[name*="email" i]');
      const setVal = (el: HTMLInputElement, v: string) => { Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value")?.set?.call(el, v); el.dispatchEvent(new Event("input", { bubbles: true })); el.dispatchEvent(new Event("change", { bubbles: true })); };
      const send = () => { const fm = bhWrap.querySelector("form"); const b = fm?.querySelector<HTMLElement>('button[type="submit"], button:not([type]), input[type="submit"]'); if (b) b.click(); else fm?.requestSubmit?.(); };
      const take = () => {
        if (ready) return true;
        const bi = bhInput(), fr = bhWrap.querySelector("iframe");
        if (!bi && !fr) return false;
        ready = true;
        const typed = ownIn?.value ?? "", had = document.activeElement === ownIn;
        if (bi && typed) setVal(bi, typed);
        if (own) own.hidden = true; if (go) go.hidden = true;
        bhWrap.classList.add("is-ready");
        if (bi && had) bi.focus();
        if (bi && queued) send();
        return true;
      };
      const load = () => {
        if (loaded) return; loaded = true;
        new MutationObserver(() => take()).observe(bhWrap, { childList: true, subtree: true });
        const s = document.createElement("script"); s.async = true; s.src = "https://subscribe-forms.beehiiv.com/v3/loader.js";
        s.setAttribute("data-beehiiv-form", bhWrap.dataset.bh!); bhWrap.appendChild(s);
        const a = document.createElement("script"); a.async = true; a.src = "https://subscribe-forms.beehiiv.com/attribution.js"; document.body.appendChild(a);
        setTimeout(() => { if (!take()) failed = true; if (failed && queued && bhWrap.dataset.mail) location.href = bhWrap.dataset.mail; }, 8000);
      };
      if (document.readyState === "complete") setTimeout(load, 300); else addEventListener("load", () => setTimeout(load, 300), { once: true });
      ownIn?.addEventListener("focus", load, { once: true });
      go?.addEventListener("click", () => {
        if (ownIn && !ownIn.checkValidity()) { ownIn.reportValidity(); return; }
        if (failed) { if (bhWrap.dataset.mail) location.href = bhWrap.dataset.mail; return; }
        queued = true; go.disabled = true; go.setAttribute("aria-busy", "true"); load(); take();
      });
      ownIn?.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); go?.click(); } });
      // MI-29: a calm line of our own once beehiiv's form is sent (its own message may also show).
      let thanked = false;
      const thank = () => { if (thanked) return; thanked = true; evSignup(where, issue); if (sent) setTimeout(() => { sent.hidden = false; }, 600); };
      bhWrap.addEventListener("submit", thank, true);
      bhWrap.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest('button, input[type="submit"]') && bhInput()?.checkValidity() && bhInput()?.value) setTimeout(thank, 900); }, true);
      addEventListener("blur", function once() { const el = document.activeElement; if (el && el.tagName === "IFRAME" && (bhWrap.contains(el) || String((el as HTMLIFrameElement).src).includes("beehiiv"))) { evSignup(where, issue); removeEventListener("blur", once); } });
    }
    const box = f.querySelector<HTMLInputElement>("[data-mare-consent]");
    const say = () => { if (box) box.setCustomValidity(box.checked ? "" : box.dataset.need || ""); };
    box?.addEventListener("change", say); say();
    if (!bhWrap) f.addEventListener("submit", (e) => {
      say();
      if (!f.checkValidity()) { e.preventDefault(); f.reportValidity(); return; }
      if (f.dataset.embed) {
        // beehiiv: the embed (its own field and button) opens only now, with the first-touch UTM and the surface.
        e.preventDefault();
        const wrap = f.querySelector<HTMLElement>("[data-mare-embed]"), fr = wrap?.querySelector("iframe");
        // beehiiv v3 subscribe form (a form id, not a URL; operator, 3 Nov 2026): beehiiv's own loader script draws the
        // form inside the box; its attribution script passes the page's UTM on. If nothing appears within 8 s (blocked
        // script, no network), the reader gets the e-mail request instead, never an empty box.
        if (wrap && wrap.dataset.bh && !wrap.dataset.on) {
          wrap.dataset.on = "1"; wrap.hidden = false;
          const s = document.createElement("script"); s.async = true; s.src = "https://subscribe-forms.beehiiv.com/v3/loader.js";
          s.setAttribute("data-beehiiv-form", wrap.dataset.bh); wrap.appendChild(s);
          if (!document.querySelector("script[data-bh-attr]")) { const a = document.createElement("script"); a.async = true; a.src = "https://subscribe-forms.beehiiv.com/attribution.js"; a.setAttribute("data-bh-attr", ""); document.body.appendChild(a); }
          setTimeout(() => {
            if (wrap.querySelector("iframe, form") || document.querySelector("iframe[src*='beehiiv']")) return;
            const m = document.createElement("a"); m.className = "mr-btn"; m.href = wrap.dataset.mail || "#"; m.textContent = wrap.dataset.mailLabel || "OK"; wrap.appendChild(m);
          }, 8000);
          addEventListener("blur", function once() { const a = document.activeElement; if (a && a.tagName === "IFRAME" && (wrap.contains(a) || String((a as HTMLIFrameElement).src).includes("beehiiv"))) { evSignup(where, issue); removeEventListener("blur", once); } });
          return;
        }
        if (wrap && fr && !fr.getAttribute("src")) {
          const u = utm(), url = new URL(fr.dataset.base!);
          url.searchParams.set("utm_source", u.source === "-" ? "site" : u.source); url.searchParams.set("utm_medium", u.medium === "-" ? where : u.medium);
          url.searchParams.set("utm_campaign", u.campaign === "-" ? `mare-${issue}` : u.campaign);
          fr.src = url.toString(); wrap.hidden = false;
          // The embed hides its own submit: the signup is counted when the reader first goes into the form.
          addEventListener("blur", function once() { if (document.activeElement === fr) { evSignup(where, issue); removeEventListener("blur", once); } });
        }
        return;
      }
      evSignup(where, issue);
      const sent = f.querySelector<HTMLElement>("[data-mare-sent]"); if (sent) setTimeout(() => { sent.hidden = false; }, 400);
    });
  }
  // The e-mail preview: as tall as the e-mail itself, so the page scrolls, not the frame.
  const fr = document.querySelector<HTMLIFrameElement>("[data-mare-frame]");
  if (fr) {
    const fit = () => { try { const d = fr.contentDocument; if (d?.body) fr.style.height = `${d.documentElement.scrollHeight}px`; } catch { /* keep the default */ } };
    fr.addEventListener("load", () => { fit(); setTimeout(fit, 400); fr.contentDocument?.querySelectorAll("img").forEach((i) => i.addEventListener("load", fit)); });
    addEventListener("resize", fit);
    if (fr.contentDocument?.readyState === "complete") fit();
  }
</script>

<style>
  .mr-hero { max-width: 44rem; margin: 0 auto; padding: clamp(56px, 12vw, 140px) var(--gut, 20px) clamp(48px, 8vw, 96px); text-align: center; }
  .mr-word { margin: 0; font: 400 clamp(88px, 24vw, 208px)/.9 var(--serif); letter-spacing: -.03em; }
  .mr-line { margin: 28px auto 0; max-width: 26em; text-wrap: balance; font: 400 clamp(22px, 3.4vw, 32px)/1.3 var(--serif); }
  .mr-when { margin: 20px 0 0; color: var(--muted); font-size: 15px; }
  .mr-hero-s { text-align: left; max-width: 40rem; padding-top: clamp(40px, 8vw, 88px); }
  .mr-back { margin: 0 0 28px; font-size: 15px; } .mr-back a { color: var(--muted); }
  .mr-kick { margin: 0 0 12px; font: 600 12px/1.3 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
  .mr-h1s { margin: 0 0 8px; font-size: clamp(34px, 6vw, 56px); line-height: 1.1; }
  .mr-form { display: grid; grid-template-columns: 1fr auto; gap: 12px; max-width: 32rem; margin: 40px auto 0; text-align: left; }
  .mr-hero-s .mr-form { margin-left: 0; }
  .mr-form[data-embed] { grid-template-columns: 1fr auto; }
  .mr-form[data-embed] > .mr-small, .mr-form[data-embed] > .mr-sent { text-align: center; }
  /* beehiiv's form, once it takes over: the site's fonts from its first paint, the button text centred. */
  .mr-embed[data-bh]:not(.is-ready) { position: absolute; left: -9999px; top: 0; width: 32rem; max-width: 90vw; }
  .mr-embed[data-bh].is-ready { display: grid; justify-items: center; }
  .mr-embed :is(input, button, select, textarea, label, p) { font-family: var(--sans) !important; }
  .mr-embed button { display: inline-flex !important; align-items: center; justify-content: center !important; text-align: center !important; }
  .mr-email input { width: 100%; min-height: 52px; box-sizing: border-box; padding: 0 16px; border: 1px solid #c9c9c4; border-radius: 2px; background: #fff; font: 400 17px/1 var(--sans); color: var(--ink); }
  .mr-email input:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent; }
  .mr-btn { min-height: 52px; padding: 0 28px; border: 0; border-radius: 2px; background: var(--ink); color: #fff; font: 600 15px/1 var(--sans); cursor: pointer; transition: background-color .25s var(--ease); white-space: nowrap; }
  .mr-btn:hover { background: var(--accent); }
  .mr-consent { grid-column: 1 / -1; display: flex; gap: 12px; align-items: flex-start; font-size: 14px; line-height: 1.5; color: var(--muted); cursor: pointer; }
  .mr-consent input { width: 18px; height: 18px; margin: 2px 0 0; flex: none; accent-color: var(--accent); }
  .mr-consent a { color: inherit; }
  .mr-small, .mr-sent { grid-column: 1 / -1; margin: 0; font-size: 13px; color: var(--muted); }
  .mr-sent { color: var(--accent); font-size: 14px; }
  .mr-embed { grid-column: 1 / -1; width: 100%; } .mr-embed iframe { width: 100%; border: 0; }
  .mr-bh-note { text-align: center; max-width: 26rem; }
  .mr-embed a.mr-btn { display: inline-flex; align-items: center; justify-content: center; width: 100%; max-width: 400px; text-decoration: none; }
  .mr-latest { padding: clamp(56px, 9vw, 120px) var(--gut, 20px); background: #efebe3; text-align: center; }
  .mr-h2 { margin: 0; font-size: clamp(30px, 4.4vw, 44px); line-height: 1.15; }
  .mr-sub { margin: 10px 0 36px; color: var(--muted); }
  .mr-mail { max-width: 640px; margin: 0 auto; text-align: left; background: #fff; border-radius: 14px; box-shadow: 0 1px 2px rgba(17, 18, 20, .06), 0 24px 60px -24px rgba(17, 18, 20, .25); overflow: hidden; }
  .mr-mail-top { padding: 18px 22px 14px; border-bottom: 1px solid var(--rule); font-size: 14px; line-height: 1.5; }
  .mr-mail-top p { margin: 0 0 2px; } .mr-mail-top span { display: inline-block; min-width: 4.5em; color: var(--muted); }
  .mr-pre { color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mr-frame { display: block; width: 100%; height: 2600px; border: 0; background: #efebe3; }
  .mr-arch { max-width: 72rem; margin: 0 auto; padding: clamp(56px, 9vw, 120px) var(--gut, 20px); }
  .mr-cards { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 28px; }
  .mr-card { display: grid; gap: 10px; text-decoration: none; color: inherit; }
  .mr-card img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; transition: opacity .25s var(--ease); }
  .mr-card:hover img { opacity: .9; }
  .mr-card-d { font-size: 13px; color: var(--muted); }
  .mr-card-h { font: 400 22px/1.3 var(--serif); }
  .mr-card[aria-current] .mr-card-h { color: var(--accent); }
  @media (max-width: 560px) { .mr-form, .mr-form[data-embed] { grid-template-columns: 1fr; } .mr-btn { width: 100%; } }
</style>
