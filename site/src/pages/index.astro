---
// Root: choose a language and an edition. Returning visitors go straight to their saved choice (D18).
import "../styles/v2.css";
import { EDITIONS, ED_ORDER, LANGS, LANG_NAME, HTML_LANG, pathFor } from "../i18n";
import { config } from "../config";
const H = { pt: "Comprar casa em Portugal a partir de onde vive.", en: "Buying a home in Portugal from wherever you live.", fr: "Acheter au Portugal depuis là où vous vivez." };
---
<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Imóveis Portugal</title>
    <meta name="description" content="Comprar casa em Portugal a partir do estrangeiro. Buying a home in Portugal from abroad. Acheter au Portugal depuis l'étranger." />
    {!config.launchReady && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        var l = localStorage.getItem("ip-lang"), e = localStorage.getItem("ip-ed");
        if (["pt", "en", "fr"].indexOf(l) > -1 && ["lu", "fr", "ch", "br", "us", "il"].indexOf(e) > -1) location.replace("/" + l + "/" + e + "/");
      } catch (_) {}
    </script>
  </head>
  <body>
    <header class="hd"><div class="frame"><span class="word">Imóveis Portugal</span></div></header>
    <main id="main" class="frame" style="padding-top:48px;padding-bottom:64px">
      <div class="cards">
        {LANGS.map((l) => (
          <section class="card" lang={HTML_LANG[l]} aria-labelledby={`h-${l}`}>
            <p class="label" style="margin:0">{LANG_NAME[l]}</p>
            <h2 id={`h-${l}`} style="font-size:1.5rem">{H[l]}</h2>
            <ul style="list-style:none;padding:0;margin:8px 0 0;display:grid;gap:6px">
              {ED_ORDER.map((ed) => (<li><a href={pathFor(l, ed, "home")} data-lang={l}>{EDITIONS[ed].name[l]}</a></li>))}
            </ul>
          </section>
        ))}
      </div>
    </main>
    <script is:inline>
      document.addEventListener("click", function (e) {
        var a = e.target.closest && e.target.closest("a[data-lang]");
        if (a) try { localStorage.setItem("ip-lang", a.dataset.lang); } catch (_) {}
      });
    </script>
  </body>
</html>
