---
// Private developer demo (prompt 26 §2; D51 English only; D50 register): one unlisted page per developer, noindex, out
// of the sitemap and every menu. Market figures are INE's with their periods; project facts are the developer's own.
import "@fontsource-variable/playfair-display";
import "@fontsource-variable/jost";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { DEMOS } from "../../../lib/demos";
import { PRICES, LAST } from "../../../lib/prices";
import { RATE, FACTS } from "../../../lib/content";
import { JOURNEY } from "../../../lib/journeys";
import { c } from "../../../lib/copy";
import { pathFor } from "../../../i18n";

export function getStaticPaths() { return DEMOS.map((d) => ({ params: { token: d.token } })); }
const d = DEMOS.find((x) => x.token === Astro.params.token)!;
const layers = JSON.parse(readFileSync(join(process.cwd(), "public", "data", "map", "layers.json"), "utf8"));
const nf = new Intl.NumberFormat("en-US"), nf1 = new Intl.NumberFormat("en-US", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const money = (v: number, cur = "EUR") => new Intl.NumberFormat("en-US", { style: "currency", currency: cur, maximumFractionDigits: 0 }).format(v);
const rate = (cur: string) => (cur === "EUR" ? 1 : RATE(cur as "USD").rate);
const q = PRICES.quarters[LAST], ql = `Q${q.slice(-1)} ${q.slice(0, 4)}`;
const area = (slug: string) => {
  const s = PRICES.munis[slug] as any;
  return { s, n: s.n, m2: s.m2[LAST] as number | null, rent: s.rq?.[LAST] as number | null, ly: layers.munis[slug] ?? {} };
};
const main = area(d.muni);
const places = [d.muni, ...(d.nearby ?? [])].map(area);
const curs = [...new Set(["EUR", ...d.readers.map((r) => r.cur)])];
const eds = [...new Set(d.readers.map((r) => r.ed))];
const embedBase = `/embed/map/en/?budget=${d.budgets[0]}&place=${d.muni}&center=${d.center.join(",")}&demoproj=${d.token}&devs=1`;
const firstCur = d.readers[0].cur;
const fxDate = FACTS["ecb-eur-usd"]?.checked_on ?? "";
const enquirySteps = new Set(["budget", "buy", "finance", "struct", "estate"]);
const pct = (v: number | null | undefined) => (v == null ? "—" : `${v > 0 ? "+" : ""}${nf1.format(v)}%`);
const momentum = (w?: string) => (w === "up" ? "accelerating" : w === "down" ? "slowing" : "steady");
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <title>Private demo · {d.developer} · Imóveis Portugal</title>
  <style is:global>
    :root { --ink: #111214; --muted: #5f6368; --rule: #e6e6e3; --green: #1f4a3d; --accent: #1f4a3d; --serif: "Playfair Display Variable", Georgia, serif; --sans: "Jost Variable", system-ui, sans-serif; }
    * { box-sizing: border-box; } body { margin: 0; background: #fff; color: var(--ink); font: 400 17px/1.6 var(--sans); }
    a { color: inherit; text-underline-offset: 3px; } .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
    header.top { border-bottom: 1px solid var(--rule); } header.top .wrap { display: flex; justify-content: space-between; align-items: center; padding-block: 18px; }
    .brand { font: 500 20px/1 var(--serif); letter-spacing: .01em; } .brand i { display: inline-block; width: 8px; height: 8px; background: var(--green); margin-right: 10px; vertical-align: middle; }
    .flag { font: 500 12px/1 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
    .hero { padding: 72px 0 40px; display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: end; }
    .hero h1 { font: 400 clamp(2.6rem, 2rem + 3vw, 4.6rem)/1.02 var(--serif); margin: 0 0 18px; letter-spacing: -.01em; }
    .lede { font-size: 1.15rem; color: #2b2d31; max-width: 34em; } .hero img { width: 100%; height: auto; display: block; }
    .credit { font-size: 12px; color: var(--muted); margin-top: 6px; }
    section.n { border-top: 1px solid var(--ink); padding: 40px 0 56px; display: grid; grid-template-columns: 220px 1fr; gap: 32px; }
    .num { font: 400 3.4rem/1 var(--serif); color: var(--green); } .num small { display: block; font: 500 12px/1.4 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-top: 10px; }
    h2 { font: 400 2rem/1.15 var(--serif); margin: 0 0 14px; } h3 { font: 500 1.05rem/1.3 var(--sans); margin: 18px 0 6px; }
    table { width: 100%; border-collapse: collapse; font-size: 15px; } th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--rule); vertical-align: top; } th { font-weight: 500; color: var(--muted); font-size: 13px; letter-spacing: .04em; }
    .big { font: 400 2.4rem/1 var(--serif); } .facts { list-style: none; padding: 0; margin: 0; columns: 2; column-gap: 32px; } .facts li { break-inside: avoid; padding: 8px 0; border-bottom: 1px solid var(--rule); }
    iframe { width: 100%; height: 760px; border: 0; display: block; } .frame { border: 1px solid var(--rule); }
    .mock { border: 1px solid #d9d9d6; border-radius: 6px; overflow: hidden; } .mock .bar { display: flex; gap: 8px; align-items: center; padding: 10px 14px; background: #f4f4f2; font-size: 13px; color: var(--muted); }
    .mock .bar b { width: 10px; height: 10px; border-radius: 50%; background: #d1d1cd; display: inline-block; } .mock .nav { display: flex; justify-content: space-between; padding: 18px 24px; border-bottom: 1px solid var(--rule); font: 500 15px/1 var(--sans); }
    .mock .nav span:first-child { font-family: var(--serif); font-size: 20px; } .mock .body { padding: 24px; } .mock h4 { font: 400 1.8rem/1.2 var(--serif); margin: 0 0 12px; }
    .steps { counter-reset: s; list-style: none; padding: 0; margin: 0; } .steps li { counter-increment: s; display: grid; grid-template-columns: 44px 1fr; gap: 8px; padding: 10px 0; border-bottom: 1px solid var(--rule); }
    .steps li::before { content: counter(s, decimal-leading-zero); font: 400 1.2rem/1.2 var(--serif); color: var(--muted); } .steps li.e::before { color: var(--green); } .steps .tag { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--green); margin-left: 8px; }
    .illus { display: inline-block; font: 500 12px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; border: 1px solid var(--ink); padding: 6px 8px; margin-bottom: 14px; }
    .small { font-size: 14px; color: var(--muted); } .src { font-size: 13px; color: var(--muted); } .src a { color: var(--muted); } footer { border-top: 1px solid var(--ink); padding: 28px 0 48px; font-size: 14px; color: var(--muted); }
    @media (max-width: 820px) { .hero, section.n { grid-template-columns: 1fr; } .facts { columns: 1; } iframe { height: 640px; } }
  </style>
</head>
<body>
  <header class="top"><div class="wrap"><span class="brand"><i></i>Imóveis Portugal</span><span class="flag">Private demo · {d.developer}</span></div></header>
  <main class="wrap">
    <div class="hero">
      <div>
        <p class="flag">{d.project} · {d.where}</p>
        <h1>{d.extra === "prelaunch" ? "Your launch audience, already abroad" : `${d.project}, seen by the buyers who live abroad`}</h1>
        <p class="lede">Imóveis Portugal is a guide and weekly newsletter for people living in {d.readers.map((r) => r.country).filter((v, i, a) => a.indexOf(v) === i).join(", ")} and four more countries who are preparing to buy in Portugal. This page shows how {d.developer} would appear to them: the map, the place card, the project card, the path they follow and the report you would receive.</p>
      </div>
      {d.render ? <figure style="margin:0"><img src={d.render} alt={d.project} width="1280" height="720" /><figcaption class="credit">{d.credit}. Shown only in this private demo.</figcaption></figure>
        : <figure style="margin:0"><img src="/img/lisboa-anoitecer-castelo-1200.webp" alt="Lisbon" width="1200" height="800" /><figcaption class="credit">Lisbon. Projects not yet public: the pins below are empty on purpose.</figcaption></figure>}
    </div>

    <section class="n"><div class="num">01<small>Their budget</small></div><div>
      <h2>The budgets of your buyers, in their own currency</h2>
      <p>Readers type a budget in their currency; the map converts it at the ECB reference rate ({fxDate}) and shows the square metres it buys in each municipality, from INE's median price of homes sold ({ql}).</p>
      <table><thead><tr><th>Budget</th>{curs.map((k) => <th>{k}</th>)}<th>m² in {main.n}</th></tr></thead>
        <tbody>{d.budgets.map((b) => <tr><td class="big">{money(b)}</td>{curs.map((k) => <td>{money(Math.round(b * rate(k)), k)}</td>)}<td>{main.m2 ? `${nf.format(Math.round(b / main.m2))} m²` : "—"}</td></tr>)}</tbody></table>
      <p class="src">Readers: {d.readers.map((r) => `${r.city} (${r.cur})`).join(" · ")}. Source: INE, median value per m² of homes sold, last 12 months, {ql}; ECB reference rates.</p>
    </div></section>

    <section class="n"><div class="num">02<small>The map</small></div><div>
      <h2>The map opens on Portugal and flies to {main.n}</h2>
      <p>The live map, as readers use it, with the budget in {firstCur}. Every one of the 308 municipalities can be opened; the height shows the square metres the budget buys.</p>
      <div class="frame"><iframe src={`${embedBase}&cur=${firstCur}`} title={`Map: ${main.n}`} loading="lazy"></iframe></div>
    </div></section>

    <section class="n"><div class="num">03<small>Place card</small></div><div>
      <h2>{d.extra === "prelaunch" ? "Your announced locations, in official figures" : `${main.n}, in official figures`}</h2>
      <table><thead><tr><th>Municipality</th><th>Median price per m²</th><th>10 years</th><th>Rent per m² a month</th><th>Gross yield</th><th>Last 4 quarters</th><th>Seasonal homes</th></tr></thead>
        <tbody>{places.map((p) => <tr><td><strong>{p.n}</strong></td><td>{p.m2 ? money(p.m2) : "—"}</td><td>{pct(p.s.g10)}</td><td>{p.rent ? new Intl.NumberFormat("en-US", { style: "currency", currency: "EUR", minimumFractionDigits: 2 }).format(p.rent) : "—"}</td><td>{p.s.yield != null ? `${nf1.format(p.s.yield)}%` : "—"}</td><td>{p.s.mo ? `${pct(p.s.mo.c4)}, ${momentum(p.s.mo.w)}` : "—"}</td><td>{p.ly.sea != null ? `${nf1.format(p.ly.sea)}%` : "—"}</td></tr>)}</tbody></table>
      {main.s.cmp?.length && <p>Comparable places readers are shown next to {main.n}: {main.s.cmp.map((x: string) => PRICES.munis[x]?.n).join(", ")}.</p>}
      {main.ly.dom?.abroad && <p>In {main.n}, buyers with a tax address abroad paid a median {money(main.ly.dom.abroad)} per m², against {money(main.ly.dom.pt)} for buyers based in Portugal (INE, {`Q${layers.periods.dom.slice(-1)} ${layers.periods.dom.slice(0, 4)}`}).</p>}
      {d.extra === "northam" && <p>Demand from North America in the Algarve has been documented in the press: <a href="https://www.idealista.pt/en/news/node/65720" rel="noopener">idealista, “North Americans drive up property prices in the Algarve”</a> (September 2024, citing Savills).</p>}
      <p class="src">Source: INE, Estatísticas de preços da habitação ao nível local and Estatísticas de rendas da habitação ao nível local ({ql}); Census 2021; prices by buyer's tax domicile. Gross yield = median rent × 12 ÷ median price. Past values do not guarantee future values; official statistics, not a valuation.</p>
    </div></section>

    <section class="n"><div class="num">04<small>Your project</small></div><div>
      <h2>{d.extra === "prelaunch" ? "Empty pins, ready for your launch" : `${d.project}, exactly as readers would see it`}</h2>
      <p>The “New developments” layer shows partner projects only, as pins standing above the 3D map, each labelled “Sponsored”. The card gives the project, the developer, typologies and delivery as you publish them, the municipality's ten-year prices and rents next to it, the cost calculator and “Request information”.</p>
      <ul class="facts">{d.facts.map((f) => <li>{f}</li>)}</ul>
      <p class="src">{d.sources.map((s, i) => <><a href={s.u} rel="noopener">{s.t}</a>{i < d.sources.length - 1 && " · "}</>)}. Only what {d.developer} has published is used; nothing else is copied.</p>
    </div></section>

    <section class="n"><div class="num">05<small>The path</small></div><div>
      <h2>The path a buyer follows, and where questions become enquiries</h2>
      {eds.map((ed) => (
        <>
          <h3>{d.readers.filter((r) => r.ed === ed).map((r) => r.city).join(", ")}</h3>
          <ol class="steps">{JOURNEY.filter((cp) => !cp.high || d.budgets[d.budgets.length - 1] >= 1e6).map((cp) => (
            <li class={enquirySteps.has(cp.k) ? "e" : ""}><span>{c(`journey.cp.${cp.k}.h`, "en")}
              {(cp.k === "budget" || cp.k === "buy") && <span class="tag">your project card</span>}
              {enquirySteps.has(cp.k) && cp.k !== "budget" && cp.k !== "buy" && <span class="tag">partner enquiry</span>}
              {ed === "us" && cp.k === "finance" && <span class="small"> · FBAR and FATCA reporting of a Portuguese account</span>}
              {ed === "us" && cp.k === "sell" && <span class="small"> · US tax on a Portuguese sale, under the treaty</span>}
            </span></li>
          ))}</ol>
        </>
      ))}
      <p class="src">The path is the reader's country version of “Your path” on the site ({pathFor("en", eds[0], "journey")}); each answer cites its primary source.</p>
    </div></section>

    <section class="n"><div class="num">06<small>Your site</small></div><div>
      <h2>Your site, with our map inside it</h2>
      <p>The same map on your own pages, in your colour, centred on {main.n}, with your button on every place card. A neutral mock-up, not your site.</p>
      <div class="mock"><div class="bar"><b></b><b></b><b></b><span>your-website.com</span></div><div class="nav"><span>{d.developer}</span><span>Residences · Location · Contact</span></div>
        <div class="body"><h4>Where your budget goes further</h4>
          <iframe src={`/embed/map/en/?budget=${d.budgets[0]}&center=${d.center.join(",")}&demoproj=${d.token}&devs=1&accent=${encodeURIComponent(d.accent)}&cur=${firstCur}&cta=${encodeURIComponent(d.pins[0].url ?? "https://example.com")}&ctalabel=${encodeURIComponent("Request the brochure")}`} title="Embedded map" loading="lazy"></iframe>
        </div></div>
    </div></section>

    <section class="n"><div class="num">07<small>Monthly report</small></div><div>
      <h2>What you would receive each month</h2>
      <span class="illus">Illustrative example · not real data</span>
      <table><thead><tr><th>Edition</th><th>Pin and card views</th><th>Clicks to your site</th><th>Enquiries</th><th>Budget of enquiries</th></tr></thead>
        <tbody>{d.readers.map((r, i) => <tr><td>{r.country}</td><td>{nf.format([1840, 1210, 760][i] ?? 600)}</td><td>{nf.format([96, 61, 38][i] ?? 30)}</td><td>{[7, 4, 3][i] ?? 2}</td><td>{money(d.budgets[Math.min(i, d.budgets.length - 1)])} and above</td></tr>)}</tbody></table>
      <p class="src">Sent automatically on the first working day of the month, by edition: placements seen, clicks, enquiries by country and budget. Sponsorship is always labelled; a flat annual fee, never a fee per contact.</p>
    </div></section>
  </main>
  <footer><div class="wrap">Private demo prepared for {d.developer} · not published. Data: INE (CC BY 4.0), ECB, © OpenStreetMap contributors. Imóveis Portugal.</div></footer>
</body>
</html>
