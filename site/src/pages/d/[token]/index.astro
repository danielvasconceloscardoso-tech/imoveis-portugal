---
// Private developer demo v2 (prompt 28 §4, D53, D54; D51 English; D50 register): one unlisted page per developer, in
// the film's order: their image, the map, the buyer and their budget, the place in three numbers, their homes with
// prices as published, a private viewing with the buyer's team and the qualified enquiry, their own website, and the
// monthly report. Market figures are INE's with their periods; homes, prices and images are the developer's own.
import Demo from "../../../layouts/Demo.astro";
import DemoEnquiry from "../../../components/DemoEnquiry.astro";
import { walkSteps } from "../../../lib/demowalk";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { DEMOS, rateOf } from "../../../lib/demos";
import { demoProjects, img } from "../../../lib/projects";
import { PRICES, LAST } from "../../../lib/prices";
import { FACTS } from "../../../lib/content";
import { purchase } from "../../../lib/sims";

export function getStaticPaths() { return DEMOS.map((d) => ({ params: { token: d.token } })); }
const d = DEMOS.find((x) => x.token === Astro.params.token)!;
const layers = JSON.parse(readFileSync(join(process.cwd(), "public", "data", "map", "layers.json"), "utf8"));
const nf = new Intl.NumberFormat("en-US"), nf1 = new Intl.NumberFormat("en-US", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const money = (v: number, cur = "EUR") => new Intl.NumberFormat("en-US", { style: "currency", currency: cur, maximumFractionDigits: 0 }).format(v);
const q = PRICES.quarters[LAST], ql = `Q${q.slice(-1)} ${q.slice(0, 4)}`;
const s = PRICES.munis[d.muni] as any, ly = layers.munis[d.muni] ?? {};
const m2 = s.m2[LAST] as number, rent = s.rq?.[LAST] as number | null;
const ps = demoProjects(d.token).filter((p) => p.units?.length);
const main = ps.filter((p) => p.muni === d.muni);
const homes = main.flatMap((p) => p.units!.map((u) => ({ p, u }))).slice(0, 6);
const pick = ps.flatMap((p) => p.units!.map((u) => ({ p, u }))).find((x) => x.u.id === d.home)!;
const cost = pick.u.price ? purchase(pick.u.price, false, false, false) : null;
const others = ps.filter((p) => p.muni !== d.muni);
const curs = [...new Set(["EUR", ...d.readers.map((r) => r.cur)])];
const fxDate = FACTS["ecb-eur-usd"]?.checked_on ?? "";
const local = (v: number) => (d.buyer.cur === "EUR" ? "" : money(Math.round(v * rateOf(d.buyer.cur) / 1000) * 1000, d.buyer.cur));
const embed = `/embed/map/en/?budget=${d.budgets[0]}&place=${d.muni}&center=${d.center.join(",")}&demoproj=${d.token}&devs=1&cur=${d.buyer.cur}`;
const sources = [...new Set(ps.flatMap((p) => p.sources ?? []))];
const checked = ps.map((p) => p.checked).filter(Boolean).sort().pop();
const steps = walkSteps(d);
---
<Demo title={`Private preview · ${d.developer} · Imóveis Portugal`} developer={d.developer} accent={d.accent}>
  <style is:global>
    .dp-cover img { width: 100%; height: min(78vh, 820px); object-fit: cover; display: block; }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
    .dp-head { padding: 48px 24px 24px; max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: end; }
    .dp-head h1 { font: 400 clamp(2.6rem, 2rem + 3vw, 4.6rem)/1.02 var(--serif); margin: 0; letter-spacing: -.01em; }
    .flag { font: 500 12px/1 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
    .lede { font-size: 1.1rem; color: #2b2d31; margin: 0; } .credit { font-size: 12px; color: var(--muted); padding: 6px 24px 0; max-width: 1120px; margin: 0 auto; }
    section.n { border-top: 1px solid var(--ink); padding: 40px 0 56px; display: grid; grid-template-columns: 200px 1fr; gap: 32px; }
    .num { font: 400 3.2rem/1 var(--serif); color: var(--accent); } .num small { display: block; font: 500 12px/1.4 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-top: 10px; }
    h2 { font: 400 2rem/1.15 var(--serif); margin: 0 0 14px; }
    table { width: 100%; border-collapse: collapse; font-size: 15px; } th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--rule); vertical-align: top; } th { font-weight: 500; color: var(--muted); font-size: 13px; }
    .big { font: 400 2.2rem/1 var(--serif); }
    .concierge { font: 400 clamp(2rem, 1.4rem + 2.4vw, 3.2rem)/1.15 var(--serif); margin: 0 0 18px; }
    .three { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin: 8px 0 16px; } .three b { display: block; font: 400 clamp(2.4rem, 1.8rem + 2.4vw, 3.8rem)/1 var(--serif); } .three span { font-size: 14px; color: var(--muted); }
    .grid3 { list-style: none; padding: 0; margin: 0 0 16px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .grid3 a { text-decoration: none; display: grid; gap: 4px; } .grid3 img { width: 100%; height: auto; aspect-ratio: 10 / 7; object-fit: cover; margin-bottom: 8px; }
    .grid3 .t { font: 400 1.2rem/1.2 var(--serif); } .grid3 .m { font-size: 14px; color: var(--muted); } .grid3 .pr { font-weight: 500; }
    .go { font: 500 13px/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; }
    iframe { width: 100%; height: 720px; border: 0; display: block; } .frame { border: 1px solid var(--rule); }
    .mock { border: 1px solid #d9d9d6; border-radius: 6px; overflow: hidden; } .mock .bar { display: flex; gap: 8px; align-items: center; padding: 10px 14px; background: #f4f4f2; font-size: 13px; color: var(--muted); }
    .mock .bar b { width: 10px; height: 10px; border-radius: 50%; background: #d1d1cd; display: inline-block; } .mock .nav { display: flex; justify-content: space-between; padding: 18px 24px; border-bottom: 1px solid var(--rule); font: 500 15px/1 var(--sans); }
    .mock .nav span:first-child { font-family: var(--serif); font-size: 20px; } .mock .body { padding: 24px; } .mock h4 { font: 400 1.8rem/1.2 var(--serif); margin: 0 0 12px; }
    .illus { display: inline-block; font: 500 12px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; border: 1px solid var(--ink); padding: 6px 8px; margin-bottom: 14px; }
    .panel { background: #f6f5f2; padding: 20px 22px; margin: 18px 0; } .panel p { margin: 0 0 8px; } .panel .l { font: 400 1.3rem/1.45 var(--serif); }
    .small, .src { font-size: 13px; color: var(--muted); } .src a { color: var(--muted); word-break: break-all; }
    .final { text-align: center; padding: 96px 24px; border-top: 1px solid var(--ink); } .final p { font: 400 clamp(2.2rem, 1.6rem + 2.6vw, 3.8rem)/1.1 var(--serif); margin: 0 0 18px; }
    .how { border-top: 1px solid var(--ink); padding: 40px 0 56px; } .how h2 { font-size: 2.4rem; }
    .how ol { list-style: none; margin: 24px 0 0; padding: 0; display: grid; grid-template-columns: repeat(7, minmax(220px, 1fr)); gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px; }
    .how li { scroll-snap-align: start; display: grid; gap: 8px; align-content: start; } .how img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border: 1px solid var(--rule); }
    .how .sn { font: 400 1.6rem/1 var(--serif); color: var(--accent); } .how .sh { font: 500 15px/1.3 var(--sans); } .how .sl { font: italic 400 1.02rem/1.4 var(--serif); color: #3c3f44; }
    .walk { display: inline-block; margin-top: 18px; background: var(--ink); color: #fff; text-decoration: none; padding: 16px 26px; font: 500 14px/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; }
    .how .mail { margin-top: 40px; }
    @media (max-width: 820px) { .how ol { grid-template-columns: 1fr; overflow: visible; } }
    @media (max-width: 820px) { .dp-head, section.n { grid-template-columns: 1fr; } .three, .grid3 { grid-template-columns: 1fr; } iframe { height: 600px; } }
  </style>

  <figure class="dp-cover" style="margin:0"><img src={d.render} alt={d.project} width="1600" height="900" fetchpriority="high" /></figure>
  <p class="credit">{d.credit}. Shown only in this private preview.</p>
  <div class="dp-head">
    <div><p class="flag">Prepared for {d.developer} · private preview</p><h1>{d.project}, seen by the buyers who live abroad</h1></div>
    <p class="lede">Imóveis Portugal is a guide and weekly newsletter for people in {d.readers.map((r) => r.country).filter((v, i, a) => a.indexOf(v) === i).join(", ")} and four more countries who are preparing to buy in Portugal. This preview follows one of them, from the map to a private viewing of one of your homes.</p>
  </div>

  <main class="wrap">
    <section class="how" id="how" aria-labelledby="how-h">
      <h2 id="how-h">How a buyer reaches you</h2>
      <p class="lede">Seven steps, on the real site, for {d.buyer.line.replace(/^A /, "a ").replace(/\.$/, "")} with {d.buyer.words.replace(/\.$/, "").toLowerCase()} <span class="small">(an illustrative buyer)</span>.</p>
      <ol>{steps.map((st) => <li><span class="sn">{String(st.n).padStart(2, "0")}</span><img src={`/d/${d.token}/steps/step-${st.n}.webp`} alt="" width="1440" height="900" loading="lazy" /><span class="sh">{st.h}</span><span class="sl">“{st.line}”</span></li>)}</ol>
      <a class="walk" href={steps[0].url}>Walk the path as this buyer</a>
      <div class="mail"><DemoEnquiry d={d} /></div>
    </section>




    <section class="n"><div class="num">01<small>The place</small></div><div>
      <h2>{s.n}, in three numbers</h2>
      <div class="three">
        <div><b>{nf.format(Math.round(d.budgets[0] / m2))} m²</b><span>for {money(d.buyer.amount, d.buyer.cur)}, at the median price of homes sold</span></div>
        <div><b>{s.g10 > 0 ? "+" : ""}{Math.round(s.g10)}%</b><span>price per m² since 2016</span></div>
        <div><b>{nf1.format(s.yield)}%</b><span>gross rental yield</span></div>
      </div>
      <p class="small">Median {money(m2)} per m²{rent ? `, rent ${new Intl.NumberFormat("en-US", { style: "currency", currency: "EUR", minimumFractionDigits: 2 }).format(rent)} per m² a month` : ""}{ly.dom?.abroad ? `; buyers with a tax address abroad paid a median ${money(ly.dom.abroad)} per m²` : ""}.</p>
      {d.extra === "northam" && <p class="small">Demand from North America in the Algarve has been documented in the press: <a href="https://www.idealista.pt/en/news/node/65720" rel="noopener">idealista, September 2024, citing Savills</a>.</p>}
      <p class="src">INE, {ql}: median value per m² of homes sold (last 12 months), rents of new leases; gross yield = rent × 12 ÷ price. Past values do not guarantee future values; official statistics, not a valuation.</p>
    </div></section>

    <section class="n"><div class="num">02<small>Your homes</small></div><div>
      <h2>Partner developers here: {d.developer}</h2>
      <p>From the place card, readers open your showcase: your homes, your images and your prices as you publish them, each with the cost of buying it and “Arrange a private viewing”.</p>
      <ul class="grid3">{homes.map(({ p, u }, i) => <li><a href={`/d/${d.token}/home/${u.id}/`}><img src={img(u.img ?? (p.gallery?.length ? p.gallery[i % p.gallery.length] : p.render), 800)} alt="" width="800" height="560" loading="lazy" /><span class="t">{u.typology}</span><span class="m">{u.area != null && `${nf.format(u.area)} m²`} · {p.name}</span><span class="pr">{u.price ? (u.priceNote === "from" ? `From ${money(u.price)}` : money(u.price)) : "Price on request"}</span></a></li>)}</ul>
      <p><a class="go" href={`/d/${d.token}/homes/`}>Open the showcase →</a>{others.map((p) => <> · <a class="go" href={`/d/${d.token}/homes/${p.muni}/`}>{p.name} →</a></>)}</p>
      <p class="src">Prices as published on {checked}; they may change. Sources are listed at the end.</p>
    </div></section>



    <section class="n"><div class="num">03<small>The map</small></div><div>
      <h2>Where your homes sit</h2>
      <p>The live map, with the budget in {d.buyer.cur}. Each of the 308 municipalities can be opened; the height shows the space the budget buys, from INE's prices.</p>
      <div class="frame"><iframe src={embed} title={`Map: ${s.n}`} loading="lazy"></iframe></div>
    </div></section>

    <section class="n" id="site"><div class="num">04<small>Your site</small></div><div>
      <h2>On your own website</h2>
      <p>The same map on your pages, in your colour, centred on {s.n}, with your button on every place card. A neutral mock-up, not your site.</p>
      <div class="mock"><div class="bar"><b></b><b></b><b></b><span>your-website.com</span></div><div class="nav"><span>{d.developer}</span><span>Residences · Location · Contact</span></div>
        <div class="body"><h4>Where your buyers' budgets go</h4>
          <iframe src={`/embed/map/en/?budget=${d.budgets[0]}&center=${[d.center[0], d.center[1], d.center[2] - 1.6].join(",")}&demoproj=${d.token}&devs=1&accent=${encodeURIComponent(d.accent)}&cur=${d.buyer.cur}&cta=${encodeURIComponent(pick.p.url ?? "https://example.com")}&ctalabel=${encodeURIComponent("Arrange a viewing")}`} title="Embedded map" loading="lazy"></iframe>
        </div></div>
    </div></section>

    <section class="n" id="report"><div class="num">05<small>Each month</small></div><div>
      <h2>What you receive, and how enquiries reach you</h2>
      <p>Each month, by edition: how often your showcase and homes were seen, clicks to your site, and the viewing requests with their readiness (cash or financing, timing, NIF). No figures are shown here: the site launches on 1 December 2026.</p>
      <h3 style="font:400 1.5rem/1.2 var(--serif);margin:32px 0 8px">How enquiries reach you</h3>
      <p>Each request arrives as a short, readable summary of what the buyer entered in the calculators, only if they choose to include it, and only to the partners they agreed may contact them. It is not a score: nothing is decided about the buyer from it.</p>
      <div class="panel"><p class="small">Format</p><p class="l">How they pay · when they are ready · NIF · total budget with taxes · own funds · indicative debt-to-income · where they live · the areas whose ten-year prices they looked at</p></div>

      <p class="src">Sent on the first working day of the month, by edition. Estimates are labelled indicative, not a credit assessment (GDPR art. 13 notice on the site); for high budgets the agency's identification and proof of funds still apply (Lei 83/2017). Sponsorship is always labelled; a flat annual fee, never a fee per contact.</p>
    </div></section>
  </main>

  <div class="final"><p>Your buyers, wherever they live.</p><span class="flag">Imóveis Portugal</span><p class="small" style="font:400 13px/1 var(--sans);margin-top:16px">Launching 1 December 2026</p></div>
  <div class="wrap" style="padding-bottom:40px"><p class="src">Homes, prices and images: {d.developer}, as published ({checked}). {d.sources.map((x) => x.t).join("; ")}. Item sources: {sources.map((u, i) => <>{i > 0 && " · "}<a href={u} rel="noopener">{u}</a></>)}</p></div>
</Demo>
