---
// A private demo's showcase (prompt 28 §2): the developer's homes in the demo's main municipality, as readers would see
// them once the developer is a partner. Reached from the map's place card ("Partner developers here").
import Demo from "../../../../layouts/Demo.astro";
import Showcase from "../../../../components/Showcase.astro";
import { DEMOS } from "../../../../lib/demos";
import { demoProjects } from "../../../../lib/projects";

export function getStaticPaths() { return DEMOS.map((d) => ({ params: { token: d.token } })); }
const d = DEMOS.find((x) => x.token === Astro.params.token)!;
const ps = demoProjects(d.token).filter((p) => p.muni === d.muni && p.units?.length);
---
<Demo title={`${d.developer} · private preview`} developer={d.developer} accent={d.accent}>
  <Showcase lang="en" locale="en-US" projects={ps} label="Sponsored" href={(p, u) => `/d/${d.token}/home/${u.id}/`} />
</Demo>
