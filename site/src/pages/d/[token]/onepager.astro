---
// One-page leave-behind per private demo (prompt 26 §2), A4 landscape, English, D50 register. Printed to PDF by
// scripts/demo-pdf.mjs into sponsors/demos/. Unlisted, noindex.
import "@fontsource-variable/playfair-display";
import "@fontsource-variable/jost";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { DEMOS } from "../../../lib/demos";
import { PRICES, LAST } from "../../../lib/prices";
import { RATE } from "../../../lib/content";

export function getStaticPaths() { return DEMOS.map((d) => ({ params: { token: d.token } })); }
const d = DEMOS.find((x) => x.token === Astro.params.token)!;
const layers = JSON.parse(readFileSync(join(process.cwd(), "public", "data", "map", "layers.json"), "utf8"));
const s = PRICES.munis[d.muni] as any, ly = layers.munis[d.muni] ?? {};
const nf1 = new Intl.NumberFormat("en-US", { minimumFractionDigits: 1, maximumFractionDigits: 1 }), nf = new Intl.NumberFormat("en-US");
const money = (v: number, cur = "EUR") => new Intl.NumberFormat("en-US", { style: "currency", currency: cur, maximumFractionDigits: 0 }).format(v);
const curs = [...new Set(["EUR", ...d.readers.map((r) => r.cur)])];
const rate = (k: string) => (k === "EUR" ? 1 : RATE(k as "USD").rate);
const q = PRICES.quarters[LAST], ql = `Q${q.slice(-1)} ${q.slice(0, 4)}`;
const m2 = s.m2[LAST] as number, rent = s.rq[LAST] as number | null;
const img = d.render ?? "/img/lisboa-anoitecer-castelo-1200.webp";
const figs: [string, string][] = [
  ["Median price per m², homes sold", money(m2)],
  ["Price change since 2016", s.g10 != null ? `+${nf.format(s.g10)}%` : "—"],
  ["Median rent per m² a month", rent ? `€${nf1.format(rent)}` : "—"],
  ["Gross rental yield", s.yield != null ? `${nf1.format(s.yield)}%` : "—"],
  ...(ly.dom?.abroad ? [["Buyers with a tax address abroad, per m²", money(ly.dom.abroad)] as [string, string]] : []),
  ...(ly.sea != null ? [["Seasonal homes (Census 2021)", `${nf1.format(ly.sea)}%`] as [string, string]] : []),
];
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="robots" content="noindex, nofollow" /><title>{d.developer} · Imóveis Portugal</title>
<style is:global>
  @page { size: A4 landscape; margin: 0; }
  * { box-sizing: border-box; } body { margin: 0; font: 400 10.5pt/1.45 "Jost Variable", sans-serif; color: #111214; background: #fff; }
  .page { width: 297mm; height: 210mm; padding: 14mm 15mm 11mm; display: grid; grid-template-rows: auto 1fr auto; gap: 8mm; }
  .top { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid #111214; padding-bottom: 4mm; }
  .brand { font: 500 14pt/1 "Playfair Display Variable", serif; } .brand i { display: inline-block; width: 6px; height: 6px; background: #1f4a3d; margin-right: 8px; vertical-align: middle; }
  .flag { font: 500 7.5pt/1 "Jost Variable"; letter-spacing: .14em; text-transform: uppercase; color: #5f6368; }
  .grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 9mm; min-height: 0; }
  h1 { font: 400 25pt/1.05 "Playfair Display Variable", serif; margin: 0 0 4mm; } h2 { font: 500 7.5pt/1 "Jost Variable"; letter-spacing: .14em; text-transform: uppercase; color: #5f6368; margin: 0 0 3mm; border-top: 1px solid #111214; padding-top: 2.5mm; }
  img { width: 100%; height: 52mm; object-fit: cover; display: block; } .credit { font-size: 7pt; color: #5f6368; margin: 1.5mm 0 4mm; }
  table { width: 100%; border-collapse: collapse; font-size: 9pt; } td, th { text-align: left; padding: 1.6mm 2.5mm 1.6mm 0; border-bottom: 1px solid #e6e6e3; } th { font-weight: 500; color: #5f6368; font-size: 7.5pt; }
  .big { font: 400 15pt/1 "Playfair Display Variable", serif; } ul { margin: 0; padding: 0; list-style: none; } li { padding: 1.6mm 0; border-bottom: 1px solid #e6e6e3; }
  li b { font-weight: 500; } .num { font: 400 13pt/1 "Playfair Display Variable", serif; color: #1f4a3d; margin-right: 3mm; }
  .foot { font-size: 7pt; color: #5f6368; display: flex; justify-content: space-between; gap: 8mm; border-top: 1px solid #e6e6e3; padding-top: 3mm; }
</style></head>
<body><div class="page">
  <div class="top"><span class="brand"><i></i>Imóveis Portugal</span><span class="flag">Private demo prepared for {d.developer} · not published</span></div>
  <div class="grid">
    <div>
      <img src={img} alt="" /><p class="credit">{d.credit ? `${d.credit}. Shown only in this private demo.` : "Lisbon. Your projects are not public yet: the pins wait for them."}</p>
      <h1>{d.extra === "prelaunch" ? "Your launch audience, already abroad" : `${d.project}, seen by buyers abroad`}</h1>
      <p>{d.where}. {d.facts[0]}.</p>
    </div>
    <div>
      <h2>Their budgets, in their currency</h2>
      <table><tr><th>Budget</th>{curs.slice(1).map((k) => <th>{k}</th>)}<th>m² in {s.n}</th></tr>
        {d.budgets.map((b) => <tr><td class="big">{money(b)}</td>{curs.slice(1).map((k) => <td>{money(Math.round(b * rate(k)), k)}</td>)}<td>{nf.format(Math.round(b / m2))} m²</td></tr>)}</table>
      <h2 style="margin-top:6mm">{s.n} in official figures</h2>
      <table>{figs.map(([k, v]) => <tr><td>{k}</td><td>{v}</td></tr>)}</table>
      <p class="credit">INE, {ql} unless stated. Past values do not guarantee future values; official statistics, not a valuation.</p>
    </div>
    <div>
      <h2>How you would appear</h2>
      <ul>
        <li><span class="num">01</span><b>On the map</b>: your project as a pin above the 3D map, labelled “Sponsored”, with its card and “Request information”.</li>
        <li><span class="num">02</span><b>On the path</b> of buyers from {d.readers.map((r) => r.country).filter((v, i, a) => a.indexOf(v) === i).join(", ")}: at the steps where questions become enquiries.</li>
        <li><span class="num">03</span><b>On your site</b>: the same map, in your colour, centred on your project, “Powered by Imóveis Portugal”.</li>
        <li><span class="num">04</span><b>Every month</b>: placements seen, clicks and enquiries by country and budget.</li>
      </ul>
      <h2 style="margin-top:6mm">The demo</h2>
      <p>The full demo, with the live map and a 70-second walkthrough, is at a private link we send you on request. Sponsorship is always labelled, for a flat annual fee, never a fee per contact.</p>
      <p><b>ops@imoveisportugal.lu</b></p>
    </div>
  </div>
  <div class="foot"><span>Project facts: {d.sources.map((x) => x.t).join("; ")}.</span><span>Data: INE (CC BY 4.0) · ECB · © OpenStreetMap contributors</span></div>
</div></body></html>
