---
// One-page leave-behind per private demo v2 (prompt 28 §4), A4 landscape, English, D50 register: the film on paper.
// Their best image, the buyer and the place in three numbers, their homes with prices as published, the private
// viewing flow with the qualified summary, their own website, and the illustrative monthly report. Printed to PDF by
// scripts/demo-pdf.mjs into sponsors/demos/. Unlisted, noindex.
import "@fontsource-variable/playfair-display";
import "@fontsource-variable/jost";
import { DEMOS } from "../../../lib/demos";
import { demoBuyer } from "../../../lib/demobuyer";
import { demoProjects, img } from "../../../lib/projects";
import { PRICES, LAST } from "../../../lib/prices";
import { walkSteps } from "../../../lib/demowalk";

export function getStaticPaths() { return DEMOS.map((d) => ({ params: { token: d.token } })); }
const d = DEMOS.find((x) => x.token === Astro.params.token)!;
const s = PRICES.munis[d.muni] as any, m2 = s.m2[LAST] as number;
const nf = new Intl.NumberFormat("en-US"), nf1 = new Intl.NumberFormat("en-US", { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const money = (v: number, cur = "EUR") => new Intl.NumberFormat("en-US", { style: "currency", currency: cur, maximumFractionDigits: 0 }).format(v);
const q = PRICES.quarters[LAST], ql = `Q${q.slice(-1)} ${q.slice(0, 4)}`;
const ps = demoProjects(d.token).filter((p) => p.units?.length);
const rows = ps.filter((p) => p.muni === d.muni).flatMap((p) => p.units!.map((u) => ({ p, u }))).slice(0, 5);
const { pick, total, line } = demoBuyer(d);
const checked = ps.map((p) => p.checked).filter(Boolean).sort().pop();
const steps = walkSteps(d);
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="robots" content="noindex, nofollow" /><title>{d.developer} · Imóveis Portugal</title>
<style is:global>
  @page { size: A4 landscape; margin: 0; }
  * { box-sizing: border-box; } body { margin: 0; font: 400 9.5pt/1.42 "Jost Variable", sans-serif; color: #111214; background: #fff; }
  .page { width: 297mm; height: 210mm; overflow: hidden; display: grid; grid-template-columns: 96mm 1fr; }
  .cover { position: relative; } .cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cover .t { position: absolute; left: 0; right: 0; bottom: 0; padding: 10mm 9mm 9mm; color: #fff; background: linear-gradient(transparent, rgba(0,0,0,.72)); }
  .cover .k { font: 500 7pt/1 "Jost Variable"; letter-spacing: .16em; text-transform: uppercase; opacity: .9; }
  .cover h1 { font: 400 22pt/1.05 "Playfair Display Variable", serif; margin: 3mm 0 2mm; } .cover .cr { font-size: 6.5pt; opacity: .8; }
  .body { padding: 9mm 10mm 7mm; display: grid; grid-template-rows: auto auto 1fr auto; gap: 4mm; }
  .strip { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2.2mm; } .strip div { font-size: 6.4pt; line-height: 1.25; }
  .strip img { width: 100%; height: 15mm; object-fit: cover; object-position: top; border: 1px solid #e6e6e3; display: block; margin-bottom: 1mm; }
  .strip b { display: block; font: 400 8pt/1.1 "Playfair Display Variable", serif; color: #1f4a3d; } .strip i { color: #5f6368; }
  .top { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid #111214; padding-bottom: 3mm; }
  .brand { font: 500 13pt/1 "Playfair Display Variable", serif; } .brand i { display: inline-block; width: 6px; height: 6px; background: #1f4a3d; margin-right: 8px; vertical-align: middle; }
  .flag { font: 500 7pt/1 "Jost Variable"; letter-spacing: .14em; text-transform: uppercase; color: #5f6368; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 8mm; min-height: 0; }
  h2 { font: 500 7pt/1 "Jost Variable"; letter-spacing: .14em; text-transform: uppercase; color: #5f6368; margin: 0 0 2.5mm; border-top: 1px solid #111214; padding-top: 2mm; }
  .buyer { font: 400 15pt/1.15 "Playfair Display Variable", serif; margin: 0 0 3mm; }
  .three { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3mm; margin-bottom: 4mm; } .three b { display: block; font: 400 17pt/1 "Playfair Display Variable", serif; } .three span { font-size: 7pt; color: #5f6368; }
  table { width: 100%; border-collapse: collapse; font-size: 8.5pt; } td, th { text-align: left; padding: 1.3mm 2mm 1.3mm 0; border-bottom: 1px solid #e6e6e3; } th { font-weight: 500; color: #5f6368; font-size: 7pt; } td.r, th.r { text-align: right; }
  ol.flow { margin: 0; padding: 0; list-style: none; counter-reset: f; } ol.flow li { counter-increment: f; padding: 1.4mm 0 1.4mm 8mm; position: relative; border-bottom: 1px solid #e6e6e3; }
  ol.flow li::before { content: counter(f, decimal-leading-zero); position: absolute; left: 0; font: 400 10pt/1.2 "Playfair Display Variable", serif; color: #1f4a3d; }
  .mail { background: #f6f5f2; padding: 3mm 3.5mm; margin: 2.5mm 0 0; } .mail p { margin: 0; } .mail .l { font: 400 10pt/1.4 "Playfair Display Variable", serif; margin: 1mm 0; }
  .illus { display: inline-block; font: 500 6pt/1 "Jost Variable"; letter-spacing: .12em; text-transform: uppercase; border: 1px solid #111214; padding: 1.2mm 1.6mm; margin: 0 0 2mm; }
  .s { font-size: 6.8pt; color: #5f6368; } p { margin: 0 0 2mm; }
  .foot { font-size: 6.3pt; color: #5f6368; border-top: 1px solid #e6e6e3; padding-top: 2mm; display: flex; justify-content: space-between; gap: 6mm; }
</style></head>
<body><div class="page">
  <div class="cover"><img src={d.render} alt="" /><div class="t"><span class="k">Prepared for {d.developer} · private preview</span><h1>{d.project}, seen by the buyers who live abroad</h1><span class="cr">{d.credit}. Shown only in this private preview.</span></div></div>
  <div class="body">
    <div class="top"><span class="brand"><i></i>Imóveis Portugal</span><span class="flag">Not published · English preview · launching 1 December 2026</span></div>
    <div><h2 style="margin-bottom:2mm">How a buyer reaches you</h2><div class="strip">{steps.map((st) => <div><img src={`/d/${d.token}/steps/step-${st.n}.webp`} alt="" /><b>{String(st.n).padStart(2, "0")} · {st.h}</b><i>“{st.line}”</i></div>)}</div></div>
    <div class="cols">
      <div>
        <h2>The buyer</h2>
        <p class="buyer">{d.buyer.line} {d.buyer.words}</p>
        <div class="three">
          <div><b>{nf.format(Math.round(d.budgets[0] / m2))} m²</b><span>in {s.n}, at the median price</span></div>
          <div><b>{s.g10 > 0 ? "+" : ""}{Math.round(s.g10)}%</b><span>price per m² since 2016</span></div>
          <div><b>{nf1.format(s.yield)}%</b><span>gross rental yield</span></div>
        </div>
        <p class="s">INE, {ql}. Past values do not guarantee future values; official statistics, not a valuation.</p>
        <h2 style="margin-top:3mm">Your homes, as you publish them</h2>
        <table><tr><th>Home</th><th class="r">m²</th><th class="r">Price</th></tr>
          {rows.map(({ p, u }) => <tr><td>{u.typology}{rows.some((x) => x.p !== rows[0].p) ? ` · ${p.name.replace(/^.*– /, "")}` : ""}</td><td class="r">{u.area != null ? nf.format(u.area) : "—"}</td><td class="r">{u.price ? `${u.priceNote === "from" ? "from " : ""}${money(u.price)}` : "on request"}</td></tr>)}</table>
        <p class="s" style="margin-top:1.5mm">Prices as published on {checked}. A showcase page reached from the map's place card (“Partner developers here”), each home with its cost of buying.</p>
      </div>
      <div>
        <h2>The enquiry you receive</h2>
        <p><b>{pick.u.typology}{pick.u.area != null && ` · ${nf.format(pick.u.area)} m²`}</b>, {money(pick.u.price ?? 0)}: with taxes and the deed, an indicative {money(total)}. You receive the enquiry already qualified:</p>
        <div class="mail"><span class="illus">Illustrative example</span><p class="l">{line}</p><p class="s">Indicative, not a credit assessment; nothing is decided about the buyer from it.</p></div>
        <h2 style="margin-top:4mm">On your website · each month</h2>
        <p>The same map on your pages, in your colour, centred on {s.n}: “Powered by Imóveis Portugal”.</p>
        <p>Each month, by edition: views of your showcase and homes, clicks to your site, viewing requests and their readiness. No figures before launch (1 December 2026).</p>
        <p class="s" style="margin-top:2mm">The full preview, with the live map and a one-minute film, is at a private link sent on request. Sponsorship is always labelled, for a flat annual fee, never a fee per contact. <b>ops@imoveisportugal.lu</b></p>
      </div>
    </div>
    <div class="foot"><span>Homes, prices and images: {d.developer}, as published; {d.sources.map((x) => x.t).join("; ")}.</span><span>Data: INE (CC BY 4.0) · ECB · © OpenStreetMap contributors</span></div>
  </div>
</div></body></html>
