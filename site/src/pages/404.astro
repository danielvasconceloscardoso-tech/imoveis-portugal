---
// Not-found page (wrangler.jsonc: not_found_handling "404-page"), in the three languages.
import "../styles/v2.css";
import { c } from "../lib/copy";
---
<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Imóveis Portugal</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="hd"><div class="frame"><a class="word" href="/">Imóveis Portugal</a></div></header>
    <main class="frame read" style="padding-top:64px;padding-bottom:96px">
      <h1>{c("root.notfound", "pt")}</h1>
      <p class="lede"><span lang="en">{c("root.notfound", "en")}</span> · <span lang="fr">{c("root.notfound", "fr")}</span></p>
      <a class="btn" href="/">Imóveis Portugal</a>
    </main>
  </body>
</html>
