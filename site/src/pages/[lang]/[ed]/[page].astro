---
// Every page other than the home: media kit, buyer request, how we work, privacy, legal notice, FAQ,
// talk to a partner and the free guide. Wording: content/copy/COPY_DECK.md.
import V2 from "../../../layouts/V2.astro";
import Embed from "../../../components/Embed.astro";
import Calls from "../../../components/Calls.astro";
import FaqPage from "../../../components/FaqPage.astro";
import TalkPage from "../../../components/TalkPage.astro";
import GuidePage from "../../../components/GuidePage.astro";
import SimsPage from "../../../components/SimsPage.astro";
import CasaPage from "../../../components/CasaPage.astro";
import DataPage from "../../../components/DataPage.astro";
import MapPage from "../../../components/MapPage.astro";
import PrivatePage from "../../../components/PrivatePage.astro";
import OursPage from "../../../components/OursPage.astro";
import JourneyPage from "../../../components/JourneyPage.astro";
import ConsultPage from "../../../components/ConsultPage.astro";
import DossierPage from "../../../components/DossierPage.astro";
import { PTYPES } from "../../../lib/packages";
import { config } from "../../../config";
import { ED_ORDER, LANGS, SLUGS, eur, pathFor, type EdCode, type Lang, type PageKey } from "../../../i18n";
import { homeFacts, fmtDate } from "../../../lib/content";
import { c, cl, edName } from "../../../lib/copy";

export function getStaticPaths() {
  const keys: PageKey[] = ["partners", "buy", "how", "privacy", "legal", "faq", "talk", "guide", "sims", "casa", "data", "map", "private", "ours", "journey", "consult", "dossiers"];
  return LANGS.flatMap((lang) => ED_ORDER.flatMap((ed) => keys.map((key) => ({ params: { lang, ed, page: SLUGS[lang][key] }, props: { key } }))));
}
const lang = Astro.params.lang as Lang;
const ed = Astro.params.ed as EdCode;
const { key } = Astro.props as { key: PageKey };
const e = (n: number) => eur(n, lang);
const used = config.foundingSlotsTotal - config.foundingSlotsLeft;
const ent = config.entity;
const ph = (v: string, label: string) => v || `[${label}]`;
const PH = { pt: ["Entidade", "Morada", "n.º de registo", "n.º de IVA"], en: ["Entity", "Address", "registration no.", "VAT no."], fr: ["Entité", "Adresse", "n° d'immatriculation", "n° de TVA"] }[lang];
const legalVars = { entity: ph(ent.name, PH[0]), address: ph(ent.address, PH[1]), register: ph(ent.register, PH[2]), vat: ph(ent.vat, PH[3]), email: config.contactEmail };
const legal = key === "privacy" || key === "legal" ? key : null;
const luN = new Intl.NumberFormat(lang === "en" ? "en" : lang === "fr" ? "fr" : "pt-PT").format(93659);

const titles: Partial<Record<PageKey, string>> = { partners: c("partners.title", lang), buy: c("buy.title", lang), how: c("how.title", lang), privacy: c("legal.privacy.title", lang), legal: c("legal.legal.title", lang) };
const descs: Partial<Record<PageKey, string>> = { partners: c("partners.lede", lang), buy: c("buy.lede", lang), how: c("how.lede", lang), privacy: c("legal.privacy.intro", lang), legal: c("legal.legal.intro", lang) };
const site = config.agency.website.replace(/^https:\/\/|\/$/g, "");
---
{key === "faq" ? <FaqPage lang={lang} ed={ed} /> : key === "sims" ? <SimsPage lang={lang} ed={ed} /> : key === "casa" ? <CasaPage lang={lang} ed={ed} /> : key === "data" ? <DataPage lang={lang} ed={ed} /> : key === "map" ? <MapPage lang={lang} ed={ed} /> : key === "private" ? <PrivatePage lang={lang} ed={ed} /> : key === "ours" ? <OursPage lang={lang} ed={ed} /> : key === "journey" ? <JourneyPage lang={lang} ed={ed} /> : key === "consult" ? <ConsultPage lang={lang} ed={ed} /> : key === "dossiers" ? <DossierPage lang={lang} ed={ed} /> : key === "talk" ? <TalkPage lang={lang} ed={ed} /> : key === "guide" ? <GuidePage lang={lang} ed={ed} /> : (
<V2 lang={lang} ed={ed} page={key} title={`${titles[key]} | Imóveis Portugal · ${edName(ed, lang)}`} description={descs[key] ?? ""}
  sticky={key === "partners" ? { href: "#contacto", label: c("partners.cta", lang) } : undefined}>
  {key === "partners" && (
    <>
      <section class="hero">
        <div class="frame grid">
          <div>
            <h1>{c("partners.h1", lang)}</h1>
            <p class="lede">{c("partners.lede", lang)}</p>
            <a class="btn" href="#contacto" data-primary>{c("partners.cta", lang)}</a>
          </div>
          <div class="offer">
            <h2>{c("partners.founding.h", lang)}</h2>
            <p>{c("partners.founding.p", lang)}</p>
            <div class="slots" aria-hidden="true">{Array.from({ length: config.foundingSlotsTotal }, (_, i) => <span class={i < used ? "taken" : ""}></span>)}</div>
            <p class="small" style="margin:0">{c("partners.slots", lang, { left: config.foundingSlotsLeft, total: config.foundingSlotsTotal, deadline: fmtDate(lang, config.foundingDeadline) })}</p>
          </div>
        </div>
      </section>
      <section class="band white" aria-labelledby="readers">
        <div class="frame split">
          <div><h2 id="readers">{c("partners.readers.h", lang)}</h2></div>
          <div><p class="lede">{c("partners.readers.p", lang)}</p><p>{c("partners.whynow.p", lang)}</p></div>
        </div>
      </section>
      <section class="band" aria-labelledby="packages">
        <div class="frame">
          <h2 id="packages">{c("partners.place.h", lang)}</h2>
          <ul class="ptypes">{["area", "checkpoint", "private", "launch"].map((k) => <li><span class="pl-h">{c(`partners.place.${k}.h`, lang)}</span><span class="pl-p">{c(`partners.place.${k}.p`, lang)}</span></li>)}</ul>
          <p class="lede" style="margin-top:20px">{c("partners.terms", lang)} <a href="#contacto">{c("partners.cta", lang)}</a></p>
          <p style="margin-top:24px;max-width:40em">{c("partners.network.p", lang)}</p>
          <h3 style="margin-top:40px">{c("kit.types.h", lang)}</h3>
          <ul class="ptypes">{PTYPES.map((t) => <li><a href={`${pathFor(lang, ed, "partners")}${t.slug[lang]}/`}>{c(`kit.${t.key}.label`, lang)}</a></li>)}</ul>
          <p><a class="more" href={pathFor(lang, ed, "ours")}>{c("ours.title", lang)}</a></p>
        </div>
      </section>
      <section class="band white" aria-labelledby="inventory">
        <div class="frame split">
          <div><h2 id="inventory">{c("partners.inventory.h", lang)}</h2></div>
          <div>
            <ul class="list" style="margin-top:0">{cl("partners.inventory", lang).map((r) => <li>{r}</li>)}</ul>
            <h3 style="margin-top:32px">{c("partners.why.h", lang)}</h3>
            <p>{c("partners.why.p", lang)}</p>
          </div>
        </div>
      </section>
      <section class="band" aria-labelledby="proof">
        <div class="frame split">
          <div><h2 id="proof">{c("partners.proof.h", lang)}</h2></div>
          <div><ul class="list" style="margin-top:0">{cl("partners.proof", lang, { n: luN }).map((r) => <li>{r}</li>)}</ul></div>
        </div>
      </section>
      <section class="band white" aria-labelledby="agency">
        <div class="frame split">
          <div><h2 id="agency">{config.agency.name}</h2></div>
          <div class="partner">
            <span class="tag">{c("common.gold", lang)}</span>
            <p style="margin:0">{c("partners.agency.p", lang)}</p>
            <p class="small" style="margin:0">AMI {config.agency.ami} · <a href={config.agency.website} rel="noopener">{site}</a></p>
          </div>
        </div>
      </section>
      <section class="band" aria-labelledby="rules">
        <div class="frame split">
          <div><h2 id="rules">{c("partners.rules.h", lang)}</h2></div>
          <div>
            <ul class="list" style="margin-top:0">{cl("partners.rules", lang).map((r) => <li>{r}</li>)}</ul>
            <h3 style="margin-top:32px">{c("partners.report.h", lang)}</h3>
            <p>{c("partners.report.p", lang)}</p>
            <p><a href={pathFor(lang, ed, "how")}>{c("common.nav.how", lang)}</a></p>
          </div>
        </div>
      </section>
      <section class="band white" id="contacto" aria-labelledby="cta">
        <div class="frame read">
          <h2 id="cta">{c("partners.cta", lang)}</h2>
          <p class="lede">{c("partners.form.intro", lang)}</p>
          {config.bookingUrl && <p><a class="btn" href={config.bookingUrl} rel="noopener">{c("partners.book", lang)}</a></p>}
          <Embed id={config.forms.sponsor[lang]} title={c("partners.cta", lang)} cta={c("partners.cta", lang)} subject={c("partners.cta", lang)} hidden={{ edition: ed, lang }} />
        </div>
      </section>
    </>
  )}

  {key === "buy" && (
    <div class="frame">
      <div class="ph read">
        <h1>{c("buy.h1", lang)}</h1>
        <p class="lede">{c("buy.lede", lang)}</p>
      </div>
      <div class="split" style="padding-bottom:64px">
        <div class="buy-form">
          <Embed id={config.forms.buyer[lang]} title={c("buy.h1", lang)} cta={c("buy.cta", lang)} subject={c("buy.h1", lang)} hidden={{ edition: ed, lang }} height={560} />
          <p class="small" style="margin-top:12px">{c("buy.small", lang)}{" "}<a href={pathFor(lang, ed, "privacy")}>{c("common.privacy", lang)}</a></p>
        </div>
        <div>
          <h2 class="h3" style="margin-bottom:16px">{c("buy.steps.h", lang)}</h2>
          <ol class="steps">{cl("buy.steps", lang).map((s) => <li>{s}</li>)}</ol>
          <div class="partner" style="margin-top:28px">
            <span class="tag">{c("common.gold", lang)}</span>
            <span class="logo">{config.agency.name}</span>
            <p class="small" style="margin:0">AMI {config.agency.ami} · <a href={config.agency.website} rel="noopener">{site}</a></p>
          </div>
          <Calls lang={lang} ed={ed} />
        </div>
      </div>
    </div>
  )}

  {key === "how" && (
    <div class="frame read prose">
      <div class="ph">
        <h1>{c("how.h1", lang)}</h1>
        <p class="lede">{c("how.lede", lang)}</p>
      </div>
      {[1, 2, 3, 4, 5, 6].map((i) => (<><h2>{c(`how.s${i}.h`, lang)}</h2><p>{c(`how.s${i}.p`, lang)}</p></>))}
      <h2>{c("how.example.h", lang)}</h2>
      <p>{c("how.example.p", lang)}</p>
      <ol class="notes" style="font-size:15px">
        {homeFacts(ed).map((f) => <li><a href={f.source_url} rel="noopener">{f.source_title}</a>{f.checked_on && `, ${c("common.checked", lang, { date: fmtDate(lang, f.checked_on) })}`}.</li>)}
      </ol>
      <h2>{c("how.contact.h", lang)}</h2>
      <p>{c("how.contact.p", lang)}{" "}<a href={`mailto:${config.contactEmail}`}>{config.contactEmail}</a></p>
    </div>
  )}

  {legal && (
    <div class="frame read prose">
      <div class="ph">
        <h1>{c(`legal.${legal}.h1`, lang)}</h1>
        <p class="lede">{c(`legal.${legal}.intro`, lang)}</p>
      </div>
      {!config.launchReady && <p class="draft">{c("legal.draft", lang)}</p>}
      {Array.from({ length: legal === "privacy" ? 6 : 4 }, (_, j) => j + 1).map((i) => (<><h2>{c(`legal.${legal}.${i}.h`, lang)}</h2><p>{c(`legal.${legal}.${i}.p`, lang, legalVars)}</p></>))}
    </div>
  )}
</V2>
)}
