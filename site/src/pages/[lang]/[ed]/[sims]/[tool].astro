---
// One page per calculator, under the calculators page: /pt/lu/simuladores/custo-total/ (prompts 12 and 13).
import Sim from "../../../../components/Sim.astro";
import { ED_ORDER, LANGS, SLUGS, type EdCode, type Lang } from "../../../../i18n";
import { SUB, ENABLED, type ToolKey } from "../../../../lib/tools";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => ED_ORDER.flatMap((ed) => ENABLED.map((tool) => ({ params: { lang, ed, sims: SLUGS[lang].sims, tool: SUB[tool][lang] }, props: { tool } }))));
}
const lang = Astro.params.lang as Lang;
const ed = Astro.params.ed as EdCode;
const { tool } = Astro.props as { tool: ToolKey };
---
<Sim lang={lang} ed={ed} tool={tool} enabled={ENABLED} />
