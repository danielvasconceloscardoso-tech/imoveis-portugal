---
// One 404 per edition and language (prompt 70): moved to /{lang}/{ed}/404.html after the build (astro.config.mjs).
import NotFound from "../../../components/NotFound.astro";
import { ED_ORDER, LANGS, type EdCode, type Lang } from "../../../i18n";
export function getStaticPaths() {
  return LANGS.flatMap((lang) => ED_ORDER.map((ed) => ({ params: { lang, ed } })));
}
const { lang, ed } = Astro.params as { lang: Lang; ed: EdCode };
---
<NotFound lang={lang} ed={ed} />
