---
// Edition home (prompt 32, design v2; prompt 43: five sections, the rest in articles). Wording: COPY_DECK.md "home2.*".
import V2 from "../../../layouts/V2.astro";
import HomeD2 from "../../../components/HomeD2.astro";
import { ED_ORDER, LANGS, type EdCode, type Lang } from "../../../i18n";
import { c, edName } from "../../../lib/copy";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => ED_ORDER.map((ed) => ({ params: { lang, ed } })));
}
const lang = Astro.params.lang as Lang;
const ed = Astro.params.ed as EdCode;
---
<V2 lang={lang} ed={ed} page="home" d2 title={`Imóveis Portugal · ${edName(ed, lang)}`} description={c("home2.lede", lang)}>
  <HomeD2 lang={lang} ed={ed} />
</V2>
