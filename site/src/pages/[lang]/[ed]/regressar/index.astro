---
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import LegacyRegressarPage from '../../../../components/LegacyRegressarPage.astro';
import { LANGS, ED_ORDER } from '../../../../i18n';
import { config } from '../../../../config';
export function getStaticPaths() {
  return LANGS.flatMap(lang => ED_ORDER.map(ed => ({ params: { lang, ed } })));
}
const { lang, ed } = Astro.params;
// Render the exact approved Portuguese prototype, keeping its inline code intact.
const approvedSimulator = lang === 'pt' ? readFileSync('public/previews/regressar-clear/index.html', 'utf8').replace(/data:(image\/webp|font\/woff2);base64,([A-Za-z0-9+/=]+)/g, (_uri, mime, encoded) => `/assets/regressar/${createHash('sha256').update(Buffer.from(encoded, 'base64')).digest('hex')}.${mime.split('/')[1]}`).replace('</head>', `<link rel="canonical" href="https://${config.primaryDomain}/pt/${ed}/regressar/"></head>`) : '';
---
{lang === 'pt' ? <Fragment set:html={approvedSimulator} /> : <LegacyRegressarPage />}
{/* Prompt 81: the approved Portuguese page keeps its file; only its place list is handed to the shared matching engine. */}
{lang === 'pt' && <script>import "../../../../scripts/regressar-pt-match";</script>}
