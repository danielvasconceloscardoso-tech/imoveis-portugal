---
import Regressar from '../../../../components/Regressar.astro';
import { LANGS, LANG_NAME, HTML_LANG, ED_ORDER, EDITIONS, pathFor, type Lang, type EdCode } from '../../../../i18n';
import { config } from '../../../../config';
import '@fontsource-variable/manrope/wght.css';
import '@fontsource-variable/playfair-display/wght.css';
import serif from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';
import sans from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
export function getStaticPaths() {
  return LANGS.flatMap(lang => ED_ORDER.map(ed => ({ params: { lang, ed } })));
}
const lang = Astro.params.lang as Lang;
const ed = Astro.params.ed as EdCode;
const title = {pt:'O seu rendimento. A sua vida em Portugal.',en:'Your income. Your life in Portugal.',fr:'Votre revenu. Votre vie au Portugal.'}[lang];
const labels = {
  pt: { home: 'Imóveis Portugal — início', language: 'Idioma', skip: 'Ir para o simulador', privacy: 'Privacidade', legal: 'Aviso legal', calculators: 'Simuladores', map: 'Mapa', related: 'Mais em Portugal' },
  en: { home: 'Imóveis Portugal — home', language: 'Language', skip: 'Skip to calculator', privacy: 'Privacy', legal: 'Legal notice', calculators: 'Calculators', map: 'Map', related: 'More in Portugal' },
  fr: { home: 'Imóveis Portugal — accueil', language: 'Langue', skip: 'Aller au simulateur', privacy: 'Confidentialité', legal: 'Mentions légales', calculators: 'Simulateurs', map: 'Carte', related: 'Plus au Portugal' },
}[lang];
const host = config.domainMode === 'primary' ? config.primaryDomain : EDITIONS[ed].domain;
const urlFor = (language: Lang) => `https://${host}/${language}/${ed}/regressar/`;
---
<!doctype html>
<html lang={lang === 'en' ? 'en-US' : HTML_LANG[lang]} class="regressar-document">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f6f3eb" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Imóveis Portugal</title>
    <meta name="description" content={title} />
    <link rel="canonical" href={urlFor(lang)} />
    {LANGS.map(language => <link rel="alternate" hreflang={language === 'en' ? 'en-US' : HTML_LANG[language]} href={urlFor(language)} />)}
    <link rel="preload" href={serif} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={`${title} | Imóveis Portugal`} />
    <meta property="og:description" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlFor(lang)} />
  </head>
  <body class="regressar-page">
    <a class="rx-skip" href="#rx-main">{labels.skip}</a>
    <header class="rx-masthead">
      <a class="rx-brand" href={pathFor(lang, ed, 'home')} aria-label={labels.home}>Imóveis Portugal<span aria-hidden="true">.</span></a>
      <nav class="rx-languages" aria-label={labels.language}>
        {LANGS.map(language => <a href={`/${language}/${ed}/regressar/`} lang={HTML_LANG[language]} aria-label={LANG_NAME[language]} aria-current={language === lang ? 'page' : undefined}>{language.toUpperCase()}</a>)}
      </nav>
    </header>
    <main id="rx-main"><Regressar lang={lang} ed={ed} /></main>
    <footer class="rx-site-footer"><a class="rx-footer-brand" href={pathFor(lang, ed, 'home')}>Imóveis Portugal</a><nav aria-label={labels.related}><a href={pathFor(lang, ed, 'map')}>{labels.map}</a><a href={pathFor(lang, ed, 'sims')}>{labels.calculators}</a><a href={pathFor(lang, ed, 'privacy')}>{labels.privacy}</a><a href={pathFor(lang, ed, 'legal')}>{labels.legal}</a></nav></footer>
  </body>
</html>

<style is:global>
  :root{color-scheme:light;background:#f6f3eb;color:#233d34;font-family:"Manrope Variable",Manrope,sans-serif;font-synthesis:none;-webkit-font-smoothing:antialiased}
  *{box-sizing:border-box}body{margin:0}button,input,select{font:inherit}button,a,input,select,summary{-webkit-tap-highlight-color:transparent}a{color:inherit}a:focus-visible,button:focus-visible,summary:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #ae7633;outline-offset:5px}main{display:block}button:disabled{cursor:default}img{max-width:100%}
  .rx-masthead{height:68px;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:0 clamp(22px,4vw,64px);border-bottom:1px solid #d7dcd0;background:#f6f3eb}
  .rx-brand{font:400 24px/1 "Playfair Display Variable",Georgia,serif;letter-spacing:-.04em;text-decoration:none;white-space:nowrap}.rx-brand span{color:#89724d}.rx-languages{display:flex;align-items:center;gap:4px}.rx-languages a{display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;font-size:10px;text-decoration:none;letter-spacing:.06em;color:#627168}.rx-languages a[aria-current=page]{color:#233d34;text-decoration:underline;text-underline-offset:7px}
  .rx-skip{position:absolute;left:20px;top:10px;padding:12px 18px;z-index:20;background:#233d34;color:#fff;transform:translateY(-180%);font-size:12px}.rx-skip:focus{transform:translateY(0)}
  .rx-site-footer{display:flex;justify-content:space-between;align-items:center;gap:25px;max-width:1240px;margin:auto;padding:28px 64px 40px;border-top:1px solid #d7dcd0}.rx-footer-brand{font:400 18px/1.4 "Playfair Display Variable",Georgia,serif;letter-spacing:-.025em;text-decoration:none}.rx-site-footer nav{display:flex;flex-wrap:wrap;gap:8px 25px}.rx-site-footer nav a{display:flex;align-items:center;min-height:44px;font-size:10px;text-decoration:none;color:#627168}.rx-site-footer nav a:hover{text-decoration:underline;text-underline-offset:4px}
  @media(max-width:760px){.rx-masthead{padding:0 20px;gap:8px}.rx-brand{font-size:21px}.rx-languages{gap:0}.rx-languages a{min-width:38px}.rx-site-footer{align-items:flex-start;flex-direction:column;padding:25px 25px 35px;gap:14px}.rx-site-footer nav{gap:5px 24px}.rx-site-footer nav a{font-size:11px}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
