---
// Pages already in direction C (D15): FAQ, free guide and "talk to a partner", in pt, en and fr (D18).
// Kept in their own route file so the old stylesheet (Base.astro) is not bundled with them.
import FaqPage from "../../../components/FaqPage.astro";
import TalkPage from "../../../components/TalkPage.astro";
import GuidePage from "../../../components/GuidePage.astro";
import { ED_ORDER, LANGS, SLUGS, type EdCode, type Lang } from "../../../i18n";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => ED_ORDER.flatMap((ed) => (["faq", "talk", "guide"] as const).map((key) => ({ params: { lang, ed, cpage: SLUGS[lang][key] }, props: { key } }))));
}
const lang = Astro.params.lang as Lang;
const ed = Astro.params.ed as EdCode;
const { key } = Astro.props as { key: "faq" | "talk" | "guide" };
---
{key === "faq" ? <FaqPage lang={lang} ed={ed} /> : key === "talk" ? <TalkPage lang={lang} ed={ed} /> : <GuidePage lang={lang} ed={ed} />}
