---
// Partner showcase on the site (prompt 28 §2, D53): /{lang}/{ed}/{partners}/{developer}/{municipality}/. Partner projects
// only (projects.json partner: true), labelled "Sponsored"; reached from the map's place card and the Partners page.
import V2 from "../../../../../../layouts/V2.astro";
import TrustStrip from "../../../../../../components/TrustStrip.astro";
import Showcase from "../../../../../../components/Showcase.astro";
import RequestSheet from "../../../../../../components/RequestSheet.astro";
import { LANGS, ED_ORDER, SLUGS, HTML_LANG, type Lang, type EdCode } from "../../../../../../i18n";
import { PROJECTS, HIDDEN, showcases, sameDeveloper, labelOf, rich, type Project } from "../../../../../../lib/projects";
import { RATE, EDITION_CUR } from "../../../../../../lib/content";
import { c } from "../../../../../../lib/copy";
import { PRICES } from "../../../../../../lib/prices";
import { pathFor } from "../../../../../../i18n";
import { SUB } from "../../../../../../lib/tools";
import { PTYPES } from "../../../../../../lib/packages";

export function getStaticPaths() {
  const live = LANGS.flatMap((lang) => ED_ORDER.flatMap((ed) => showcases(PROJECTS).map((ps) => ({
    params: { lang, ed, section: SLUGS[lang].partners, dev: ps[0].devSlug!, muni: ps[0].muni }, props: { ps } }))));
  // Prompt 66 §2: a partner switched off on the live site (pending) keeps its address: it opens the place on the map.
  const taken = new Set(live.map((x) => `${x.params.lang}/${x.params.ed}/${x.params.dev}/${x.params.muni}`));
  const gone = LANGS.flatMap((lang) => ED_ORDER.flatMap((ed) => showcases(HIDDEN).map((ps) => ({
    params: { lang, ed, section: SLUGS[lang].partners, dev: ps[0].devSlug!, muni: ps[0].muni }, props: { ps: [] as Project[], to: `${pathFor(lang, ed, "map")}?place=${ps[0].muni}` } })))
    .filter((x) => !taken.has(`${x.params.lang}/${x.params.ed}/${x.params.dev}/${x.params.muni}`)));
  return [...live, ...gone];
}
const lang = Astro.params.lang as Lang, ed = Astro.params.ed as EdCode;
const { to } = Astro.props as { to?: string };
if (to) return new Response(`<!doctype html><html lang="${lang}"><head><meta charset="utf-8"><meta name="robots" content="noindex"><meta http-equiv="refresh" content="0; url=${to}"><link rel="canonical" href="${to}"><title>Imóveis Portugal</title><script>location.replace(${JSON.stringify(to)} + location.hash)</script></head><body><p><a href="${to}">${to}</a></p></body></html>`, { headers: { "content-type": "text/html; charset=utf-8" } });
const { ps } = Astro.props as { ps: Project[] };
const base = `/${lang}/${ed}/${SLUGS[lang].partners}/${ps[0].devSlug}/${ps[0].muni}/`;
const k = EDITION_CUR[ed];
const title = c("show.title", lang, { developer: ps[0].developer, muni: (PRICES.munis[ps[0].muni] as any).n });
// Part 2 (3 Nov): the page ends on the private visit (the request sheet) where there is one, else on the Concierge with
// the project named; and a developer checking the page finds the way to the developers' page.
const muniName = (PRICES.munis[ps[0].muni] as any).n as string;
const next = rich(ps[0]) ? { kind: "req" as const, p: c("bar.next.show.p", lang), label: c("showb.visit", lang) }
  : { kind: "concierge" as const, p: c("bar.next.show.p", lang), href: `${pathFor(lang, ed, "consult")}?project=${encodeURIComponent(ps[0].name)}&place=${encodeURIComponent(muniName)}` };
const devPage = `${pathFor(lang, ed, "partners")}${PTYPES.find((t) => t.key === "developers")!.slug[lang]}/`;
// The same developer's showcases elsewhere (Marble Terrace Gondomar and Vila do Conde link to each other).
const related = sameDeveloper(PROJECTS, ps[0].devSlug, ps[0].muni).map((o) => ({ id: o[0].id, name: o[0].name, place: (PRICES.munis[o[0].muni] as any).n,
  href: `/${lang}/${ed}/${SLUGS[lang].partners}/${o[0].devSlug}/${o[0].muni}/`, render: o[0].render }));
---
<V2 lang={lang} ed={ed} page="partners" title={`${title} | Imóveis Portugal`} description={ps[0].line ?? title} paths={Object.fromEntries(LANGS.map((l) => [l, `/${l}/${ed}/${SLUGS[l].partners}/${ps[0].devSlug}/${ps[0].muni}/`])) as Record<Lang, string>} next={next}>
  <Showcase lang={lang} locale={HTML_LANG[lang]} projects={ps} label={labelOf(ps[0], lang, c("common.sponsored", lang))} href={(_, u) => `${base}${u.id}/`} cur={k ? { code: k, rate: RATE(k).rate } : undefined}
    simHref={`${pathFor(lang, ed, "sims")}${SUB.cost[lang]}/`} mapHref={`${pathFor(lang, ed, "map")}?place=${ps[0].muni}&devs=1`} save={{ href: base, muni: muniName }} related={related} share />
  {rich(ps[0]) && <RequestSheet lang={lang} ed={ed} project={ps[0]} />}
  <TrustStrip lang={lang} ed={ed} />
  <p class="sc-devs"><a href={devPage}>{c("bar.dev.forDevs", lang)} →</a></p>
</V2>
<style>
  .sc-devs { max-width: 1120px; margin: 0 auto; padding: 24px var(--gut, 24px) 0; font-size: 15px; }
  .sc-devs a { color: var(--muted); }
</style>
