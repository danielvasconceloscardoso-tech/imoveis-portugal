---
// Pages one level below a page key (prompts 12, 13 and 15): each calculator under the calculators page
// (/pt/lu/simuladores/custo-total/), the three paid dossiers under the dossiers page (prompt 21 §3, noindex, buy buttons
// off while config.dossiers.live is false), the Consulta privada confirmations, one page per municipality under the map (/pt/lu/mapa/porto/) and one page per partner type under
// the partners page (/pt/lu/parceiros/banca-privada/, prompt 18).
import Sim from "../../../../components/Sim.astro";
import PlacePage from "../../../../components/PlacePage.astro";
import PartnerTypePage from "../../../../components/PartnerTypePage.astro";
import ConsultPage from "../../../../components/ConsultPage.astro";
import { CONSULT_SUB } from "../../../../lib/consult";
import DossierPage from "../../../../components/DossierPage.astro";
import { DOSSIER_SUB, type DType } from "../../../../lib/dossiers";
import { PTYPES, type PType } from "../../../../lib/packages";
import { ED_ORDER, LANGS, SLUGS, type EdCode, type Lang } from "../../../../i18n";
import { SUB, ENABLED, type ToolKey } from "../../../../lib/tools";
import { PLACES, type Place } from "../../../../lib/places";
import ArticlePage from "../../../../components/ArticlePage.astro";
import { ARTS, ART_SUB, type ArtKey } from "../../../../lib/articles";

type Key = ToolKey;
export function getStaticPaths() {
  const keys: Key[] = [...ENABLED];
  return LANGS.flatMap((lang) => ED_ORDER.flatMap((ed) => [
    ...keys.map((tool) => ({ params: { lang, ed, section: SLUGS[lang].sims, sub: SUB[tool][lang] }, props: { tool } })),
    ...PLACES.map((place) => ({ params: { lang, ed, section: SLUGS[lang].map, sub: place.slug }, props: { place } })),
    ...PTYPES.map((ptype) => ({ params: { lang, ed, section: SLUGS[lang].partners, sub: ptype.slug[lang] }, props: { ptype } })),
    ...(["ok", "private", "later"] as const).map((view) => ({ params: { lang, ed, section: SLUGS[lang].consult, sub: CONSULT_SUB[view][lang] }, props: { view } })),
    ...ARTS.map((art) => ({ params: { lang, ed, section: SLUGS[lang].articles, sub: ART_SUB[art][lang] }, props: { art } })),
    ...(["compra", "zona", "private"] as const).map((dossier) => ({ params: { lang, ed, section: SLUGS[lang].dossiers, sub: DOSSIER_SUB[dossier][lang] }, props: { dossier } })),
  ]));
}
const lang = Astro.params.lang as Lang;
const ed = Astro.params.ed as EdCode;
const { tool, place, ptype, view, dossier, art } = Astro.props as { art?: ArtKey; tool?: Key; place?: Place; ptype?: PType; view?: "ok" | "private" | "later"; dossier?: DType };
---
{art ? <ArticlePage lang={lang} ed={ed} art={art} />
  : dossier ? <DossierPage lang={lang} ed={ed} type={dossier} />
  : view ? <ConsultPage lang={lang} ed={ed} view={view} />
  : ptype ? <PartnerTypePage lang={lang} ed={ed} type={ptype} />
  : place ? <PlacePage lang={lang} ed={ed} place={place} />
  : <Sim lang={lang} ed={ed} tool={tool!} enabled={ENABLED} />}
