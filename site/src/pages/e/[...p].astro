---
// Event pages for cookie-free counts (prompt 51 §3, lib/track.ts): each one is a load counted by Cloudflare Web
// Analytics, never shown to a reader, never indexed, absent from the sitemap. The path is the whole message:
//   /e/{ed}/flow/{flow}/start/   a reader answered the first question of a flow (concierge, partner, viewing, lawyer)
//   /e/{ed}/flow/{flow}/sent/    the request left with the reader's consent
//   /e/{ed}/p/{project}/{pin|card|req}/   a partner project's map pin opened, its Concierge card clicked, a request
//   /e/{ed}/p/{project}/{unit|filter|rel}/   on a showcase: a home's "I'm interested" in the unit table, the unit filter
//                                used, a "By the same developer" link followed (3 Nov 2026)
//   /e/s/{municipality}/         a place opened on the map (search or tap)
//   /e/q/{question}/             a question opened on Perguntas
//   /e/{ed}/sim1/{what}/{value}/ the one-screen simulator: slider band, region, type, use, payment, row opened, next step
//   /e/{ed}/bar/{k}/  /e/{ed}/nav/{k}/   a tap on the five (map, sims, concierge, path, faq; saved = the heart link):
//                                phone bar or desktop header (Part 2, 3 Nov)
//   /e/{ed}/next/{k}/            the closing next step of a page (concierge, back, req, map)
//   /e/{ed}/save/home/{id}/  /e/{ed}/unsave/home/{id}/   a home saved to or removed from "A sua seleção"
//   /e/save/region/{municipality}/  /e/unsave/region/{municipality}/   the same for a region
//   /e/{ed}/saved/go/            a saved item opened from "A sua seleção"
//   and every other event of the one schema (lib/track.ts ev, lib/events.ts): /e/{ed}/{event}/ (map layers, Passo a
//   passo stations, flow steps and stops, developer page views and shares, hearts, bottom bar, letter signups) and
//   /e/s/{municipality}/t/{band}/ (time on a place)
import { readFileSync } from "node:fs";
import { join } from "node:path";
import Beacon from "../../components/Beacon.astro";
import { ED_ORDER, LANGS } from "../../i18n";
import { faqFor } from "../../lib/content";
import { editionEvents, placeEvents } from "../../lib/events";
import { PROJECTS } from "../../lib/projects";
import { sim1Events } from "../../lib/sim1";

export function getStaticPaths() {
  const munis = Object.keys(JSON.parse(readFileSync(join(process.cwd(), "public", "data", "map", "layers.json"), "utf8")).munis);
  const qs = new Set<string>();
  for (const e of ED_ORDER) for (const l of LANGS) for (const it of faqFor(e, l)) qs.add(it.id);
  for (const l of LANGS) for (const x of ["sell-filing", "sell-heirs", "sell-cert"]) qs.add(`${l}-${x}`);
  const out: string[] = [];
  for (const e of [...ED_ORDER, "xx"]) {
    for (const f of ["concierge", "partner", "viewing", "lawyer"]) for (const s of ["start", "sent"]) out.push(`${e}/flow/${f}/${s}`);
    for (const p of PROJECTS) for (const k of ["pin", "card", "req"]) out.push(`${e}/p/${p.id}/${k}`);
    for (const s of sim1Events()) out.push(`${e}/sim1/${s}`);
    for (const k of ["map", "sims", "concierge", "path", "faq", "saved"]) out.push(`${e}/bar/${k}`, `${e}/nav/${k}`);
    for (const k of ["concierge", "back", "req", "map"]) out.push(`${e}/next/${k}`);
    for (const p of PROJECTS) for (const id of [p.id, ...(p.units ?? []).map((u) => `${p.id}-${u.id}`)]) if (/^[a-z0-9-]+$/.test(id)) out.push(`${e}/save/home/${id}`, `${e}/unsave/home/${id}`);
    out.push(`${e}/saved/go`);
    for (const p of PROJECTS) for (const k of ["pin", "card", "req", "unit", "filter", "rel"]) out.push(`${e}/p/${p.id}/${k}`);
  }
  for (const m of munis) out.push(`s/${m}`, `save/region/${m}`, `unsave/region/${m}`);
  const per = editionEvents(), times = placeEvents();
  for (const e of [...ED_ORDER, "xx"]) for (const s of per) out.push(`${e}/${s}`);
  for (const m of munis) { out.push(`s/${m}`); for (const t of times) out.push(`s/${m}/${t}`); }
  for (const q of qs) if (/^[a-z0-9-]+$/.test(q)) out.push(`q/${q}`);
  return [...new Set(out)].map((p) => ({ params: { p } }));
}
