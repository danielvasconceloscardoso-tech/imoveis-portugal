---
import V2 from "../../../../layouts/V2.astro";
import { editorialStories } from "../../../../lib/editorial-showcase";
import { ED_ORDER, type EdCode } from "../../../../i18n";
import { marked } from "marked";
export function getStaticPaths() {
  return ED_ORDER.flatMap((ed) => editorialStories.map((story) => ({ params: { ed, slug: story.slug }, props: { story } })));
}
const { ed } = Astro.params as { ed: EdCode };
const { story } = Astro.props;
const canonical = `https://imoveisportugal.pt/en/us/the-portugal-edit/${story.slug}/`;
---
<V2 lang="en" ed={ed} page="blog" title={`${story.title} | Imóveis Portugal`}
 description={story.description} canonicalUrl={canonical} ogType="article" next={false}>
 <article class="frame read prose post" style="padding-top:clamp(3rem,6vw,6rem);padding-bottom:5rem">
   <p class="small" style="margin-bottom:2.25rem"><a href={`/en/${ed}/the-portugal-edit/`}>The Portugal Edit</a> · {story.category}</p>
   <header class="ph" style="margin-bottom:2.5rem">
     <h1 style="max-width:19ch">{story.title}</h1>
     <p class="lede" style="max-width:56ch">{story.description}</p>
     <p class="small">Imóveis Portugal · November 5, 2026 · Independent editorial</p>
   </header>
   <div class="editorial-story-body"><Fragment set:html={marked.parse(story.body, { gfm: true, async: false }) as string}/></div>
   <footer class="small" style="margin-top:3.5rem;padding-top:1.25rem;border-top:1px solid currentColor">
     <a href={`/en/${ed}/the-portugal-edit/`}>Read more from The Portugal Edit</a> ·
     <a href={`/en/${ed}/map/`}>Explore Portugal on the map</a>
   </footer>
 </article>
</V2>