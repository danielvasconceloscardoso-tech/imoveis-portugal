---
type L="pt"|"en"|"fr";
const quizData: Record<string,{kind:"brief"|"escape", copies:Record<L,{eyebrow:string,subtitle:string,question:string,choices:[string,string,string],answer:string,correctTitle:string,incorrectTitle:string,sourceLabel:string,back:string,tryAgain:string,credit:string}>}> = {
  "2026-12-01": {
    kind:"brief",
    copies:{
      pt:{eyebrow:"MARÉ · THE BRIEF",subtitle:"1 DE DEZEMBRO · UM MINUTO DE HISTÓRIA",question:"Onde foi encontrado Miguel de Vasconcelos em 1640?",choices:["Numa capela","Num armário atrás de uma cortina","Numa embarcação"],answer:"A Assembleia da República relata que Miguel de Vasconcelos se escondera num armário, atrás de uma cortina, no Paço da Ribeira. O golpe de 1 de dezembro de 1640 abriu caminho à subida de D. João IV ao trono.",correctTitle:"Acertou. Que péssimo esconderijo.",incorrectTitle:"A resposta é mais inesperada.",sourceLabel:"Ver a fonte oficial",back:"Ler mais sobre Lisboa",tryAgain:"Responder novamente",credit:"A história merece o detalhe certo. O Parlamento português preserva-o."},
      en:{eyebrow:"MARÉ · THE BRIEF",subtitle:"DECEMBER 1 · A MOMENT IN HISTORY",question:"Where was Miguel de Vasconcelos discovered in 1640?",choices:["In a chapel","In a cupboard behind a curtain","On a boat"],answer:"Portugal's Parliament recounts that Miguel de Vasconcelos hid inside a cupboard, behind a curtain, at the Ribeira Palace. The events of December 1, 1640 opened the way for João IV to become king.",correctTitle:"Correct. A spectacularly bad hiding place.",incorrectTitle:"The answer is even more surprising.",sourceLabel:"Read the original source",back:"Read more about Lisbon",tryAgain:"Try again",credit:"Good stories deserve precise details. Portugal's Parliament preserves this one."},
      fr:{eyebrow:"MARÉ · THE BRIEF",subtitle:"1ER DÉCEMBRE · UN INSTANT D'HISTOIRE",question:"Où a-t-on retrouvé Miguel de Vasconcelos en 1640 ?",choices:["Dans une chapelle","Dans une armoire derrière un rideau","Sur un bateau"],answer:"Selon le Parlement portugais, Miguel de Vasconcelos s'était caché dans une armoire, derrière un rideau, au palais de la Ribeira. Les événements du 1er décembre 1640 ont ouvert la voie au règne de Jean IV.",correctTitle:"Bravo. Une bien mauvaise cachette.",incorrectTitle:"La réponse est plus étonnante.",sourceLabel:"Consulter la source officielle",back:"En savoir plus sur Lisbonne",tryAgain:"Recommencer",credit:"Les belles histoires méritent des détails exacts. Le Parlement portugais en conserve la trace."}
    }
  },
  "2026-12-04": {
    kind:"escape",
    copies:{
      pt:{eyebrow:"MARÉ · THE ESCAPE",subtitle:"4 DE DEZEMBRO · COMPORTA, ALÉM DAS PRAIAS",question:"Porque é que o cais da Carrasqueira tem passagens sobre estacas de madeira?",choices:["Para receber turistas","Para alcançar barcos na baixa-mar","Para regar os arrozais"],answer:"Os pescadores construíram as passagens nas décadas de 1950 e 1960 para chegarem aos barcos quando a maré baixa descobria o lodo. O cais ainda serve essa função.",correctTitle:"Exatamente. O melhor design resolve problemas.",incorrectTitle:"A resposta tem tudo a ver com a maré.",sourceLabel:"Consultar a Câmara de Alcácer do Sal",back:"Ver a Comporta no mapa",tryAgain:"Jogar novamente",credit:"Carrasqueira é um cais de trabalho. Respeite a atividade dos pescadores."},
      en:{eyebrow:"MARÉ · THE ESCAPE",subtitle:"DECEMBER 4 · BEYOND COMPORTA'S BEACHES",question:"Why are the wooden walkways at Carrasqueira built on stilts?",choices:["To welcome tourists","To reach boats at low tide","To irrigate rice fields"],answer:"In the 1950s and 1960s, fishermen built these paths to reach their boats when the tide retreated and exposed the mud. The pier still serves this practical purpose.",correctTitle:"That's it. The best design solves a problem.",incorrectTitle:"The secret is in the tide.",sourceLabel:"See the Alcácer do Sal municipality source",back:"See Comporta on the map",tryAgain:"Play again",credit:"Carrasqueira is a working fishing pier. Respect the community and its work."},
      fr:{eyebrow:"MARÉ · THE ESCAPE",subtitle:"4 DÉCEMBRE · COMPORTA, AU-DELÀ DES PLAGES",question:"Pourquoi le quai de Carrasqueira repose-t-il sur des pilotis ?",choices:["Pour les touristes","Pour atteindre les bateaux à marée basse","Pour irriguer les rizières"],answer:"Les pêcheurs ont construit les passerelles dans les années 1950 et 1960 pour rejoindre leurs bateaux quand la marée retirait l'eau et laissait apparaître la vase. Le quai remplit encore cette fonction.",correctTitle:"Exactement. Le beau design rend service.",incorrectTitle:"La réponse se trouve dans la marée.",sourceLabel:"Voir la source municipale",back:"Voir Comporta sur la carte",tryAgain:"Rejouer",credit:"Carrasqueira est un quai de pêche toujours utilisé. Respectons ce lieu de travail."}
    }
  }
};
export function getStaticPaths(){return Object.keys(quizData).map(issue=>({params:{issue},props:{item:quizData[issue],issue}}));}
const {item,issue}=Astro.props as {item:typeof quizData[string],issue:string};
const sourceUrl=issue==="2026-12-01"?"https://app.parlamento.pt/comunicar/Artigo.aspx?ID=1312":"https://cm-alcacerdosal.pt/locais/cais-palafitico-da-carrasqueira-2/";
const deepLink=issue==="2026-12-01"?"lisboa":"alcacer-do-sal";
const payload=JSON.stringify({copies:item.copies,sourceUrl,deepLink,correct:2}).replace(/</g,"\\u003c");
---
<!doctype html>
<html lang="pt">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
    <meta name="robots" content="noindex,nofollow"/>
    <meta name="theme-color" content="#213b36"/>
    <title>Maré · A pergunta da semana</title>
    <style>
      :root{--ink:#213b36;--orange:#ba693c;--cream:#f7f1e9;--muted:#63756e}*,*:before,*:after{box-sizing:border-box}html{background:var(--cream)}body{margin:0;min-height:100svh;color:var(--ink);font-family:Arial,Helvetica,sans-serif}button{font:inherit}.page{min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:clamp(20px,5vw,60px);position:relative;overflow:hidden}.page:before,.page:after{content:"";position:absolute;z-index:-1;border:1px solid #b7c1b9;border-radius:50%;width:90vw;height:90vw;min-width:600px;min-height:600px;opacity:.42;left:64%;top:35%;transform:rotate(-12deg)}.page:after{left:57%;top:42%;transform:rotate(17deg)}.top{width:min(100%,800px);display:flex;justify-content:space-between;align-items:start;gap:20px;margin-bottom:clamp(55px,10vw,110px)}.wordmark{font:400 clamp(32px,4vw,46px)/1 Georgia,serif;letter-spacing:-.045em}.tag{font-size:10px;letter-spacing:.15em;text-transform:uppercase;color:#496e58;font-weight:700}.languages{display:flex;gap:8px}.languages button{font-size:11px;cursor:pointer;padding:9px;border:1px solid #c9d2ca;background:transparent;color:var(--ink);border-radius:20px}.languages button[aria-pressed="true"]{color:white;background:var(--ink)}.core{width:min(100%,800px)}.edition{font-size:11px;letter-spacing:.16em;font-weight:700;margin:0 0 20px;color:var(--orange)}.sub{font-size:13px;color:var(--muted);line-height:1.5;margin:0 0 20px}.core h1{font:400 clamp(40px,6vw,76px)/1.04 Georgia,serif;letter-spacing:-.045em;max-width:15ch;margin:0 0 38px}.choices{display:grid;gap:9px}.choices button{padding:20px 22px;min-height:66px;text-align:left;display:flex;gap:22px;align-items:center;border:1px solid #c6d0c6;background:rgba(255,255,255,.55);color:var(--ink);cursor:pointer;transition:background .18s,transform .18s}.choices button:hover{background:#fff;transform:translateX(5px)}.choices strong{color:var(--orange);font-family:Georgia,serif;font-size:22px;font-weight:400}.choices button:focus-visible,.languages button:focus-visible,.try:focus-visible{outline:3px solid var(--orange);outline-offset:3px}.result{padding:30px 0 10px;margin-top:20px;border-top:1px solid #c6d0c6}.result[hidden]{display:none}.result h2{font:400 clamp(32px,4vw,46px)/1.08 Georgia,serif;letter-spacing:-.03em;margin:0 0 18px}.result p{font-size:17px;line-height:1.75;max-width:640px}.source{color:var(--orange);font-size:13px;font-weight:700;text-underline-offset:5px}.try{margin:25px 0 0;background:none;border:0;border-bottom:1px solid var(--ink);color:var(--ink);padding:8px 0;cursor:pointer;font-size:13px}.foot{width:min(100%,800px);margin-top:50px;font-size:11px;color:var(--muted);line-height:1.6}.escape{--orange:#94743b;--ink:#3b4635;--cream:#faf4e9}@media(max-width:600px){.top{margin-bottom:50px}.core h1{font-size:clamp(39px,11vw,62px)}.choices button{padding:15px}.result p{font-size:15px}}@media(prefers-reduced-motion:reduce){.choices button{transition:none}.choices button:hover{transform:none}}
    </style>
  </head>
  <body class:list={["page", item.kind === "escape" && "escape"]}>
    <header class="top"><div><div class="wordmark">Maré.</div><div class="tag" id="edition"></div></div><nav class="languages" aria-label="Language"><button type="button" data-lang="pt" aria-pressed="true">PT</button><button type="button" data-lang="en" aria-pressed="false">EN</button><button type="button" data-lang="fr" aria-pressed="false">FR</button></nav></header>
    <main class="core"><p id="subtitle" class="sub"></p><h1 id="question"></h1><div id="choices" class="choices"></div>
      <section id="result" class="result" hidden aria-live="polite"><h2 id="result-heading" tabindex="-1"></h2><p id="explanation"></p><p><a id="source-link" class="source" target="_blank" rel="noopener noreferrer"></a></p><p><a id="map-link" class="source"></a></p><button id="try" class="try" type="button"></button></section>
    </main><footer class="foot" id="credit"></footer>
    <script type="application/json" id="quiz-data" set:html={payload}/>
    <script is:inline>
      (()=>{const d=JSON.parse(document.getElementById("quiz-data").textContent),url=new URL(location.href);let lang=["pt","en","fr"].includes(url.searchParams.get("lang"))?url.searchParams.get("lang"):"pt";const $=id=>document.getElementById(id);function update(){const q=d.copies[lang];document.documentElement.lang=lang;document.title="Maré · "+q.question;$("edition").textContent=q.eyebrow;$("subtitle").textContent=q.subtitle;$("question").textContent=q.question;$("credit").textContent=q.credit;$("source-link").href=d.sourceUrl;$("source-link").textContent=q.sourceLabel;$("map-link").href="/"+lang+"/"+(lang==="fr"?"fr":lang==="en"?"us":"lu")+"/"+(lang==="fr"?"carte":lang==="en"?"map":"mapa")+"/?place="+d.deepLink;$("map-link").textContent=q.back;$("try").textContent=q.tryAgain;document.querySelectorAll("[data-lang]").forEach(b=>b.setAttribute("aria-pressed",String(b.dataset.lang===lang)));$("choices").replaceChildren();q.choices.forEach((choice,i)=>{const b=document.createElement("button");b.type="button";const n=document.createElement("strong");n.textContent="ABC"[i];const t=document.createElement("span");t.textContent=choice;b.append(n,t);b.addEventListener("click",()=>reveal(i+1));$("choices").appendChild(b)});const ans=Number(url.searchParams.get("answer"));if(ans>=1&&ans<=3)reveal(ans);else{$("result").hidden=true;$("choices").hidden=false}}function reveal(n){const q=d.copies[lang];$("result-heading").textContent=n===d.correct?q.correctTitle:q.incorrectTitle;$("explanation").textContent=q.answer;$("result").hidden=false;$("choices").hidden=true;$("result-heading").focus({preventScroll:true});url.searchParams.set("answer",String(n));url.searchParams.set("lang",lang);history.replaceState(null,"",url)}document.querySelectorAll("[data-lang]").forEach(b=>b.addEventListener("click",()=>{lang=b.dataset.lang;url.searchParams.set("lang",lang);history.replaceState(null,"",url);update()}));$("try").addEventListener("click",()=>{url.searchParams.delete("answer");history.replaceState(null,"",url);update()});update()})();
    </script>
  </body>
</html>