---
// Mobile-first Maré quiz proof of concept. All content and scoring in browser; no API, email or PII.
const first = "2026-12-01";
---
<!doctype html>
<html lang="pt-PT">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="robots" content="noindex,nofollow"/>
<title>Maré · Dez segundos de curiosidade</title>
<style>
:root{--ink:#273b35;--accent:#b05c3b;--paper:#f8f5ee;--muted:#6d776e;--rule:#d8d6cd}
*,*:before,*:after{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.65 system-ui,-apple-system,"Segoe UI",sans-serif}
main{max-width:690px;margin:auto;padding:clamp(30px,6vw,70px) clamp(22px,5vw,44px) 80px}a{color:inherit}.mast{font:400 45px/1 Georgia,serif;margin:0 0 52px;letter-spacing:-2px}.kicker{font-size:11px;text-transform:uppercase;letter-spacing:.18em;font-weight:750;color:var(--accent)}h1{font:400 clamp(39px,8vw,71px)/1.06 Georgia,serif;letter-spacing:-.045em;margin:18px 0 34px}.lede{font-size:15px;color:var(--muted);max-width:50ch}
.choices{display:grid;border-top:1px solid var(--rule);margin-top:45px}.choices button{padding:21px 0;border:0;border-bottom:1px solid var(--rule);text-align:left;background:transparent;display:flex;gap:25px;align-items:center;color:var(--ink);cursor:pointer;font:400 clamp(18px,4vw,25px)/1.2 Georgia,serif}.choices button span{font:750 11px/1 system-ui;letter-spacing:.1em;color:var(--accent);min-width:20px}
.choices button:hover,.choices button:focus-visible{background:#eee9df;padding-left:12px}.choices button:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.feedback{margin-top:36px;padding-top:26px;border-top:2px solid var(--accent)}.feedback[hidden]{display:none}.feedback h2{font:400 35px/1.12 Georgia,serif;margin:12px 0}.feedback p{max-width:60ch}.foot{margin-top:55px;display:flex;flex-wrap:wrap;gap:20px;font-size:12px}.foot a{text-underline-offset:5px}.muted{color:var(--muted)}.ribbon{height:4px;background:var(--accent);width:72px}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
</style>
</head>
<body><main><div class="ribbon" aria-hidden="true"></div><p class="mast">Maré<span style="color:var(--accent)">.</span></p>
<p id="edition" class="kicker">THE BRIEF · 1 DECEMBER 2026</p>
<h1 id="question">Where did Miguel de Vasconcelos hide?</h1><p id="lede" class="lede">Choose one answer. The explanation appears immediately; no email address or signup required.</p>
<div class="choices" role="group" aria-label="Quiz choices">
<button type="button" data-choice="0"><span>A</span><strong id="a">In the palace chapel</strong></button>
<button type="button" data-choice="1"><span>B</span><strong id="b">In a cupboard behind a curtain</strong></button>
<button type="button" data-choice="2"><span>C</span><strong id="c">On a boat</strong></button>
</div>
<section id="feedback" class="feedback" hidden aria-live="polite">
<p id="verdict" class="kicker"></p><h2 id="answer"></h2><p id="explanation"></p>
<a id="source" href="https://app.parlamento.pt/comunicar/Artigo.aspx?ID=1312" target="_blank" rel="noopener noreferrer">Primary source ↗</a>
</section>
<div class="foot"><a id="back" href="https://www.imoveisportugal.pt/pt/lu/mare/">Maré, back to the publication</a><span class="muted" id="privacy">No personal data is collected by this quiz.</span></div>
</main>
<script>
(()=>{const p=new URLSearchParams(location.search),lang=["pt","en","fr"].includes(p.get("lang"))?p.get("lang"):"pt",id=p.get("issue")==="2026-12-04"?"2026-12-04":"2026-12-01";
const d={
"2026-12-01":{
pt:{ed:"THE BRIEF · 1 DEZEMBRO 2026",q:"Onde se escondeu Miguel de Vasconcelos?",lead:"Escolha uma resposta. Receba já a explicação, sem inscrição.",options:["Na capela do palácio","Num armário atrás de uma cortina","Num barco"],right:"A história estava num armário.",explain:"A Assembleia da República conta que os conspiradores encontraram Miguel de Vasconcelos escondido num armário, atrás de uma cortina, no Paço da Ribeira, em 1640.",yes:"Acertou.",no:"Quase. A resposta certa é B.",source:"Ver fonte oficial ↗",back:"Voltar à Maré",privacy:"Sem recolha de dados pessoais neste jogo."},
en:{ed:"THE BRIEF · DECEMBER 1, 2026",q:"Where did Miguel de Vasconcelos hide?",lead:"Choose one. The answer appears instantly. No signup required.",options:["In the palace chapel","In a cupboard behind a curtain","On a boat"],right:"A story inside a cupboard.",explain:"Portugal's Parliament says the 1640 conspirators found Miguel de Vasconcelos hiding in a cupboard behind a curtain at Ribeira Palace.",yes:"Correct.",no:"Not quite. The answer is B.",source:"See the official source ↗",back:"Back to Maré",privacy:"No personal data is collected by this quiz."},
fr:{ed:"THE BRIEF · 1ER DÉCEMBRE 2026",q:"Où Miguel de Vasconcelos s'était-il caché ?",lead:"Une réponse, une découverte. Sans inscription.",options:["Dans la chapelle du palais","Dans une armoire derrière un rideau","Dans un bateau"],right:"Une histoire cachée dans une armoire.",explain:"Le Parlement portugais indique que les conjurés de 1640 ont trouvé Miguel de Vasconcelos dans une armoire, derrière un rideau, au palais de la Ribeira.",yes:"Exactement.",no:"La bonne réponse est B.",source:"Consulter la source officielle ↗",back:"Retour à Maré",privacy:"Aucune donnée personnelle n'est collectée par ce jeu."}},
"2026-12-04":{
pt:{ed:"THE ESCAPE · 4 DEZEMBRO 2026",q:"Porque foram construídos os passadiços da Carrasqueira?",lead:"A maré escondia o caminho. Consegue adivinhar a solução?",options:["Para visitantes passearem","Para chegar aos barcos na baixa-mar","Para irrigar os arrozais"],right:"A maré desce. O trabalho continua.",explain:"O cais de madeira permite aos pescadores chegar aos barcos quando as águas do estuário do Sado recuam. A Câmara de Alcácer do Sal confirma que ainda serve essa função.",yes:"Acertou.",no:"A resposta certa é B.",source:"Ver fonte municipal ↗",back:"Voltar à Maré",privacy:"Sem recolha de dados pessoais neste jogo."},
en:{ed:"THE ESCAPE · DECEMBER 4, 2026",q:"Why did Carrasqueira's fishermen build wooden walkways?",lead:"The tide disappears. The fishermen still need to work.",options:["For tourists to sightsee","To reach boats at low tide","To irrigate rice fields"],right:"The tide retreats. Work goes on.",explain:"The wooden pier lets fishermen reach their boats when the waters of the Sado estuary retreat. Alcácer do Sal municipality confirms that it still serves that purpose.",yes:"That's right.",no:"The answer is B.",source:"See the municipal source ↗",back:"Back to Maré",privacy:"No personal data is collected by this quiz."},
fr:{ed:"THE ESCAPE · 4 DÉCEMBRE 2026",q:"Pourquoi les pêcheurs de Carrasqueira ont-ils construit ces passerelles ?",lead:"La marée descend. Les pêcheurs doivent encore travailler.",options:["Pour les visiteurs","Pour rejoindre les bateaux à marée basse","Pour irriguer les rizières"],right:"La marée descend. Le travail continue.",explain:"Le quai de bois permet aux pêcheurs de rejoindre les bateaux lorsque l'eau de l'estuaire du Sado se retire. La municipalité d'Alcácer do Sal confirme cet usage.",yes:"Exactement.",no:"La bonne réponse est B.",source:"Voir la source municipale ↗",back:"Retour à Maré",privacy:"Aucune donnée personnelle n'est collectée par ce jeu."}}};
const x=d[id][lang],put=(key,value)=>document.getElementById(key).textContent=value;
document.documentElement.lang=lang==="pt"?"pt-PT":lang==="en"?"en-US":"fr-FR";
["edition","question","lede"].forEach((k,i)=>put(k,[x.ed,x.q,x.lead][i]));["a","b","c"].forEach((k,i)=>put(k,x.options[i]));
put("privacy",x.privacy);put("back",x.back);document.getElementById("back").href="/"+lang+"/"+(lang==="en"?"us":lang==="fr"?"fr":"lu")+"/mare/";
document.getElementById("source").href=id==="2026-12-01"?"https://app.parlamento.pt/comunicar/Artigo.aspx?ID=1312":"https://cm-alcacerdosal.pt/locais/cais-palafitico-da-carrasqueira-2/";
put("source",x.source);
document.querySelectorAll("[data-choice]").forEach(b=>b.addEventListener("click",()=>{const correct=Number(b.dataset.choice)===1;put("verdict",correct?x.yes:x.no);put("answer",x.right);put("explanation",x.explain);const sec=document.getElementById("feedback");sec.hidden=false;sec.scrollIntoView({block:"nearest",behavior:matchMedia("(prefers-reduced-motion: reduce)").matches?"instant":"smooth"})}));
const initial=Number(p.get("choice"));if(p.has("choice")&&Number.isInteger(initial)&&initial>=0&&initial<=2)document.querySelector('[data-choice="'+initial+'"]').click();
})();
</script></body></html>
