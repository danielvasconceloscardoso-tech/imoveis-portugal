---
// Maré's small, independent, accessible interaction layer. One source-backed reveal.
// Draft feature: do not include these links in outbound email until editorial and rights QA.
export function getStaticPaths() {
  return [{params:{date:"2026-12-01"}},{params:{date:"2026-12-04"}}];
}
const { date } = Astro.params;
const isBrief = date === "2026-12-01";
const title = isBrief ? "Uma janela na história" : "A beleza da necessidade";
---
<!doctype html>
<html lang="pt">
<head>
 <meta charset="utf-8"/>
 <meta name="viewport" content="width=device-width,initial-scale=1"/>
 <meta name="robots" content="noindex,follow"/>
 <meta name="color-scheme" content="light"/>
 <meta name="description" content="Um pequeno desafio da Maré, com resposta imediata, contexto histórico e fonte."/>
 <title>{title} · Maré</title>
 <style>
 :root{--ink:#203c35;--paper:#f7f4ed;--line:#cbc8bb;--orange:#af6541}*,*:before,*:after{box-sizing:border-box}
 body{margin:0;background:var(--paper);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",sans-serif}
 main{max-width:780px;margin:auto;padding:clamp(28px,6vw,72px) clamp(22px,5vw,60px) 100px}
 .mark{display:flex;align-items:center;justify-content:space-between;gap:15px;padding-bottom:24px;border-bottom:1px solid var(--line)}
 .brand{font:400 30px/1 Georgia,serif;letter-spacing:-.04em}.edition{text-transform:uppercase;letter-spacing:.12em;font-weight:650;font-size:10px;color:#59675d}
 .over{letter-spacing:.2em;text-transform:uppercase;color:var(--orange);font-size:11px;font-weight:750;margin:83px 0 26px}
 h1{font:400 clamp(3.2rem,7vw,5.8rem)/.98 Georgia,serif;letter-spacing:-.052em;margin:0 0 28px}
 .deck{font:400 clamp(1.05rem,2vw,1.3rem)/1.65 Georgia,serif;color:#4e6155;margin:0 0 50px}
 .choices{border-top:1px solid var(--line)}.choice{width:100%;padding:23px 14px 23px 0;display:flex;align-items:center;gap:16px;justify-content:space-between;text-align:left;background:transparent;border:0;border-bottom:1px solid var(--line);color:inherit;font:400 clamp(1.2rem,3.2vw,1.9rem)/1.25 Georgia,serif;cursor:pointer;transition:padding .2s}
 .choice:hover{padding-left:12px}.choice[aria-pressed=true]{padding-left:14px;background:#e7e9df}.choice small{font:800 11px/1.2 system-ui;color:var(--orange)}
 .result{margin-top:42px;padding:26px 0;border-top:2px solid var(--ink)}.result[hidden]{display:none}
 .result b{font-size:11px;letter-spacing:.17em;text-transform:uppercase;color:var(--orange)}
 .result h2{font:400 clamp(2.1rem,5vw,3.3rem)/1.1 Georgia,serif;letter-spacing:-.03em;margin:15px 0}
 .result p{font:400 18px/1.65 Georgia,serif}.result a,.foot a{color:var(--ink);text-decoration-thickness:1px;text-underline-offset:5px}
 .foot{border-top:1px solid var(--line);margin-top:75px;padding-top:25px;color:#55675c;font-size:13px;line-height:1.65}
 button:focus-visible,a:focus-visible{outline:3px solid var(--orange);outline-offset:5px}
 .reset{margin-top:12px;border:1px solid var(--ink);background:transparent;padding:12px 22px;color:inherit;cursor:pointer}
 @media(prefers-reduced-motion:reduce){.choice{transition:none}}
 </style>
</head>
<body>
 <main>
  <header class="mark"><a href="/pt/lu/mare/" class="brand" aria-label="Maré, página principal">Maré.</a><span class="edition" id="edition">THE BRIEF / THE ESCAPE</span></header>
  <p class="over" id="over">UM PEQUENO DESAFIO</p>
  <h1 id="question" tabindex="-1">Uma pergunta sobre Portugal.</h1>
  <p class="deck" id="deck">Escolha uma resposta. Mostramos já a explicação e a fonte.</p>
  <div class="choices" id="choices" aria-label="Escolhas de resposta"></div>
  <section class="result" id="result" aria-live="polite" aria-atomic="true" hidden>
    <b id="verdict"></b><h2 id="revealTitle"></h2><p id="explanation"></p>
    <p><a id="source" href="" target="_blank" rel="noopener noreferrer"></a></p>
    <button class="reset" id="again" type="button">Outra vez</button>
  </section>
  <footer class="foot"><p id="fine">Esta é uma experiência editorial independente, com fonte verificável. Não recolhemos nome nem email.</p><p><a href="/pt/lu/mare/" id="back">Voltar à Maré</a></p></footer>
 </main>
 <script is:inline define:vars={{isBrief}}>
  (function(){
  var brief={
    pt:{edition:"The Brief",over:"HISTÓRIA · 1640",question:"Onde se escondeu Miguel de Vasconcelos?",deck:"Uma revolução, um palácio em Lisboa e um esconderijo pouco eficaz.",options:["Na capela do palácio","Num armário atrás de uma cortina","Num barco no Tejo"],win:"Acertou.",lose:"A resposta é a B.",head:"Um armário atrás de uma cortina.",answer:"A narrativa publicada pela Assembleia da República conta que os conjurados encontraram o secretário de Estado num armário, atrás de uma cortina, durante os acontecimentos de 1 de dezembro de 1640.",source:"Ler a fonte histórica · Assembleia da República",again:"Tentar outra vez",fine:"Experiência editorial da Maré. Não é necessário criar uma conta nem fornecer dados pessoais.",back:"Voltar à Maré"},
    en:{edition:"The Brief",over:"HISTORY · 1640",question:"Where did Miguel de Vasconcelos hide?",deck:"A revolution, a royal palace in Lisbon, and a hiding place that offered little protection.",options:["In the palace chapel","In a cupboard behind a curtain","On a boat in the Tagus"],win:"You got it.",lose:"The answer is B.",head:"A cupboard behind a curtain.",answer:"Portugal's Parliament recounts that conspirators found the secretary of state hiding in a cupboard behind a curtain during the events of December 1, 1640.",source:"Read the historical source · Portugal's Parliament",again:"Try again",fine:"An independent editorial experience from Maré. No account or personal details are required.",back:"Back to Maré"},
    fr:{edition:"The Brief",over:"HISTOIRE · 1640",question:"Où Miguel de Vasconcelos s'était-il caché ?",deck:"Une révolution, un palais à Lisbonne et une cachette qui ne lui a pas porté chance.",options:["Dans la chapelle du palais","Dans une armoire derrière un rideau","À bord d'un bateau sur le Tage"],win:"Bonne réponse.",lose:"La réponse est B.",head:"Une armoire derrière un rideau.",answer:"Selon le récit publié par le Parlement portugais, les conjurés ont découvert le secrétaire d'État caché dans une armoire, derrière un rideau, lors des événements du 1er décembre 1640.",source:"Lire la source historique · Parlement portugais",again:"Recommencer",fine:"Une expérience éditoriale indépendante de Maré. Aucun compte ni renseignement personnel n'est nécessaire.",back:"Retour à Maré"}};
  var escape={
    pt:{edition:"The Escape",over:"COMPORTA · CARRASQUEIRA",question:"Para que serve este cais de madeira?",deck:"O Sado, a maré baixa e uma extraordinária solução feita por pescadores.",options:["Para os turistas passearem","Para chegar aos barcos na baixa-mar","Para levar água aos arrozais"],win:"Acertou.",lose:"A resposta é a B.",head:"Para chegar aos barcos na baixa-mar.",answer:"Os caminhos sobre estacas permitem chegar às embarcações quando a maré desce e deixa o lodo a descoberto. O cais continua a servir a comunidade piscatória.",source:"Ler a descrição oficial · Câmara de Alcácer do Sal",again:"Tentar outra vez",fine:"Experiência editorial da Maré. Não é necessário criar uma conta nem fornecer dados pessoais.",back:"Voltar à Maré"},
    en:{edition:"The Escape",over:"COMPORTA · CARRASQUEIRA",question:"Why was this wooden pier built?",deck:"The Sado estuary, low tide, and an extraordinary solution created by local fishermen.",options:["For tourists to take a walk","To reach boats at low tide","To channel water into rice fields"],win:"You got it.",lose:"The answer is B.",head:"To reach the boats at low tide.",answer:"The wooden walkways on stilts allow fishermen to reach their boats when the tide recedes and exposes the mud. The pier continues to serve the local fishing community.",source:"Read the official description · Alcácer do Sal Municipality",again:"Try again",fine:"An independent editorial experience from Maré. No account or personal details are required.",back:"Back to Maré"},
    fr:{edition:"The Escape",over:"COMPORTA · CARRASQUEIRA",question:"Pourquoi ce quai de bois a-t-il été construit ?",deck:"L'estuaire du Sado, la marée basse et l'ingéniosité des pêcheurs.",options:["Pour les promeneurs","Pour rejoindre les bateaux à marée basse","Pour irriguer les rizières"],win:"Bonne réponse.",lose:"La réponse est B.",head:"Pour rejoindre les bateaux à marée basse.",answer:"Les passerelles sur pilotis permettent d'atteindre les bateaux lorsque la marée descend et découvre la vase. Le quai sert toujours à la communauté des pêcheurs.",source:"Lire la description officielle · Municipalité d'Alcácer do Sal",again:"Recommencer",fine:"Une expérience éditoriale indépendante de Maré. Aucun compte ni renseignement personnel n'est nécessaire.",back:"Retour à Maré"}};
  var qs=new URLSearchParams(location.search);var lang=qs.get("lang");if(!["pt","en","fr"].includes(lang))lang="pt";
  document.documentElement.lang=lang==="pt"?"pt-PT":lang==="en"?"en-US":"fr-FR";
  var v=(isBrief?brief:escape)[lang],source=isBrief?"https://app.parlamento.pt/comunicar/Artigo.aspx?ID=1312":"https://cm-alcacerdosal.pt/locais/cais-palafitico-da-carrasqueira-2/";
  var id=x=>document.getElementById(x);
  id("edition").textContent=v.edition;id("over").textContent=v.over;id("question").textContent=v.question;id("deck").textContent=v.deck;id("fine").textContent=v.fine;id("back").textContent=v.back;id("back").href="/"+lang+"/lu/mare/";id("again").textContent=v.again;
  var choices=id("choices");
  v.options.forEach((option,i)=>{var b=document.createElement("button");b.type="button";b.className="choice";b.setAttribute("aria-pressed","false");b.innerHTML="<span></span><small>"+String.fromCharCode(65+i)+"</small>";b.querySelector("span").textContent=option;b.addEventListener("click",()=>reveal(i));choices.appendChild(b)});
  function reveal(i){var options=choices.querySelectorAll("button");options.forEach((b,k)=>b.setAttribute("aria-pressed",String(i===k)));id("verdict").textContent=i===1?v.win:v.lose;id("revealTitle").textContent=v.head;id("explanation").textContent=v.answer;id("source").textContent=v.source;id("source").href=source;id("result").hidden=false;id("revealTitle").setAttribute("tabindex","-1");id("revealTitle").focus(); }
  id("again").addEventListener("click",()=>{id("result").hidden=true;choices.querySelectorAll("button").forEach(b=>b.setAttribute("aria-pressed","false"));choices.querySelector("button").focus()});
  })();
 </script>
</body>
</html>