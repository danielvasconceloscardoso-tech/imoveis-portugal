---
// Layout for every page, in pt, en and fr (D18). Wording: content/copy/COPY_DECK.md.
// Mobile first (prompt 10); header and concierge menu from prompt 19. One sticky action at the bottom of
// the screen on phones. Prompt 11: one trust line, in the footer (no repeated trust bar). noindex until launch, canonical and hreflang.
import "../styles/v2.css";
import "@fontsource-variable/manrope/wght.css";
import "@fontsource-variable/playfair-display/wght.css";
import "../styles/d2.css";
import Chrome from "../components/Chrome.astro";
import serif from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";
import d2serif from "@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url";
import d2sans from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import { config } from "../config";
import { EDITIONS, ED_ORDER, LANGS, LANG_NAME, HTML_LANG, pathFor, type Lang, type EdCode, type PageKey } from "../i18n";
import { c, edName } from "../lib/copy";
import { DISCLAIMER } from "../lib/content";
import CountryBar from "../components/CountryBar.astro";

type Sticky = { href: string; label: string } | null;
// `paths` overrides the URL per language for pages below a page key (e.g. one calculator under "sims").
interface Props { lang: Lang; ed: EdCode; page: PageKey | "home"; title: string; description: string; sticky?: Sticky; d2?: boolean; bodyClass?: string; paths?: Record<Lang, string>; noindex?: boolean; canonicalUrl?: string; ogType?: string; ogImage?: string; alternates?: Record<Lang, string>; }
const { lang, ed, page, title, description, paths, noindex = false, ogType = "website", ogImage, d2 = true, bodyClass } = Astro.props;
const urlFor = (l: Lang) => paths ? paths[l] : pathFor(l, ed, page);
const host = config.domainMode === "primary" ? config.primaryDomain : EDITIONS[ed].domain;
const canonical = Astro.props.canonicalUrl ?? `https://${host}${urlFor(lang)}`;
// Prompt 34 (D37, D52): five items, never wrapping: the path, the map, the calculators, the questions, the partners.
// Price trends live inside the map; the rest sits in the mobile concierge menu and the footer. No "Private". The path's
// label is the one key common.navx.journey, so its rename is one line per language in COPY_DECK.md.
const nav: { k: string; target: PageKey; current: string[] }[] = [
  { k: "journey", target: "journey", current: ["journey", "casa", "buy", "consult", "dossiers", "guide", "private"] },
  { k: "map", target: "map", current: ["map", "data"] },
  { k: "sims", target: "sims", current: ["sims"] },
  { k: "faq", target: "faq", current: ["faq"] },
  { k: "partners", target: "partners", current: ["partners", "ours", "talk"] },
];
const more: PageKey[] = ["casa", "data", "consult", "dossiers", "guide", "blog", "ours", "talk", "how"];
const subscribe = `${pathFor(lang, ed, "home")}#subscrever`;
// Default sticky action: the free guide from the home page, a partner from the help pages.
const sticky: Sticky = Astro.props.sticky !== undefined ? Astro.props.sticky
  : page === "home" || page === "how" ? { href: pathFor(lang, ed, "guide"), label: c("common.sticky.guide", lang) }
  : page === "faq" ? { href: `${pathFor(lang, ed, "talk")}#form`, label: c("common.sticky.talk", lang) }
  : null;
import DemoBar from "../components/DemoBar.astro";
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f6f3ee" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(!config.launchReady || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={Astro.props.alternates ? Astro.props.alternates[l] : `https://${host}${urlFor(l)}`} />)}
    {/* Preload the faces the page sets its first words in: Playfair and Manrope on design-v2 pages, Newsreader elsewhere. */}
    {d2 ? <><link rel="preload" href={d2serif} as="font" type="font/woff2" crossorigin /><link rel="preload" href={d2sans} as="font" type="font/woff2" crossorigin /></> : <link rel="preload" href={serif} as="font" type="font/woff2" crossorigin />}
    <script is:inline>document.documentElement.classList.add("js")</script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Imóveis Portugal" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={HTML_LANG[lang].replace("-", "_")} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    {page === "home" && <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "Organization", name: "Imóveis Portugal", url: `https://${host}/`, email: config.contactEmail, description: description, areaServed: ["LU", "FR", "CH", "BR", "US", "IL", "PT"] })} />}
    <slot name="head" />
  </head>
  <body data-ed={ed} class={[sticky && !d2 ? "has-sticky" : "", d2 ? "d2" : "", d2 && page !== "home" ? "d2p" : "", bodyClass ?? ""].filter(Boolean).join(" ") || undefined}>
    <a class="skip" href="#main">{c("common.skip", lang)}</a>
    <header class={d2 && page !== "home" ? "hd solid" : "hd"}>
      <div class="frame">
        <a class="word" href={pathFor(lang, ed, "home")}>Imóveis Portugal<span class="beta">{c("common.beta", lang)}</span></a>
        <nav class="nav" aria-label="Menu">
          {nav.map((n) => <a href={pathFor(lang, ed, n.target)} aria-current={n.current.includes(page) ? "page" : undefined}>{c(`common.navx.${n.k}`, lang)}</a>)}
        </nav>
        <div class="tools">
          <details class="cpick">
            <summary aria-label={`${c("common.country.live", lang)}: ${c(`common.country.${ed}`, lang)}`}><span class="cpick-l">{c("common.country.live", lang)}</span> {c(`common.country.${ed}`, lang)}</summary>
            <div class="cpick-menu">{ED_ORDER.map((x) => <a href={pathFor(lang, x, page)} aria-current={x === ed ? "true" : undefined}>{c(`common.country.${x}`, lang)}</a>)}</div>
          </details>
          <p class="langs" aria-label={c("common.language", lang)}>
            {LANGS.map((l, i) => <>{i > 0 && <span aria-hidden="true">·</span>}<a href={urlFor(l)} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} aria-current={l === lang ? "true" : undefined}>{l.toUpperCase()}</a></>)}
          </p>
          <a class="nl" href={subscribe}>{c("common.newsletter", lang)}</a>
          {d2 && <button type="button" class="hd-find" data-find-open aria-label={c("find.open", lang)}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg><kbd>⌘K</kbd></button>}
          {d2 && <a class="hd-cg" href={pathFor(lang, ed, "consult")} data-concierge>{c("find.concierge", lang)}</a>}
          <details class="concierge">
            <summary><span class="open">{c("common.menu", lang)}</span><span class="shut">{c("common.close", lang)}</span></summary>
            <div class="cmenu">
              <nav class="cmain" aria-label="Menu">
                {nav.map((n) => <a href={pathFor(lang, ed, n.target)} aria-current={n.current.includes(page) ? "page" : undefined}>{c(`common.navx.${n.k}`, lang)}</a>)}
              </nav>
              <ul class="csub">
                {more.map((k) => <li><a href={pathFor(lang, ed, k)} aria-current={page === k ? "page" : undefined}>{c(`common.nav.${k}`, lang)}</a></li>)}
              </ul>
              <CountryBar lang={lang} ed={ed} href={(x) => pathFor(lang, x, page)} variant="menu" />
              <div class="cact">
                <a class="btn" href={subscribe}>{c("common.newsletter", lang)}</a>
                <a class="btn ghost" href={pathFor(lang, ed, "consult")}>{c("consult.cta", lang)}</a>
              </div>
            </div>
          </details>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    {d2 ? (
    <footer class="ft2">
      <div class="ft2-in">
        <a class="ft2-word" href={pathFor(lang, ed, "home")}>Imóveis Portugal</a>
        <div class="ft2-cols">
          <div><p class="ft2-k">{c("home2.ft.buy", lang)}</p><ul><li><a href={`${pathFor(lang, ed, "journey")}?door=buy`}>{c("path.door.buy", lang)}</a></li><li><a href={pathFor(lang, ed, "casa")}>{c("common.nav.casa", lang)}</a></li><li><a href={pathFor(lang, ed, "sims")}>{c("common.nav.sims", lang)}</a></li><li><a href={pathFor(lang, ed, "guide")}>{c("common.nav.guide", lang)}</a></li></ul></div>
          <div><p class="ft2-k">{c("home2.ft.sell", lang)}</p><ul><li><a href={`${pathFor(lang, ed, "journey")}?door=sell`}>{c("path.door.sell", lang)}</a></li><li><a href={pathFor(lang, ed, "data")}>{c("common.nav.data", lang)}</a></li></ul></div>
          <div><p class="ft2-k">{c("home2.ft.map", lang)}</p><ul><li><a href={pathFor(lang, ed, "map")}>{c("common.nav.map", lang)}</a></li><li><a href={pathFor(lang, ed, "data")}>{c("common.nav.data", lang)}</a></li></ul></div>
          <div><p class="ft2-k">{c("home2.ft.qa", lang)}</p><ul><li><a href={pathFor(lang, ed, "faq")}>{c("common.nav.faq", lang)}</a></li><li><a href={pathFor(lang, ed, "blog")}>{c("common.nav.blog", lang)}</a></li><li><a href={pathFor(lang, ed, "how")}>{c("common.nav.how", lang)}</a></li></ul></div>
          <div><p class="ft2-k">{c("home2.ft.partners", lang)}</p><ul><li><a href={pathFor(lang, ed, "ours")}>{c("common.nav.ours", lang)}</a></li><li><a href={pathFor(lang, ed, "partners")}>{c("common.nav.partners", lang)}</a></li></ul></div>
        </div>
        <div class="ft2-row">
          <p><span class="ft2-k">{c("home2.ft.editions", lang)}</span> {ED_ORDER.map((x, i) => <>{i > 0 && " · "}<a href={pathFor(lang, x, page)} aria-current={x === ed ? "true" : undefined}>{edName(x, lang)}</a></>)}</p>
          <p><span class="ft2-k">{c("home2.ft.langs", lang)}</span> {LANGS.map((l, i) => <>{i > 0 && " · "}<a href={urlFor(l)} data-lang={l} lang={HTML_LANG[l]}>{LANG_NAME[l]}</a></>)}</p>
        </div>
        <p class="ft2-small">{DISCLAIMER[lang]}</p>
        <p class="ft2-small">{c("common.foot.agency", lang)}: <a href={config.agency.website} rel="noopener">{config.agency.name}</a>, AMI {config.agency.ami}. <a href={pathFor(lang, ed, "privacy")}>{c("common.privacy", lang)}</a> · <a href={pathFor(lang, ed, "legal")}>{c("common.foot.legal", lang)}</a> · <a href="/credits/">{c("common.foot.credits", lang)}</a> · © 2026 Imóveis Portugal</p>
      </div>
    </footer>
    ) : (
    <footer class="ft">
      <div class="frame">
        <a class="word" href={pathFor(lang, ed, "home")}>Imóveis Portugal</a>
        <p class="tagline">{c("common.foot.tagline", lang)}</p>
        <p class="ft-trust">{c("common.trust.2.p", lang)} {c("common.trust.3.p", lang)} <a href={pathFor(lang, ed, "partners")}>{c("common.partners.line", lang)}</a></p>
        <div class="cols">
          <p class="small disc-ft">{DISCLAIMER[lang]}</p>
          <div>
            <p class="label">{c("common.foot.about", lang)}</p>
            <ul>
              <li><a href={pathFor(lang, ed, "how")}>{c("common.nav.how", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "blog")}>{c("common.nav.blog", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "buy")}>{c("common.nav.buy", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "map")}>{c("common.nav.map", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "data")}>{c("common.nav.data", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "faq")}>{c("common.nav.faq", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "guide")}>{c("common.nav.guide", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "partners")}>{c("common.nav.partners", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "ours")}>{c("common.nav.ours", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "talk")}>{c("common.nav.talk", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "privacy")}>{c("common.privacy", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "legal")}>{c("common.foot.legal", lang)}</a></li>
            </ul>
          </div>
          <div>
            <p class="label">{c("common.foot.editions", lang)}</p>
            <ul>{ED_ORDER.map((x) => <li><a href={pathFor(lang, x, page)}>{edName(x, lang)}</a></li>)}</ul>
          </div>
          <div>
            <p class="label">{c("common.foot.languages", lang)}</p>
            <ul>{LANGS.map((l) => <li><a href={urlFor(l)} data-lang={l} lang={HTML_LANG[l]}>{LANG_NAME[l]}</a></li>)}</ul>
          </div>
        </div>
        <p class="legal">{c("common.foot.agency", lang)}: <a href={config.agency.website} rel="noopener">{config.agency.name}</a>, AMI {config.agency.ami}, {c("common.gold", lang)}. © 2026 Imóveis Portugal.</p>
      </div>
    </footer>
    )}
    {sticky && !d2 && <div class="sticky" id="sticky"><a class="btn" href={sticky.href}>{sticky.label}</a></div>}
    <script is:inline define:vars={{ ed, lang }}>
      try {
        localStorage.setItem("ip-ed", ed);
        if (!localStorage.getItem("ip-lang")) localStorage.setItem("ip-lang", lang);
        document.addEventListener("click", (e) => {
          const a = e.target.closest && e.target.closest("a[data-lang]");
          if (a) localStorage.setItem("ip-lang", a.dataset.lang);
          // Close an open picker when tapping elsewhere.
          document.querySelectorAll("details.pick[open]").forEach((d) => { if (!d.contains(e.target)) d.removeAttribute("open"); });
        });
      } catch (_) {}
      // The sticky action shows only once the page's own main action ([data-primary]) is off screen.
      (function () {
        var st = document.getElementById("sticky"), pr = document.querySelector("[data-primary]");
        if (!st || !pr || !("IntersectionObserver" in window)) return;
        new IntersectionObserver(function (e) { st.classList.toggle("off", e[0].isIntersecting); }).observe(pr);
      })();
    </script>
    {d2 && <Chrome lang={lang} ed={ed} page={page} />}
    <DemoBar />
</body>
</html>
