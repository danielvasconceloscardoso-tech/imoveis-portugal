---
// Redesign v2 layout (prompt 09): one layout for every page, in pt, en and fr (D18).
// noindex until launch, canonical and hreflang, discreet edition and language pickers, trust strip, footer.
import "../styles/v2.css";
import serif from "@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url";
import { config } from "../config";
import { EDITIONS, ED_ORDER, LANGS, LANG_NAME, HTML_LANG, pathFor, type Lang, type EdCode, type PageKey } from "../i18n";
import { ui } from "../lib/ui";
import { DISCLAIMER } from "../lib/content";

interface Props { lang: Lang; ed: EdCode; page: PageKey | "home"; title: string; description: string; }
const { lang, ed, page, title, description } = Astro.props;
const U = ui(lang);
const host = config.domainMode === "primary" ? config.primaryDomain : EDITIONS[ed].domain;
const canonical = `https://${host}${pathFor(lang, ed, page)}`;
const nav: [PageKey, string][] = [["faq", U.nav.faq], ["guide", U.nav.guide], ["buy", U.nav.buy], ["partners", U.nav.partners]];
const subscribe = `${pathFor(lang, ed, "home")}#subscrever`;
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!config.launchReady && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={`https://${host}${pathFor(l, ed, page)}`} />)}
    <link rel="preload" href={serif} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Imóveis Portugal" />
    <slot name="head" />
  </head>
  <body data-ed={ed}>
    <a class="skip" href="#main">{U.skip}</a>
    <header class="hd">
      <div class="frame">
        <a class="word" href={pathFor(lang, ed, "home")}>Imóveis Portugal<span class="beta">{U.beta}</span></a>
        <nav class="nav" aria-label="Menu">
          {nav.map(([k, label]) => <a href={pathFor(lang, ed, k)} aria-current={page === k ? "page" : undefined}>{label}</a>)}
        </nav>
        <div class="tools">
          <details class="pick ed">
            <summary aria-label={`${U.edition}: ${EDITIONS[ed].name[lang]}`}><span class="dot" aria-hidden="true"></span>{ed.toUpperCase()}</summary>
            <div class="menu">
              {ED_ORDER.map((c) => <a href={pathFor(lang, c, page)} aria-current={c === ed ? "true" : undefined}>{EDITIONS[c].name[lang]}</a>)}
            </div>
          </details>
          <details class="pick">
            <summary aria-label={`${U.language}: ${LANG_NAME[lang]}`}>
              <svg class="globe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg>{lang.toUpperCase()}
            </summary>
            <div class="menu">
              {LANGS.map((l) => <a href={pathFor(l, ed, page)} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} data-lang={l} aria-current={l === lang ? "true" : undefined}>{LANG_NAME[l]}</a>)}
            </div>
          </details>
          <a class="btn sm" href={subscribe}>{U.subscribe}</a>
          <details class="pick burger">
            <summary>{U.menu}</summary>
            <div class="menu">
              {nav.map(([k, label]) => <a href={pathFor(lang, ed, k)} aria-current={page === k ? "page" : undefined}>{label}</a>)}
              <a href={pathFor(lang, ed, "how")}>{U.nav.how}</a>
              <a href={subscribe}>{U.subscribe}</a>
              <div class="eds">
                {ED_ORDER.map((c) => <a href={pathFor(lang, c, page)} aria-current={c === ed ? "true" : undefined}>{EDITIONS[c].name[lang]}</a>)}
              </div>
            </div>
          </details>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <aside class="trust" aria-label={U.nav.how}>
      <div class="frame">
        <ul>
          {U.trust.map(([h, p], i) => (
            <li>
              {i === 0 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 10.5 12 4l9 6.5V20H3z"/><path d="M9.5 20v-5h5v5"/></svg>}
              {i === 1 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3h9l3 3v15H6z"/><path d="M9 11h6M9 15h6"/></svg>}
              {i === 2 && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3 4 6v6c0 4.5 3.4 8.2 8 9 4.6-.8 8-4.5 8-9V6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>}
              <span>
                <b>{i === 0 ? <a href={config.agency.website} rel="noopener" style="color:inherit">{h}</a> : h}</b>
                {p}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </aside>
    <footer class="ft">
      <div class="frame">
        <a class="word" href={pathFor(lang, ed, "home")}>Imóveis Portugal</a>
        <div class="cols">
          <p class="small" style="color:#9aa0a6;max-width:28em">{DISCLAIMER[lang]}</p>
          <div>
            <p class="label">{U.foot.about}</p>
            <ul>
              <li><a href={pathFor(lang, ed, "how")}>{U.nav.how}</a></li>
              <li><a href={pathFor(lang, ed, "partners")}>{U.nav.partners}</a></li>
              <li><a href={pathFor(lang, ed, "talk")}>{U.foot.talk}</a></li>
              <li><a href={pathFor(lang, ed, "privacy")}>{U.foot.privacy}</a></li>
              <li><a href={pathFor(lang, ed, "legal")}>{U.foot.legal}</a></li>
            </ul>
          </div>
          <div>
            <p class="label">{U.foot.editions}</p>
            <ul>{ED_ORDER.map((c) => <li><a href={pathFor(lang, c, page)}>{EDITIONS[c].name[lang]}</a></li>)}</ul>
          </div>
          <div>
            <p class="label">{U.foot.languages}</p>
            <ul>{LANGS.map((l) => <li><a href={pathFor(l, ed, page)} data-lang={l} lang={HTML_LANG[l]}>{LANG_NAME[l]}</a></li>)}</ul>
          </div>
        </div>
        <p class="legal">{U.foot.agency}: <a href={config.agency.website} rel="noopener">{config.agency.name}</a>, AMI {config.agency.ami}. © 2026 Imóveis Portugal.</p>
      </div>
    </footer>
    <script is:inline define:vars={{ ed, lang }}>
      try {
        localStorage.setItem("ip-ed", ed);
        if (!localStorage.getItem("ip-lang")) localStorage.setItem("ip-lang", lang);
        document.addEventListener("click", (e) => {
          const a = e.target.closest && e.target.closest("a[data-lang]");
          if (a) localStorage.setItem("ip-lang", a.dataset.lang);
          // Close an open picker when clicking elsewhere.
          document.querySelectorAll("details.pick[open]").forEach((d) => { if (!d.contains(e.target)) d.removeAttribute("open"); });
        });
      } catch (_) {}
    </script>
  </body>
</html>
