---
// Layout for every page, in pt, en and fr (D18). Wording: content/copy/COPY_DECK.md.
// Mobile first (prompt 10); header and concierge menu from prompt 19. One sticky action at the bottom of
// the screen on phones. Prompt 11: one trust line, in the footer (no repeated trust bar). noindex until launch, canonical and hreflang.
import "../styles/v2.css";
import "@fontsource-variable/manrope/wght.css";
import "@fontsource-variable/playfair-display/wght.css";
import "../styles/d2.css";
import Chrome from "../components/Chrome.astro";
import serif from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";
import d2serif from "@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url";
import d2sans from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import { config } from "../config";
import { EDITIONS, ED_ORDER, LANGS, LANG_NAME, HTML_LANG, pathFor, type Lang, type EdCode, type PageKey } from "../i18n";
import { c, edName } from "../lib/copy";
import { DISCLAIMER } from "../lib/content";
import CountryBar from "../components/CountryBar.astro";
import NextStep, { type Next } from "../components/NextStep.astro";
import "../styles/bar.css";
import "../styles/mare-nav.css";

type Sticky = { href: string; label: string } | null;
// `paths` overrides the URL per language for pages below a page key (e.g. one calculator under "sims").
// `solid`: the paper header on a page with no photograph at the top, even when `page` is "home" (the 404, prompt 70).
interface Props { lang: Lang; ed: EdCode; page: PageKey | "home"; title: string; description: string; sticky?: Sticky; d2?: boolean; bodyClass?: string; paths?: Record<Lang, string>; noindex?: boolean; canonicalUrl?: string; ogType?: string; ogImage?: string; alternates?: Record<Lang, string>; next?: Next | false; solid?: boolean; }
const { lang, ed, page, title, description, paths, noindex = false, ogType = "website", ogImage, d2 = true, bodyClass } = Astro.props;
const urlFor = (l: Lang) => paths ? paths[l] : pathFor(l, ed, page);
const solid = d2 && (Astro.props.solid ?? page !== "home");
const host = config.domainMode === "primary" ? config.primaryDomain : EDITIONS[ed].domain;
const canonical = Astro.props.canonicalUrl ?? `https://${host}${urlFor(lang)}`;
// Prompt 34 (D37, D52), prompt 37 §2 (operator, 28 Oct): six items, never wrapping: the path, the map, the calculators,
// the articles (the blog sits inside that hub), the questions, the partners; plus the Concierge button.
// Price trends live inside the map; the rest sits in the mobile concierge menu and the footer. No "Private". The path's
// label is the one key common.navx.journey, so its rename is one line per language in COPY_DECK.md.
const nav: { k: string; target: PageKey; current: string[] }[] = [
  { k: "journey", target: "journey", current: ["journey", "casa", "buy", "consult", "dossiers", "guide", "private"] },
  { k: "map", target: "map", current: ["map", "data"] },
  { k: "sims", target: "sims", current: ["sims"] },
  { k: "articles", target: "articles", current: ["articles", "blog"] },
  { k: "faq", target: "faq", current: ["faq"] },
  // Prompt 70 (A-20, J-17): the reader's "Partners" opens the directory of partners they can talk to; the sponsor page
  // ("For partners") stays in the footer.
  { k: "partners", target: "ours", current: ["ours", "talk"] },
];
// Prompt 70: "ours" is the sixth item above now, and the Concierge is the menu's own button, so neither repeats here.
const more: PageKey[] = ["casa", "data", "dossiers", "guide", "talk", "how"];
// Part 2 (operator, 3 Nov): the same five everywhere: the bar at the thumb on phones, the header on desktop. The six
// sections above stay in the menu (open on every device now), so Artigos and Parceiros are one tap away as before.
const five: { k: string; target: PageKey; current: string[]; cg?: boolean; icon: string }[] = [
  { k: "map", target: "map", current: ["map", "data"], icon: '<path d="M9 4.5 3.5 6.6v13l5.5-2.1 6 2.1 5.5-2.1v-13L15 6.6 9 4.5zM9 4.5v13M15 6.6v13"/>' },
  { k: "sims", target: "sims", current: ["sims"], icon: '<rect x="5.5" y="3.5" width="13" height="17" rx="2.5"/><path d="M8.8 7.8h6.4M9 12h.01M12 12h.01M15 12h.01M9 15.6h.01M12 15.6h.01M15 15.6h.01"/>' },
  { k: "concierge", target: "consult", current: ["consult"], cg: true, icon: '<path d="M4 17.5h16M5.8 17.5a6.2 6.2 0 0 1 12.4 0M12 11.3V9.2M10.2 9.2h3.6"/>' },
  { k: "path", target: "journey", current: ["journey", "casa", "buy", "dossiers", "guide", "private"], icon: '<circle cx="6.5" cy="17.5" r="2"/><circle cx="17.5" cy="6.5" r="2"/><path d="M8.5 17.5h6a3 3 0 0 0 0-6h-5a3 3 0 0 1 0-6h6"/>' },
  { k: "faq", target: "faq", current: ["faq"], icon: '<circle cx="12" cy="12" r="8.5"/><path d="M9.7 9.6a2.4 2.4 0 1 1 3.3 2.2c-.6.3-1 .8-1 1.4v.6M12 16.6h.01"/>' },
];
const savedHref = pathFor(lang, ed, "saved");
const saveL = { add: c("bar.heart.add", lang), saved: c("bar.heart.saved", lang), removed: c("bar.heart.removed", lang), link: c("bar.saved", lang) };
// Every page ends with one clear next step (Part 2): the Concierge from most pages, "Voltar" from the legal pages; the
// forms (Concierge, buyer request, partner, free guide) and the partner pages already end on their own action.
const next: Next | null = Astro.props.next === false ? null : Astro.props.next ?? (
  page === "home" ? { kind: "concierge", p: c("bar.next.home.p", lang) }
  : page === "map" || page === "data" ? { kind: "concierge", p: c("bar.next.map.p", lang) }
  : page === "sims" ? { kind: "concierge", p: c("bar.next.sims.p", lang) }
  : page === "privacy" || page === "legal" ? { kind: "back", p: c("bar.next.back.p", lang) }
  : ["consult", "buy", "talk", "guide", "partners", "saved"].includes(page) ? null
  : { kind: "concierge", p: c("bar.next.read.p", lang) });
const subscribe = pathFor(lang, ed, "mare");  // D83: the Maré page (the home keeps its own form at #subscrever)
// Default sticky action: the free guide from the home page, a partner from the help pages.
const sticky: Sticky = Astro.props.sticky !== undefined ? Astro.props.sticky
  : page === "home" || page === "how" ? { href: pathFor(lang, ed, "guide"), label: c("common.sticky.guide", lang) }
  : page === "faq" ? { href: `${pathFor(lang, ed, "talk")}#form`, label: c("common.sticky.talk", lang) }
  : null;
import DemoBar from "../components/DemoBar.astro";
import Beacon from "../components/Beacon.astro";
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* Prompt 70 (S-04): a stylesheet lost to a dropped signal is fetched again (when the browser is back online, else after
        a short wait, up to five times), so a page never stays unstyled once the connection returns. Prompt 73 (S-04, J2-04):
        when the connection comes back, once, web fonts that failed (each @font-face of that family, added again) and images
        that failed (with their <picture> sources) are fetched again. */}
    <script is:inline>(function(){var n={};function again(l){var h=(l.getAttribute("data-href")||l.href).split("#")[0],k=(n[h]||0)+1;if(k>5)return;n[h]=k;var go=function(){var c=l.cloneNode();c.setAttribute("data-href",h);c.href=h+(h.indexOf("?")<0?"?":"&")+"retry="+k;c.onload=function(){l.parentNode&&l.parentNode.removeChild(l)};l.parentNode.insertBefore(c,l.nextSibling)};navigator.onLine===false?addEventListener("online",go,{once:true}):setTimeout(go,1200*k)}addEventListener("error",function(e){var t=e.target;if(t&&t.tagName==="LINK"&&/stylesheet/.test(t.rel))again(t)},true);addEventListener("online",function(){var q=function(u){return u?u.replace(/(\S+?)(\s|$)/,function(m,a,b){return a+(a.indexOf("?")<0?"?":"&")+"retry=on"+b}):u};var bad={};document.fonts&&document.fonts.forEach(function(f){if(f.status==="error")bad[f.family.replace(/["']/g,"")]=1});if(Object.keys(bad).length&&window.FontFace)[].forEach.call(document.styleSheets,function(sh){var r;try{r=sh.cssRules}catch(e){return}[].forEach.call(r||[],function(x){if(!(x instanceof CSSFontFaceRule))return;var st=x.style,fam=st.getPropertyValue("font-family").replace(/["']/g,"").trim();if(!bad[fam])return;var src=st.getPropertyValue("src").replace(/url\((["']?)([^"')]+)\1\)/g,function(m,k,u){return'url("'+q(new URL(u,sh.href||location.href).href)+'")'});var d={};["weight","style","stretch","unicode-range","display"].forEach(function(n){var v=st.getPropertyValue("font-"+n)||st.getPropertyValue(n);if(v)d[n.replace("unicode-range","unicodeRange")]=v});try{var f=new FontFace(fam,src,d);document.fonts.add(f);f.load().catch(function(){})}catch(e){}})});document.querySelectorAll("img").forEach(function(i){if(!i.complete||i.naturalWidth||!i.getAttribute("src")||i.dataset.retried)return;i.dataset.retried="1";var p=i.parentNode&&i.parentNode.tagName==="PICTURE"?i.parentNode.querySelectorAll("source"):[];[].forEach.call(p,function(s){s.srcset=s.srcset.split(",").map(function(x){return q(x.trim())}).join(", ")});if(i.srcset)i.srcset=i.srcset.split(",").map(function(x){return q(x.trim())}).join(", ");i.src=q(i.getAttribute("src"))})},{once:true})})();</script>
    <meta name="theme-color" content="#f6f3ee" />
    {/* Prompt 70 (A-12): the site is light; a browser's forced dark mode must not half-invert it. */}
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(!config.launchReady || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={Astro.props.alternates ? Astro.props.alternates[l] : `https://${host}${urlFor(l)}`} />)}
    {/* Match the home picture's preferred format; unsupported browsers discover its WebP fallback normally. */}
    {d2 && page === "home" && !solid && <link rel="preload" href="/video/hero-portugal-poster.avif?v=6e9a1bc" as="image" type="image/avif" fetchpriority="high" />}
    {/* Preload the faces the page sets its first words in: Playfair and Manrope on design-v2 pages, Newsreader elsewhere. */}
    {d2 ? <><link rel="preload" href={d2serif} as="font" type="font/woff2" crossorigin /><link rel="preload" href={d2sans} as="font" type="font/woff2" crossorigin /></> : <link rel="preload" href={serif} as="font" type="font/woff2" crossorigin />}
    <script is:inline>document.documentElement.classList.add("js")</script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Imóveis Portugal" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={HTML_LANG[lang].replace("-", "_")} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    {page === "home" && !Astro.props.solid && <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "Organization", name: "Imóveis Portugal", url: `https://${host}/`, email: config.contactEmail, description: description, areaServed: ["LU", "FR", "CH", "BR", "US", "IL", "PT"] })} />}
    <slot name="head" />
    <Beacon />
  </head>
  <body data-ed={ed} class={[sticky && !d2 ? "has-sticky" : "", d2 ? "d2" : "", solid ? "d2p" : "", d2 ? "has-bb" : "", bodyClass ?? ""].filter(Boolean).join(" ") || undefined}>
    <a class="skip" href="#main">{c("common.skip", lang)}</a>
    <header class={solid ? "hd solid" : "hd"}>
      <div class="frame">
        <a class="word" href={pathFor(lang, ed, "home")}>Imóveis Portugal<span class="beta">{c("common.beta", lang)}</span></a>
        {d2 ? (
        <nav class="nav nav5" aria-label="Menu">
          {five.map((n) => <a href={pathFor(lang, ed, n.target)} aria-current={n.current.includes(page) ? "page" : undefined} data-nav-k={n.k} {...(n.cg ? { "data-concierge": "" } : {})}>{c(`bar.nav.${n.k}`, lang)}</a>)}
        </nav>
        ) : (
        <nav class="nav" aria-label="Menu">
          {nav.map((n) => <a href={pathFor(lang, ed, n.target)} aria-current={n.current.includes(page) ? "page" : undefined}>{c(`common.navx.${n.k}`, lang)}</a>)}
        </nav>
        )}
        <div class="tools">
          <details class="cpick">
            <summary aria-label={`${c("common.country.live", lang)}: ${c(`common.country.${ed}`, lang)}`}><span class="cpick-l">{c("common.country.live", lang)}</span> {c(`common.country.${ed}`, lang)}</summary>
            <div class="cpick-menu">{ED_ORDER.map((x) => <a href={pathFor(lang, x, page)} aria-current={x === ed ? "true" : undefined}>{c(`common.country.${x}`, lang)}</a>)}</div>
          </details>
          <p class="langs" aria-label={c("common.language", lang)}>
            {LANGS.map((l, i) => <>{i > 0 && <span aria-hidden="true">·</span>}<a href={urlFor(l)} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} aria-current={l === lang ? "true" : undefined}>{l.toUpperCase()}</a></>)}
          </p>
          {/* Fix step 5 (3 Nov): the small Maré button, every page; counted on arrival as ev "mare/open/header" (MarePage). */}
          {d2 ? (
          <a class="hd-mare" href={`${subscribe}?de=header`} aria-label={c("common.newsletter", lang)} title={c("mare.line", lang)} aria-current={page === "mare" ? "page" : undefined}>{c("mare.title", lang)}</a>
          ) : <a class="nl" href={subscribe}>{c("common.newsletter", lang)}</a>}
          {d2 && <button type="button" class="hd-find" data-find-open aria-label={c("find.open", lang)}><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg><kbd>⌘K</kbd></button>}
          {d2 && <a class="hd-saved" href={savedHref} data-saved-link data-nav-k="saved" aria-label={c("bar.saved", lang)} aria-current={page === "saved" ? "page" : undefined}><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 20.2s-7.2-4.5-7.2-10.1A4.1 4.1 0 0 1 12 7.5a4.1 4.1 0 0 1 7.2 2.6c0 5.6-7.2 10.1-7.2 10.1z"/></svg></a>}
          {d2 && <a class="hd-cg" href={pathFor(lang, ed, "consult")} data-concierge>{c("find.concierge", lang)}</a>}
          <details class="concierge">
            <summary aria-controls="site-menu"><span class="open">{c("common.menu", lang)}</span><span class="shut">{c("common.close", lang)}</span></summary>
            <div class="cmenu" id="site-menu">
              <nav class="cmain" aria-label="Menu">
                {nav.map((n) => <a href={pathFor(lang, ed, n.target)} aria-current={n.current.includes(page) ? "page" : undefined}>{c(`common.navx.${n.k}`, lang)}</a>)}
              </nav>
              <ul class="csub">
                {more.map((k) => <li><a href={pathFor(lang, ed, k)} aria-current={page === k ? "page" : undefined}>{c(`common.nav.${k}`, lang)}</a></li>)}
                {d2 && <li><a href={savedHref} aria-current={page === "saved" ? "page" : undefined}>{c("bar.saved", lang)}</a></li>}
              </ul>
              <CountryBar lang={lang} ed={ed} href={(x) => pathFor(lang, x, page)} variant="menu" />
              <p class="langs cmenu-langs" aria-label={c("common.language", lang)}>
                {LANGS.map((l, i) => <>{i > 0 && <span aria-hidden="true">·</span>}<a href={urlFor(l)} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} aria-current={l === lang ? "true" : undefined}>{l.toUpperCase()}</a></>)}
              </p>
              <div class="cact">
                <a class="btn" href={subscribe}>{c("common.newsletter", lang)}</a>
                <a class="btn ghost" href={pathFor(lang, ed, "consult")}>{c("consult.cta", lang)}</a>
              </div>
            </div>
          </details>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
      {d2 && next && <NextStep lang={lang} ed={ed} next={next} />}
    </main>
    {d2 ? (
    <footer class="ft2">
      <div class="ft2-in">
        <a class="ft2-word" href={pathFor(lang, ed, "home")}>Imóveis Portugal</a>
        <div class="ft2-cols">
          <div><p class="ft2-k">{c("home2.ft.buy", lang)}</p><ul><li><a href={`${pathFor(lang, ed, "journey")}?door=buy`}>{c("path.door.buy", lang)}</a></li><li><a href={pathFor(lang, ed, "casa")}>{c("common.nav.casa", lang)}</a></li><li><a href={pathFor(lang, ed, "sims")}>{c("common.nav.sims", lang)}</a></li><li><a href={pathFor(lang, ed, "guide")}>{c("common.nav.guide", lang)}</a></li></ul></div>
          <div><p class="ft2-k">{c("home2.ft.sell", lang)}</p><ul><li><a href={`${pathFor(lang, ed, "journey")}?door=sell`}>{c("path.door.sell", lang)}</a></li></ul></div>
          <div><p class="ft2-k">{c("home2.ft.map", lang)}</p><ul><li><a href={pathFor(lang, ed, "map")}>{c("common.nav.map", lang)}</a></li><li><a href={pathFor(lang, ed, "data")}>{c("common.nav.data", lang)}</a></li></ul></div>
          <div><p class="ft2-k">{c("home2.ft.qa", lang)}</p><ul><li><a href={pathFor(lang, ed, "faq")}>{c("common.nav.faq", lang)}</a></li><li><a href={pathFor(lang, ed, "articles")}>{c("common.nav.articles", lang)}</a></li><li><a href={pathFor(lang, ed, "how")}>{c("common.nav.how", lang)}</a></li><li><a href={pathFor(lang, ed, "mare")}>{c("common.newsletter", lang)}</a></li></ul></div>
          <div><p class="ft2-k">{c("home2.ft.partners", lang)}</p><ul><li><a href={pathFor(lang, ed, "ours")}>{c("common.nav.ours", lang)}</a></li><li><a href={pathFor(lang, ed, "partners")}>{c("common.nav.partners", lang)}</a></li></ul></div>
        </div>
        <div class="ft2-row">
          <p><span class="ft2-k">{c("home2.ft.editions", lang)}</span> {ED_ORDER.map((x, i) => <>{i > 0 && " · "}<a href={pathFor(lang, x, page)} aria-current={x === ed ? "true" : undefined}>{edName(x, lang)}</a></>)}</p>
          <p><span class="ft2-k">{c("home2.ft.langs", lang)}</span> {LANGS.map((l, i) => <>{i > 0 && " · "}<a href={urlFor(l)} data-lang={l} lang={HTML_LANG[l]}>{LANG_NAME[l]}</a></>)}</p>
        </div>
        <p class="ft2-small">{DISCLAIMER[lang]}</p>
        <p class="ft2-small">{config.agency.public ? <>{c("common.foot.agency", lang)}: <a href={config.agency.website} rel="noopener">{config.agency.name}</a>, AMI {config.agency.ami}.</> : c("common.foot.agency", lang)} <a href={pathFor(lang, ed, "privacy")}>{c("common.privacy", lang)}</a> · <a href={pathFor(lang, ed, "legal")}>{c("common.foot.legal", lang)}</a> · <a href={`/${lang}/credits/`}>{c("common.foot.credits", lang)}</a> · © 2026 Imóveis Portugal</p>
      </div>
    </footer>
    ) : (
    <footer class="ft">
      <div class="frame">
        <a class="word" href={pathFor(lang, ed, "home")}>Imóveis Portugal</a>
        <p class="tagline">{c("common.foot.tagline", lang)}</p>
        <p class="ft-trust">{c("common.trust.2.p", lang)} {c("common.trust.3.p", lang)} <a href={pathFor(lang, ed, "partners")}>{c("common.partners.line", lang)}</a></p>
        <div class="cols">
          <p class="small disc-ft">{DISCLAIMER[lang]}</p>
          <div>
            <p class="label">{c("common.foot.about", lang)}</p>
            <ul>
              <li><a href={pathFor(lang, ed, "how")}>{c("common.nav.how", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "blog")}>{c("common.nav.blog", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "buy")}>{c("common.nav.buy", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "map")}>{c("common.nav.map", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "data")}>{c("common.nav.data", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "faq")}>{c("common.nav.faq", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "guide")}>{c("common.nav.guide", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "partners")}>{c("common.nav.partners", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "ours")}>{c("common.nav.ours", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "talk")}>{c("common.nav.talk", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "privacy")}>{c("common.privacy", lang)}</a></li>
              <li><a href={pathFor(lang, ed, "legal")}>{c("common.foot.legal", lang)}</a></li>
            </ul>
          </div>
          <div>
            <p class="label">{c("common.foot.editions", lang)}</p>
            <ul>{ED_ORDER.map((x) => <li><a href={pathFor(lang, x, page)}>{edName(x, lang)}</a></li>)}</ul>
          </div>
          <div>
            <p class="label">{c("common.foot.languages", lang)}</p>
            <ul>{LANGS.map((l) => <li><a href={urlFor(l)} data-lang={l} lang={HTML_LANG[l]}>{LANG_NAME[l]}</a></li>)}</ul>
          </div>
        </div>
        <p class="legal">{config.agency.public ? <>{c("common.foot.agency", lang)}: <a href={config.agency.website} rel="noopener">{config.agency.name}</a>, AMI {config.agency.ami}, {c("common.gold", lang)}.</> : c("common.foot.agency", lang)} © 2026 Imóveis Portugal.</p>
      </div>
    </footer>
    )}
    {sticky && !d2 && <div class="sticky" id="sticky"><a class="btn" href={sticky.href}>{sticky.label}</a></div>}
    <script is:inline define:vars={{ ed, lang }}>
      try {
        localStorage.setItem("ip-ed", ed);
        if (!localStorage.getItem("ip-lang")) localStorage.setItem("ip-lang", lang);
        document.addEventListener("click", (e) => {
          const a = e.target.closest && e.target.closest("a[data-lang]");
          if (a) localStorage.setItem("ip-lang", a.dataset.lang);
          // Prompt 70 (A-26): a language link keeps what the reader is looking at (?place=gondomar, #section).
          var l = e.target.closest && e.target.closest("a[hreflang], a[data-lang]");
          if (l && (location.search || location.hash) && l.origin === location.origin && !/[?#]/.test(l.getAttribute("href") || "")) l.href = l.pathname + location.search + location.hash;
          // Close an open picker when tapping elsewhere.
          document.querySelectorAll("details.pick[open]").forEach((d) => { if (!d.contains(e.target)) d.removeAttribute("open"); });
        });
      } catch (_) {}
      // The sticky action shows only once the page's own main action ([data-primary]) is off screen.
      (function () {
        var st = document.getElementById("sticky"), pr = document.querySelector("[data-primary]");
        if (!st || !pr || !("IntersectionObserver" in window)) return;
        new IntersectionObserver(function (e) { st.classList.toggle("off", e[0].isIntersecting); }).observe(pr);
      })();
    </script>
    {d2 && <Chrome lang={lang} ed={ed} page={page} />}
    {d2 && (
      <nav class="bb" data-bb aria-label={c("bar.label", lang)}>
        {five.map((n) => <a href={pathFor(lang, ed, n.target)} aria-current={n.current.includes(page) ? "page" : undefined} data-bb-k={n.k} {...(n.cg ? { "data-concierge": "" } : {})}><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" set:html={n.icon} /><span>{c(`bar.nav.${n.k}`, lang)}</span></a>)}
      </nav>
    )}
    {d2 && <script type="application/json" id="ip-save-l" set:html={JSON.stringify(saveL)} />}
    <script>import { initBar } from "../scripts/bar"; import { initNavigation } from "../scripts/navigation"; initNavigation(); initBar();</script>
    <DemoBar />
</body>
</html>
