---
// Direction C layout (D15), three languages (D18). Same head rules as Base.astro: noindex until launch,
// canonical, hreflang for the three languages.
import "../styles/c.css";
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import LangSwitch from "../components/LangSwitch.astro";
import { config } from "../config";
import { EDITIONS, ED_ORDER, LANGS, HTML_LANG, pathFor, t, type Lang, type EdCode, type PageKey } from "../i18n";
import { strings } from "../lib/content";

interface Props { lang: Lang; ed: EdCode; page: PageKey; title: string; description: string; }
const { lang, ed, page, title, description } = Astro.props;
const T = t(ed, lang);
const S = strings(lang);
const host = config.domainMode === "primary" ? config.primaryDomain : EDITIONS[ed].domain;
const canonical = `https://${host}${pathFor(lang, ed, page)}`;
const alternates = LANGS.map((l) => ({ hreflang: HTML_LANG[l], href: `https://${host}${pathFor(l, ed, page)}` }));
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!config.launchReady && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Imóveis Portugal" />
    <slot name="head" />
  </head>
  <body data-ed={ed}>
    <a class="skip" href="#main">{S.skip}</a>
    <header class="c-head">
      <div class="w">
        <a class="mark" href={pathFor(lang, ed, "home")}><i aria-hidden="true"></i><b>Imóveis<br />Portugal</b><span class="beta">{S.beta}</span></a>
        <nav aria-label="Menu">
          <a href={pathFor(lang, ed, "faq")} aria-current={page === "faq" ? "page" : undefined}>{S.nav.faq}</a>
          <a href={pathFor(lang, ed, "guide")} aria-current={page === "guide" ? "page" : undefined}>{S.nav.guide}</a>
          <a href={pathFor(lang, ed, "talk")} aria-current={page === "talk" ? "page" : undefined}>{S.nav.talk}</a>
          <a href={pathFor(lang, ed, "buy")}>{T.nav.buy}</a>
          <a href={pathFor(lang, ed, "partners")}>{T.nav.partners}</a>
          <span class="sw" role="group" aria-label={T.editionsLabel}>
            {ED_ORDER.map((c) => (
              <a href={pathFor(lang, c, page)} aria-current={c === ed ? "true" : undefined} title={EDITIONS[c].name[lang]}>{c.toUpperCase()}</a>
            ))}
          </span>
          <LangSwitch lang={lang} ed={ed} page={page} label={S.langSwitch} />
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="c-foot">
      <div class="w">
        <b>Imóveis Portugal</b>
        <span>{T.footer.sponsored}</span>
        <nav aria-label="Footer">
          <a href={pathFor(lang, ed, "faq")}>{S.footer.faq}</a>
          <a href={pathFor(lang, ed, "guide")}>{S.footer.guide}</a>
          <a href={pathFor(lang, ed, "talk")}>{S.footer.talk}</a>
          <a href={pathFor(lang, ed, "privacy")}>{T.footer.privacy}</a>
          <a href={pathFor(lang, ed, "legal")}>{T.footer.legal}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
