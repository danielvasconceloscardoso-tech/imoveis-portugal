---
// Shell of the private dashboards (prompt 51 §3, lib/dash.ts): unlisted, noindex, no site menu, no analytics beacon,
// nothing loaded from outside the site. Mobile first; prints cleanly (the monthly PDF stays scripts/sponsor-report.mjs).
import "@fontsource-variable/manrope/wght.css";
import "@fontsource-variable/playfair-display/wght.css";
interface Props { title: string; lang: "pt" | "en"; flag: string; }
const { title, lang, flag } = Astro.props;
---
<!doctype html>
<html lang={lang === "pt" ? "pt-PT" : "en"}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <meta name="referrer" content="no-referrer" />
  <title>{title}</title>
  <style is:global>
    :root { --ink: #111214; --muted: #5d6066; --rule: #e4e1da; --paper: #fbfaf7; --green: #2f5d50; --bar: #2f5d50; --soft: #edf1ee; --serif: "Playfair Display Variable", Georgia, serif; --sans: "Manrope Variable", system-ui, sans-serif; }
    * { box-sizing: border-box; } body { margin: 0; background: var(--paper); color: var(--ink); font: 400 15px/1.55 var(--sans); }
    a { color: inherit; text-underline-offset: 3px; }
    .db-top { border-bottom: 1px solid var(--rule); background: #fff; } .db-top div { max-width: 1120px; margin: 0 auto; padding: 16px; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
    .db-brand { font: 500 17px/1 var(--serif); } .db-flag { font: 600 12px/1.3 var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); text-align: right; }
    .db { max-width: 1120px; margin: 0 auto; padding: 24px 16px 64px; }
    .db h1 { font: 400 28px/1.15 var(--serif); margin: 0 0 8px; } .db h2 { font: 400 21px/1.2 var(--serif); margin: 40px 0 16px; }
    .db-lede { color: var(--muted); margin: 0 0 24px; max-width: 64ch; }
    .db-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 8px; }
    .db-tile { background: #fff; border: 1px solid var(--rule); border-radius: 8px; padding: 16px; } .db-tile b { display: block; font: 500 28px/1.1 var(--serif); margin-bottom: 4px; } .db-tile span { color: var(--muted); font-size: 13px; }
    .db-card { background: #fff; border: 1px solid var(--rule); border-radius: 8px; padding: 16px; overflow-x: auto; }
    table { border-collapse: collapse; width: 100%; font-size: 13px; } th, td { text-align: left; padding: 8px 8px 8px 0; border-bottom: 1px solid var(--rule); vertical-align: top; } th { color: var(--muted); font-weight: 600; } td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; }
    .db-fun { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
    .db-fun li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 16px; align-items: baseline; }
    .db-fun .bar { grid-column: 1 / -1; height: 8px; background: var(--soft); border-radius: 4px; overflow: hidden; } .db-fun .bar i { display: block; height: 100%; background: var(--bar); border-radius: 4px; min-width: 2px; }
    .db-fun b { font-variant-numeric: tabular-nums; } .db-fun small { color: var(--muted); }
    .db-none { color: var(--muted); font-style: italic; margin: 0; }
    .db-src { color: var(--muted); font-size: 12px; margin: 8px 0 0; }
    .db-sample { display: inline-block; font: 600 12px/1 var(--sans); letter-spacing: .1em; text-transform: uppercase; background: #fff4d6; color: #6b4e00; padding: 8px; border-radius: 4px; margin: 0 0 16px; }
    .db-two { display: grid; gap: 16px; } @media (min-width: 860px) { .db-two { grid-template-columns: 1fr 1fr; } .db { padding: 40px 24px 64px; } .db h1 { font-size: 40px; } }
    .spark { display: block; width: 100%; height: 40px; } .spark path { fill: none; stroke: var(--bar); stroke-width: 2; vector-effect: non-scaling-stroke; }
    .db-foot { border-top: 1px solid var(--rule); color: var(--muted); font-size: 12px; } .db-foot div { max-width: 1120px; margin: 0 auto; padding: 24px 16px 40px; }
    @media print { body { background: #fff; } .db-top, .db-foot { border: 0; } .db-card, .db-tile { break-inside: avoid; } }
  </style>
</head>
<body>
  <header class="db-top"><div><span class="db-brand">Imóveis Portugal</span><span class="db-flag">{flag}</span></div></header>
  <main class="db"><slot /></main>
  <footer class="db-foot"><div><slot name="foot" /></div></footer>
</body>
</html>
