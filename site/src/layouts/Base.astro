---
import "../styles/global.css";
import LangSwitch from "../components/LangSwitch.astro";
import { config } from "../config";
import { EDITIONS, ED_ORDER, LANGS, HTML_LANG, pathFor, t, type EdCode, type Lang, type PageKey } from "../i18n";

interface Props { ed: EdCode; lang: Lang; page?: PageKey | "home"; title: string; description: string; }
const { ed, lang, page = "home", title, description } = Astro.props;
const T = t(ed, lang);
const host = config.domainMode === "primary" ? config.primaryDomain : EDITIONS[ed].domain;
const canonical = `https://${host}${pathFor(lang, ed, page)}`;
const alternates = LANGS.map((l) => ({ hreflang: HTML_LANG[l], href: `https://${host}${pathFor(l, ed, page)}` }));
const L = { pt: { faq: "Perguntas frequentes", talk: "Falar com um parceiro", guide: "Guia gratuito", lang: "Língua" }, en: { faq: "FAQ", talk: "Talk to a partner", guide: "Free guide", lang: "Language" }, fr: { faq: "Questions fréquentes", talk: "Parler à un partenaire", guide: "Guide gratuit", lang: "Langue" } }[lang];
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!config.launchReady && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Imóveis Portugal" />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href={pathFor(lang, ed, "home")}>Imóveis Portugal</a>
        <nav class="head-nav" aria-label="Menu">
          <a href={pathFor(lang, ed, "partners")} aria-current={page === "partners" ? "page" : undefined}>{T.nav.partners}</a>
          <a href={pathFor(lang, ed, "buy")} aria-current={page === "buy" ? "page" : undefined}>{T.nav.buy}</a>
          <a href={pathFor(lang, ed, "faq")}>{L.faq}</a>
          <a href={pathFor(lang, ed, "guide")}>{L.guide}</a>
          <span class="eds" role="group" aria-label={T.editionsLabel}>
            {ED_ORDER.map((c) => (
              <a href={pathFor(lang, c, page)} aria-current={c === ed ? "true" : undefined} title={EDITIONS[c].name[lang]}>{c.toUpperCase()}</a>
            ))}
          </span>
          <LangSwitch lang={lang} ed={ed} page={page} label={L.lang} cls="eds" />
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap">
        <span>Imóveis Portugal</span>
        <span>{T.footer.sponsored}</span>
        <span>
          <a href={pathFor(lang, ed, "faq")}>{L.faq}</a>{" "}&nbsp;{" "}
          <a href={pathFor(lang, ed, "talk")}>{L.talk}</a>{" "}&nbsp;{" "}
          <a href={pathFor(lang, ed, "privacy")}>{T.footer.privacy}</a>{" "}&nbsp;{" "}
          <a href={pathFor(lang, ed, "legal")}>{T.footer.legal}</a>
        </span>
      </div>
    </footer>
  </body>
</html>
