{
  "name": "imoveis-portugal-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "ebooks": "tsx ebooks/build.ts",
    "share": "node scripts/map-poster.mjs",
    "mediakit": "tsx scripts/mediakit.ts",
    "brochure": "tsx scripts/brochure.ts",
    "dossiers": "tsx dossiers/build.ts",
    "build:test": "astro build --outDir ./artifacts/dist",
    "test:e2e": "playwright test",
    "test:content": "node ../scripts/check-content.mjs && node ../scripts/check-parity.mjs",
    "test:worker": "node ../scripts/test-worker.mjs",
    "test:lighthouse": "node scripts/lighthouse-check.mjs",
    "test:config": "tsc --noEmit --skipLibCheck --moduleResolution bundler --module esnext --target es2022 playwright.config.ts tests/e2e/*.spec.ts",
    "test:marker": "node scripts/test-marker-queue.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "astro": "^5.18.2",
    "js-yaml": "^4.3.2",
    "maplibre-gl": "^4.7.1",
    "marked": "^14.1.4",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "axe-core": "^4.10.2",
    "chrome-launcher": "1.2.2",
    "lighthouse": "12.3.0",
    "tsx": "^4.23.15"
  }
}
